---
interface Props {
  href: string;
  title: string;
  tag?: string;
  tagColor?: 'brand1' | 'brand2' | 'brand3' | 'neutral';
  date?: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
  variant?: 'small' | 'image' | 'featured';
}

const {
  href,
  title,
  tag,
  date,
  lead,
  image,
  imageAlt = '',
  variant = 'small',
} = Astro.props;

const id = `news-card-${crypto.randomUUID().slice(0, 8)}`;

const formattedDate = date
  ? new Date(date).toLocaleDateString('nb-NO', { day: '2-digit', month: '2-digit', year: '2-digit' })
  : undefined;
---

<article class:list={['news-card', `news-card--${variant}`]} data-clickdelegatefor={id}>
  {variant === 'featured' && image && (
    <div class="news-card-image">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    </div>
  )}
  {variant === 'image' && (
    <div class="news-card-image">
      {image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <div class="news-card-image-placeholder" />
      )}
    </div>
  )}
  <div class="news-card-body">
    {tag && <span class="ds-tag" data-variant="outline">{tag.toUpperCase()}</span>}
    <h3 class="ds-heading news-card-title" data-size={variant === 'featured' ? 'lg' : 'sm'}><a id={id} href={href}>{title}</a></h3>
    {variant === 'featured' && lead && <p class="news-card-lead">{lead}</p>}
    {formattedDate && (
      <span class="news-card-meta">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="1" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <line x1="5" y1="4.5" x2="11" y2="4.5" stroke="currentColor" stroke-width="1.2"/>
          <line x1="5" y1="7.5" x2="11" y2="7.5" stroke="currentColor" stroke-width="1.2"/>
          <line x1="5" y1="10.5" x2="8" y2="10.5" stroke="currentColor" stroke-width="1.2"/>
        </svg>
        {formattedDate}
      </span>
    )}
    {variant === 'featured' && (
      <span class="news-card-arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    )}
  </div>
</article>

<style>
  .news-card {
    color: var(--ds-color-text-default);
    border-radius: var(--ds-border-radius-lg);
    cursor: pointer;
    display: flex;
    flex-direction: column;

    & a {
      text-decoration: none;
      color: inherit;

      &.\:click-delegate-hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: none;
        box-shadow: none;
      }
    }

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }

    .news-card-body .ds-tag {
      --dsc-tag-background: var(--ds-color-surface-tinted);
      --dsc-tag-color: var(--ds-color-text-subtle);
    }
  }

  /* ── Small variant (no image) ─────────────────────── */
  .news-card--small {
    padding: var(--ds-size-6);
    gap: var(--ds-size-3);
  }

  .news-card--small .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    flex: 1;
  }

  .news-card--small .news-card-title {
    margin: 0;
  }

  /* ── Image variant ────────────────────────────────── */
  .news-card--image {
    gap: 0;
    background: none;
    height: 100%;
  }

  .news-card--image .news-card-image {
    aspect-ratio: 4 / 3;
    border-radius: var(--ds-border-radius-lg);
    overflow: hidden;
    background-color: var(--image-fallback-bg, #d9d9d9);
  }

  .news-card--image .news-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card--image .news-card-image-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--image-fallback-bg, #d9d9d9);
  }

  .news-card--image .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    padding-top: var(--ds-size-4);
  }

  .news-card--image .news-card-title {
    margin: 0;
  }

  /* ── Featured variant (large, optional image) ──────── */
  .news-card--featured {
    position: relative;
    flex-direction: row;
    gap: var(--ds-size-8);

    @media (max-width: 767px) {
      flex-direction: column;
    }
  }

  .news-card--featured .news-card-image {
    flex: 0 0 45%;
    aspect-ratio: 4 / 3;
    border-radius: var(--ds-border-radius-lg);
    overflow: hidden;
  }

  .news-card--featured .news-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card--featured .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    flex: 1;
    justify-content: center;
    padding-block: var(--ds-size-8);
  }

  .news-card--featured .news-card-title {
    margin: 0;
    text-wrap: balance;
  }

  .news-card--featured .news-card-title a {
    color: var(--ds-color-brand1-text-default);
  }

  .news-card--featured .news-card-lead {
    font-size: var(--ds-font-size-3);
    color: var(--ds-color-text-subtle);
    margin: 0;
    line-height: 1.6;
  }

  .news-card--featured .news-card-arrow {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    color: var(--ds-color-brand1-base-default);
  }

  /* ── Shared elements ──────────────────────────────── */
  .news-card-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-size: var(--ds-font-size-1);
    font-weight: 500;
    color: var(--ds-color-brand1-text-default);
  }

  .news-card-meta svg {
    flex-shrink: 0;
  }
</style>
