<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="9.5.3" />
    <PackageReference Include="Kjac.HeadlessPreview" Version="3.0.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!-- Transitive via Umbraco. Pinned above vulnerable 2.4.1 (GHSA-v5pm-xwqc-g5wc);
         remove when Umbraco itself pulls >= 2.7.5. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <!-- OTLP export to otel-collector. Traces are wired up in Program.cs, logs
         via the Serilog sink (appsettings.Production.json), not builder.Logging. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Transitive via Umbraco -> Microsoft.Data.Sqlite. 2.1.11 bundles a vulnerable
         SQLite binary (GHSA-2m69-gcr7-jv3q, HIGH). The whole family is pinned together so
         core/provider/lib do not get out of step. Remove when Umbraco pulls 2.1.12
         itself. Only affects local dev, prod runs Azure SQL. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.14" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Umbraco.Cms" Version="17.7.1" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.1" />
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob" Version="17.1.0" />
    <PackageReference Include="uSync" Version="17.4.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <None Update="content-routes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    The schema files uSync imports at startup must be in the image. Content and
    media are deliberately NOT copied, they are transported with scripts/sync-prod-til-tt02.sh.
    See uSync/README.md.
  -->
  <ItemGroup>
    <None Include="uSync/v17/ContentTypes/**/*.config;uSync/v17/DataTypes/**/*.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- The Web SDK includes **/*.config. The test fixtures are loaded into tt02 from the repo
         (scripts/last-testfixturer-tt02.sh) and must not be in the image. -->
    <Content Remove="uSync-testinnhold/**" />
  </ItemGroup>

  <!--
    Regenerates the git-ignored mirror of /shared/content-routes.json from
    the source before build/publish, so that `dotnet run`/`dotnet build` is always in
    sync without a separate pre-step. The Condition turns the target off when /shared is not
    reachable (the Docker build context is apps/cms-umbraco/ alone, where
    the GitHub action has already staged the mirror in), and when you deliberately want
    local drift: `dotnet run -p:SkipContentRoutesSync=true`.
  -->
  <Target Name="SyncContentRoutes" BeforeTargets="BeforeBuild;BeforePublish"
          Condition="Exists('$(MSBuildProjectDirectory)/../../shared/content-routes.json')
                     AND '$(SkipContentRoutesSync)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/sync-content-routes.js&quot;" />
  </Target>

</Project>
