---
import AkselIcon from './AkselIcon.astro';

interface Props {
  href?: string;
  title: string;
  description?: string;
  tags?: string[];
  day: string;
  month: string;
  year: string;
  time?: string;
  timeNote?: string;
  location?: string;
}

const {
  href,
  title,
  description,
  tags,
  day,
  month,
  year,
  time,
  timeNote,
  location,
} = Astro.props;

const id = href ? `event-card-${crypto.randomUUID().slice(0, 8)}` : undefined;
const isLink = !!href;
---

<div class:list={["event-card", { "event-card--clickable": isLink }]} data-clickdelegatefor={id}>
  <p class="event-card-date">
    <span class="event-card-day">{day}. {month}</span>
    <span class="event-card-year">{year}</span>
  </p>
  <div class="event-card-body">
    <div class="event-card-info">
      {tags && tags.length > 0 && (
        <ul class="event-card-tags">
          {tags.map(tag => <li class="ds-tag" data-size="sm">{tag}</li>)}
        </ul>
      )}
      {title && (
        <h3 class="ds-heading event-card-title" data-size="sm">
          {isLink ? <a id={id} href={href}>{title}</a> : title}
        </h3>
      )}
      {description && <p class="event-card-desc">{description}</p>}
    </div>
    {(time || location) && (
      <ul class="event-card-details">
        {time && (
          <li>
            <AkselIcon name="Clock" size={20} />
            <span>{time}{timeNote && <><br/>{timeNote}</>}</span>
          </li>
        )}
        {location && (
          <li>
            <AkselIcon name="LocationPin" size={20} />
            <span>{location}</span>
          </li>
        )}
      </ul>
    )}
  </div>
</div>

<style>
  .event-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0;
    background-color: #FFF; /* TODO: this does not have a proper DS color */
    color: var(--ds-color-text-default);
    overflow: hidden;
  }

  .event-card--clickable {
    cursor: pointer;

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }
  }


  .event-card-title {
    font-family: var(--ds-font-family);
    margin: 0;

    & a {
      text-decoration: none;
      color: inherit;
      word-break: break-word;

      &.\:click-delegate-hover {
        text-decoration: underline;
      }
      &:focus-visible {
        outline: none;
      }
    }
  }

  .event-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .event-card-tag {
    display: inline-block;
    font-size: var(--ds-body-xs-font-size);
    font-weight: 600;
    border: 1px solid var(--ds-color-accent-border-default);
    color: var(--ds-color-accent-text-default);
    border-radius: 9999px;
    padding: 2px var(--ds-size-3);
  }


  .event-card-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--ds-color-surface-active);
    padding-block: var(--ds-size-10);
    padding-inline: var(--ds-size-8);
    gap: var(--ds-size-3);
    margin: 0;
  }

  .event-card-day {
    font-family: var(--ki-heading-font);
    font-size: var(--ds-heading-md-font-size);
    text-align: center;
    line-height: 1;
  }
  .event-card-year {
    font-size: var(--ds-body-sm-font-size);
  }

  .event-card-body {
    display: grid;
    grid-template-columns: 1fr 350px;
    padding: var(--ds-size-6);
    align-items: center;
  }

  .event-card-info {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    padding-inline-end: var(--ds-size-6);
  }

  .event-card-desc {
    margin: 0;
  }

  .event-card-details {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    padding-inline-start: var(--ds-size-6);
    list-style: none;
  }

  .event-card-details p {
    display: flex;
    align-items: start;
    gap: var(--ds-size-2);
    margin: 0;
  }

  .event-card-details svg {
    flex-shrink: 0;
    margin: auto;
  }

  @media (max-width: 767px) {
    .event-card {
      grid-template-columns: 1fr;
    }

    .event-card-date {
      flex-direction: row;
      gap: var(--ds-size-2);
      padding: var(--ds-size-4) var(--ds-size-6);
      min-width: unset;

    }

    .event-card-day, .event-card-year {
      font-size: var(--ds-heading-sm-font-size);
    }

    .event-card-body {
      grid-template-columns: 1fr;
    }

    .event-card-info {
      padding-inline-end: 0;
      padding-block-end: var(--ds-size-4);

      &:not(:has(*)) {
        display: none;
      }
    }

    .event-card-details {
      border-left: none;
      padding-inline-start: 0;
      border-top: 1px solid var(--ds-color-border-subtle);
      padding-block-start: var(--ds-size-4);
    }
  }

</style>
