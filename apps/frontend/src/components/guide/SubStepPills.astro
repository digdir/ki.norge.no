---
interface SubStep {
  title: string;
  slug: string;
  active: boolean;
}
interface Props {
  substeps: SubStep[];
  guideSlug: string;
}
const { substeps, guideSlug } = Astro.props;
---
<nav aria-label="Del-steg i dette steget">
  <ol class="substep-pills">
    {substeps.map((sub) => (
      <li class="substep-pill-item">
        <a
          href={`/veiledning/${guideSlug}/${sub.slug}`}
          class="substep-pill ds-button ds-focus--inset"
          data-variant={sub.active ? 'primary' : 'secondary'}
          aria-current={sub.active ? 'page' : undefined}
        >{sub.title}</a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .substep-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ds-size-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .substep-pill-item {
    display: contents;
  }

  .substep-pill {
    border-radius: var(--ds-border-radius-full) !important;
    text-decoration: none;
  }
</style>
