---
import Header from './Header.tsx';
import Footer from './Footer.astro';
import PreviewBanner from '../shared/PreviewBanner.astro';
import BackToTop from '../shared/BackToTop.astro';
import CookieNotice from '../shared/CookieNotice.astro';
import '../../styles/global.css';
import '../../styles/grid.css';
import '../../styles/search-dialog.css';
import './header.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedAt?: string;
  headerTheme?: 'light' | 'dark';
}

const {
  title,
  description = 'Norges nasjonale strategi for kunstig intelligens',
  ogType = 'website',
  ogImage,
  publishedAt,
  headerTheme = 'light',
} = Astro.props;

const isPreview = Astro.url.searchParams.has('preview') || Astro.cookies.has('preview');
const currentPath = Astro.url.pathname;
// Use Astro.site (configured in astro.config.mjs) — never trust Astro.url
// origin since it returns localhost when behind Azure's reverse proxy.
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://ki.norge.no';
const canonicalUrl = `${siteUrl}${currentPath}`;
const fullTitle = `${title} | KI Norge`;
const DEFAULT_OG_IMAGE = '/og-image.png';
const ogImageUrl = `${siteUrl}${ogImage || DEFAULT_OG_IMAGE}`;
---

<!doctype html>
<html lang="nb" data-ds-color-mode="light" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2a6d" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    {isPreview && <meta name="robots" content="noindex" />}
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KI Norge" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://altinncdn.no/fonts/inter/v4.1/inter.css"
      integrity="sha384-OcHzc/By/OPw9uJREawUCjP2inbOGKtKb4A/I2iXxmknUfog2H8Adx71tWVZRscD"
      crossorigin="anonymous"
    />

    <!-- Light mode only (dark mode not supported) -->
    <meta name="color-scheme" content="light" />
  </head>
  <body data-header-theme={headerTheme} data-color-scheme="light">
    <a href="#main-content" class="ds-skip-link">Hopp til hovedinnhold</a>
    <Header client:load currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <CookieNotice />
    <!-- <SearchDialog client:load /> -->
    {isPreview && <PreviewBanner currentPath={currentPath} />}
    <script is:inline>
      document.querySelectorAll('a[href^="http"]').forEach(function(a) {
        if (!a.rel || !a.rel.includes('noopener')) {
          a.rel = a.rel ? a.rel + ' noopener' : 'noopener';
        }
      });
    </script>
  </body>
</html>

<style>
  main {
    flex: 1;
    margin-top: calc(var(--header-height, 72px) * -1);
  }

  main > :global(:first-child) {
    padding-top: calc(var(--header-height, 72px) + var(--ds-size-8));
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
