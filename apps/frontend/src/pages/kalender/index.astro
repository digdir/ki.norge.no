---
import Layout from '../../components/layout/Layout.astro';
import EventCard from '../../components/shared/EventCard.astro';
import { getKalender, getKalenderhendelser, type Kalenderhendelse } from '../../lib/umbraco';

let kalender = null;
let hendelser: Kalenderhendelse[] = [];
try {
  const [k, h] = await Promise.all([getKalender(), getKalenderhendelser()]);
  kalender = k;
  hendelser = h.data;
} catch (e) {
  console.error('Failed to fetch kalender:', e);
}

const tittel = kalender?.tittel || 'Kalender';
const ingress = kalender?.ingress || 'Her finner du arrangementer om KI fra private og offentlige aktører.';
const seoTitle = kalender?.seoTittel || tittel;
const seoDesc = kalender?.seoBeskrivelse || ingress;

const now = new Date();
const sortByStart = (a: Kalenderhendelse, b: Kalenderhendelse) =>
  new Date(a.startDato).getTime() - new Date(b.startDato).getTime();

// Bruk sluttDato hvis satt så flerdagers-arrangement holder seg som "kommende"
// helt til siste dag er passert. Sortering bruker fortsatt startDato.
const effectiveEnd = (h: Kalenderhendelse) => new Date(h.sluttDato || h.startDato);

// Bruk CMS-felt hvis satt, ellers bruk første kommende hendelse som featured
const allKommende = hendelser
  .filter(h => effectiveEnd(h) >= now)
  .sort(sortByStart);
const featured = kalender?.featuredHendelse || allKommende[0] || null;
const featuredId = featured?.id;

const kommende = allKommende
  .filter(h => h.id !== featuredId);
const tidligere = hendelser
  .filter(h => h.id !== featuredId)
  .filter(h => effectiveEnd(h) < now)
  .sort((a, b) => sortByStart(b, a));

const monthNames = ['januar', 'februar', 'mars', 'april', 'mai', 'juni', 'juli', 'august', 'september', 'oktober', 'november', 'desember'];
const formatDate = (iso: string) => {
  if (!iso) return { day: '', month: '', year: '' };
  const d = new Date(iso);
  return { day: String(d.getDate()), month: monthNames[d.getMonth()], year: String(d.getFullYear()) };
};
const formatDateRange = (startIso: string, endIso?: string) => {
  const start = new Date(startIso);
  const end = endIso ? new Date(endIso) : null;
  const startDay = start.getDate();
  const startMonth = monthNames[start.getMonth()];
  const startYear = start.getFullYear();
  if (!end || end.getTime() === start.getTime()) {
    return { dateLabel: `${startDay}.`, month: startMonth, year: String(startYear) };
  }
  const endDay = end.getDate();
  return { dateLabel: `${startDay}. — ${endDay}.`, month: startMonth, year: String(startYear) };
};
const isMultiDay = (startIso: string, endIso?: string) => {
  if (!endIso) return false;
  const s = new Date(startIso);
  const e = new Date(endIso);
  return e.getTime() > s.getTime() && e.toDateString() !== s.toDateString();
};
const parseTagger = (s?: string) =>
  (s || '').split(',').map(t => t.trim()).filter(Boolean);
---
<Layout title={seoTitle} description={seoDesc}>
  <header class="kalender-header" data-layout-block="content">
    <h1 class="ds-heading" data-size="xl">{tittel}</h1>
    {ingress && <p class="kalender-ingress">{ingress}</p>}
  </header>

  {featured && (() => {
    const featuredDate = formatDate(featured.startDato);
    const multiDay = isMultiDay(featured.startDato, featured.sluttDato);
    const featuredRange = formatDateRange(featured.startDato, featured.sluttDato);
    return (
      <section class="kalender-featured" data-layout-block="edge">
        <div class="kalender-featured-inner" data-layout-block="content">
          <h2 class="ds-heading" data-size="lg">{featured.tittel}</h2>
          {featured.ingress && <p class="kalender-featured-ingress">{featured.ingress}</p>}
          <EventCard
            title={featured.type || ''}
            tags={parseTagger(featured.tagger)}
            day={featuredRange.dateLabel.charAt(featuredRange.dateLabel.length - 1) === '.' && !multiDay ? featuredRange.dateLabel.slice(0, -1) : featuredRange.dateLabel}
            month={featuredRange.month}
            year={featuredRange.year}
            time={featured.tid || ''}
            timeNote={multiDay ? 'Arrangement over flere dager' : undefined}
            location={featured.sted || ''}
          />
        </div>
      </section>
    );
  })()}

  <section class="kalender-arrangementer" data-layout-block="content">
    <h2 class="ds-heading" data-size="md">Arrangementer</h2>

    <ds-tabs class="ds-tabs kalender-tabs">
      <ds-tablist>
        <ds-tab aria-controls="panel-kommende" data-value="kommende">Kommende arrangement</ds-tab>
        <ds-tab aria-controls="panel-tidligere" data-value="tidligere">Tidligere arrangement</ds-tab>
      </ds-tablist>

      <ds-tabpanel id="panel-kommende">
        {kommende.length === 0 ? (
          <p class="kalender-empty">Ingen kommende arrangement.</p>
        ) : (
          <div class="kalender-list">
            {kommende.map(h => {
              const date = formatDate(h.startDato);
              const multiDay = isMultiDay(h.startDato, h.sluttDato);
              return (
                <EventCard
                  title={h.tittel}
                  description={h.ingress || ''}
                  tags={parseTagger(h.tagger)}
                  day={date.day}
                  month={date.month}
                  year={date.year}
                  time={h.tid || ''}
                  timeNote={multiDay ? 'Arrangement over flere dager' : undefined}
                  location={h.sted || ''}
                />
              );
            })}
          </div>
        )}
      </ds-tabpanel>

      <ds-tabpanel id="panel-tidligere">
        {tidligere.length === 0 ? (
          <p class="kalender-empty">Ingen tidligere arrangement.</p>
        ) : (
          <div class="kalender-list">
            {tidligere.map(h => {
              const date = formatDate(h.startDato);
              return (
                <EventCard
                  title={h.tittel}
                  description={h.ingress || ''}
                  tags={parseTagger(h.tagger)}
                  day={date.day}
                  month={date.month}
                  year={date.year}
                  time={h.tid || ''}
                  location={h.sted || ''}
                />
              );
            })}
          </div>
        )}
      </ds-tabpanel>
    </ds-tabs>
  </section>
</Layout>

<style>
  .kalender-header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
    padding-block: var(--ds-size-8);
  }

  .kalender-ingress {
    margin: 0;
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-lg-line-height);
  }

  /* ── Featured event ─────────────────────────────── */
  .kalender-featured {
    background: var(--ds-color-base-active);
    color: var(--ds-color-base-contrast-default);
    padding-block: var(--ds-size-10);

    & :global(.event-card) {
      grid-template-columns: 180px 1fr;
    }
  }

  .kalender-featured-inner {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  .kalender-featured-ingress {
    margin: 0;
  }

  /* ── Arrangementer section ──────────────────────── */
  .kalender-arrangementer {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
    padding-block: var(--ds-size-10);
  }

  .kalender-tabs {
    --dsc-tabs-content-padding: var(--ds-size-6) 0;
  }

  .kalender-empty {
    margin: 0;
    color: var(--ds-color-text-default);
  }

  /* ── Event list ─────────────────────────────────── */
  .kalender-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }
</style>
