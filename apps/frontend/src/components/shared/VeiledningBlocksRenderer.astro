---
import type { UmbracoBlock } from '../../lib/umbraco';
import AkselIcon from './AkselIcon.astro';

interface Props {
  blocks?: UmbracoBlock[];
}

const { blocks } = Astro.props;

// Nabo-trekkspill grupperes til én aksordion-gruppe (samme mønster som ArticleBlocksRenderer).
type RenderItem =
  | { kind: 'block'; block: UmbracoBlock }
  | { kind: 'trekkspillGruppe'; blocks: UmbracoBlock[] };

type TrekkspillItem = { tittel: string; innhold: string };

function groupBlocks(input: UmbracoBlock[]): RenderItem[] {
  const out: RenderItem[] = [];
  for (const block of input) {
    if (block.contentType !== 'veiledningTrekkspill') {
      out.push({ kind: 'block', block });
      continue;
    }
    const last = out[out.length - 1];
    if (!last || last.kind !== 'trekkspillGruppe') {
      out.push({ kind: 'trekkspillGruppe', blocks: [block] });
    } else {
      last.blocks.push(block);
    }
  }
  return out;
}

const renderItems = groupBlocks(blocks || []);

const moduleIcons: Record<string, string> = {
  veiledningInfo: 'InformationSquare',
  veiledningEksempel: 'LightBulb',
  veiledningObs: 'ExclamationmarkTriangle',
};
---

{renderItems.map((item) => {
  if (item.kind === 'trekkspillGruppe') {
    return (
      <div class="ds-card" data-variant="tinted">
        {item.blocks.map((block) => (
          <details class="ds-details">
            <summary>{block.content.tittel}</summary>
            <div class="trekkspill-innhold" set:html={block.content.innhold} />
          </details>
        ))}
      </div>
    );
  }

  const block = item.block;

  if (block.contentType === 'veiledningTekst') {
    return <Fragment set:html={block.content.innhold} />;
  }

  if (block.contentType === 'veiledningInfo'
    || block.contentType === 'veiledningEksempel'
    || block.contentType === 'veiledningObs') {
    const c = block.content;
    const tekst = block.contentType === 'veiledningObs' ? c.tekst : c.innhold;
    // Obs-modulen har valgfri tittel: tom tittel vises som "Obs" (Dorte).
    const tittel = block.contentType === 'veiledningObs' ? (c.tittel || 'Obs') : c.tittel;
    const ikon = moduleIcons[block.contentType];
    const trekkspill = block.contentType === 'veiledningInfo' ? c.trekkspill as TrekkspillItem[] | undefined : undefined;
    const lesMerTittel = block.contentType === 'veiledningInfo' ? c.lesMerTittel as string | undefined : undefined;
    const lesMerUrl = block.contentType === 'veiledningInfo' ? c.lesMerUrl as string | undefined : undefined;
    const variantType = block.contentType.replace('veiledning', '').toLowerCase();
    return (
      <div class="ds-card veiledning-modul" data-variant="tinted" data-type={variantType}>
        <div class="veiledning-modul-head">
          <AkselIcon name={ikon} size={24} class="veiledning-modul-ikon" />
          {tittel && <h3 class="ds-heading veiledning-modul-tittel" data-size="xs">{tittel}</h3>}
        </div>
        <div class="veiledning-modul-body" set:html={tekst} />
        {trekkspill && trekkspill.length > 0 && (
          <div class="ds-card" data-variant="tinted">
            {trekkspill.map((t) => (
              <details class="ds-details">
                <summary>{t.tittel}</summary>
                <div class="trekkspill-innhold" set:html={t.innhold} />
              </details>
            ))}
          </div>
        )}
        {lesMerTittel && lesMerUrl && (
          <a class="ds-link" href={lesMerUrl}>
            <AkselIcon name="QuestionmarkCircle" size={20} />
            <span>{lesMerTittel}</span>
          </a>
        )}
      </div>
    );
  }

  return null;
})}

<style>
  .veiledning-tekst :global(*:last-child) {
    margin-bottom: 0;
  }
  .veiledning-tekst :global(ul),
  .veiledning-tekst :global(ol) {
    margin: var(--ds-size-2) 0 var(--ds-size-3);
    padding-inline-start: var(--ds-size-6);
  }
  .veiledning-tekst :global(li) {
    margin-bottom: var(--ds-size-1);
  }

  /* Rik tekst i trekkspill-kroppen. Uten dette har avsnitt (Enter i RTE) ingen
     margin (ds-paragraph er margin-løs) og linjeskift forsvinner. (#393) */
  .trekkspill-innhold {
    font-size: var(--ds-body-md-font-size);
    line-height: var(--ds-body-md-line-height);
  }
  .trekkspill-innhold :global(p) {
    margin: 0 0 var(--ds-size-3);
  }
  .trekkspill-innhold :global(p:last-child) {
    margin-bottom: 0;
  }
  .trekkspill-innhold :global(ul),
  .trekkspill-innhold :global(ol) {
    margin: var(--ds-size-2) 0 var(--ds-size-3);
    padding-inline-start: var(--ds-size-6);
  }
  .trekkspill-innhold :global(li) {
    margin-bottom: var(--ds-size-1);
  }

  .veiledning-modul {
    padding-inline: var(--ds-size-5);
    padding-block: var(--ds-size-6);
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
    border: none;
  }

  .veiledning-modul[data-type="eksempel"] {
    background-color: #EEFAEF;
  }


  .veiledning-modul[data-type="obs"] {
    background-color: #FFFDE1;
  }

  .veiledning-modul-head {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
  }
  .veiledning-modul-ikon {
    flex-shrink: 0;
  }
  .veiledning-modul-tittel {
    margin: 0;
  }
  .veiledning-modul-body {
    font-size: var(--ds-body-md-font-size);
    line-height: var(--ds-body-md-line-height);
  }
  .veiledning-modul-body :global(p) {
    margin: 0 0 var(--ds-size-3);
  }
  .veiledning-modul-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .veiledning-modul-lesmer {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-1);
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
  }
  .veiledning-modul-lesmer:hover {
    text-decoration: none;
  }
</style>
