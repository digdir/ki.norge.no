{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "Production",
        "LocalTempStorageLocation": "EnvironmentTemp"
      },
      "Hosting": {
        "Debug": false
      },
      "Global": {
        "UseHttps": false,
        "MainDomLock": "FileSystemMainDomLock"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://cms.ki.norge.no"
      },
      "Security": {
        "BackOfficeHost": "https://cms.ki.norge.no"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      },
      "DeliveryApi": {
        "ApiKey": ""
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "KeyVault": {
    "Enabled": true
  },
  "HeadlessPreview": {
    "FrontendUrl": "",
    "PreviewSecret": ""
  },
  "MicrosoftEntraId": {
    "ClientId": "",
    "ClientSecret": "",
    "Authority": "https://login.microsoftonline.com/<KI_TENANT_ID>/v2.0",
    "CallbackPath": "/signin-entra"
  }
}
