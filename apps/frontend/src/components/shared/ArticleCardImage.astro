---
interface Props {
  href: string;
  title: string;
  date?: string;
  image?: string;
  imageAlt?: string;
}

const { href, title, date, image, imageAlt = '' } = Astro.props;
const id = `image-card-${crypto.randomUUID().slice(0, 8)}`;

const formattedDate = date
  ? new Date(date).toLocaleDateString('nb-NO', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : undefined;
---

<article class="image-card" data-clickdelegatefor={id}>
  <div class="image-card-media">
    {image ? <img src={image} alt={imageAlt} loading="lazy" /> : <div class="image-card-placeholder"></div>}
  </div>
  <div class="image-card-body">
    <h3 class="image-card-title"><a id={id} href={href}>{title}</a></h3>
    {formattedDate && (
      <span class="image-card-date">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M2 6h12" stroke="currentColor" stroke-width="1.2"/>
          <path d="M5 1.5v3M11 1.5v3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        {formattedDate}
      </span>
    )}
  </div>
</article>

<style>
  .image-card {
    cursor: pointer;
    transition: box-shadow 0.2s ease;
    border-radius: var(--ds-border-radius-lg);

    & a {
      text-decoration: none;
      color: inherit;

      &:focus-visible {
        outline: none;
      }
    }

    &:focus-within {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }

    &:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }
  }

  .image-card-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--ds-border-radius-lg);
    overflow: hidden;
    margin-bottom: var(--ds-size-3);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .image-card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--image-fallback-bg);
  }

  .image-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .image-card-title {
    font-size: var(--ds-body-lg-font-size);
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  .image-card-date {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-size: var(--ds-body-sm-font-size);
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
