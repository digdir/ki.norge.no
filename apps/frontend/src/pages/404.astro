---
import Layout from '../components/layout/Layout.astro';
import { getGlobaleInnstillinger } from '../lib/umbraco';

const gi = await getGlobaleInnstillinger().catch(() => null);
const tittel = gi?.tittel404 || 'Finner ikke siden';
const beskrivelse = gi?.beskrivelse404 || 'Siden du leter etter finnes ikke eller har blitt fjernet.';
---

<Layout title={tittel} description="Beklager, denne siden finnes ikke.">
  <div class="error-page" data-layout-block="content">
    <span class="error-code">404</span>
    <h1 class="error-heading">{tittel}</h1>
    <p class="error-description ds-paragraph">{beskrivelse}</p>
    <a href="/" class="error-link ds-link">Gå til forsiden</a>
  </div>
</Layout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    padding: var(--ds-size-12) var(--ds-size-4);
    gap: var(--ds-size-4);
  }

  .error-code {
    font-family: var(--ki-heading-font);
    font-size: var(--ds-heading-sm-font-size);
    font-weight: 700;
  }

  .error-heading {
    font-family: var(--ki-heading-font);
    font-size: var(--ds-heading-2xl-font-size);
    font-weight: 400;
    margin: 0;
  }

  .error-description {
    margin: 0;
    max-width: 500px;
  }

  .error-link {
    margin-block-start: var(--ds-size-2);
  }
</style>
