---
import ExampleCard from './ExampleCard.astro';

interface CardItem {
  href: string;
  title: string;
  tag?: string;
  tags?: string[];
  virksomhet?: string;
  // Optional editorial override; defaults to the dark/medium/light alternation.
  variant?: 'dark' | 'medium' | 'light';
}

interface Props {
  cards: CardItem[];
}

const { cards } = Astro.props;

const count = cards.length;

// Default colour pattern per group size (Figma, #461): varies all three
// colours and avoids the same colour on neighbours, also vertically in a 2-column grid.
// Note: in the theme "medium" (base-hover) is darker than "dark" (base-default);
// the design has the lightest red top left and the darkest bottom right.
// A CMS field for per-card colour does not exist yet; card.variant overrides when it comes.
type Variant = 'dark' | 'medium' | 'light';
const DEFAULT_PATTERNS: Record<number, Variant[]> = {
  2: ['dark', 'light'],
  3: ['medium', 'light', 'dark'],
  4: ['dark', 'light', 'light', 'medium'],
};
const CYCLE: Variant[] = ['dark', 'light', 'medium'];
const defaultVariant = (i: number): Variant => DEFAULT_PATTERNS[count]?.[i] ?? CYCLE[i % 3];

// On mobile the cards are in one column, and then the two light ones in the 2x2 pattern
// become neighbours and blend together (#796). Alternating red and pink separates best.
const MOBILE_PATTERNS: Record<number, Variant[]> = {
  4: ['dark', 'light', 'medium', 'light'],
};
---

<div class="example-link-cards" data-count={count}>
  {cards.map((card, i) => (
    <ExampleCard
      href={card.href}
      title={card.title}
      tag={card.tag}
      tags={card.tags}
      virksomhet={card.virksomhet}
      variant={card.variant ?? defaultVariant(i)}
      mobileVariant={card.variant ? undefined : MOBILE_PATTERNS[count]?.[i]}
    />
  ))}
</div>

<style>
  .example-link-cards {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .example-link-cards[data-count='2'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .example-link-cards[data-count='3'] {
      grid-template-columns: repeat(3, 1fr);
    }

    .example-link-cards[data-count='4'] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
