---
import Layout from '../components/layout/Layout.astro';
import BlocksRenderer from '../components/shared/BlocksRenderer.astro';
import ContactCard from '../components/shared/ContactCard.astro';
import { getFAQs, getFaqSamling, getPlainText, type FAQ } from '../lib/umbraco';
import { faqPageSchema } from '../lib/seo';

let faqs: FAQ[] = [];
try {
  const faqRes = await getFAQs();
  faqs = faqRes.data;
} catch (e) {
  console.error('Failed to fetch FAQs:', e);
}

const faqSamling = await getFaqSamling().catch(() => null);
const leadHtml = faqSamling?.lead || '<p>Her finner du svar på de mest stilte spørsmålene om KI Norge og våre tjenester.</p>';

// Hardcoded fallback FAQs — shown when the CMS has none. Used by editors
// who haven't populated the FAQ collection yet, and as a safety net if the
// Delivery API is unreachable.
const fallbackFaqs: Array<{ question: string; answer: string }> = [
  {
    question: 'Hva er KI Norge?',
    answer: 'KI Norge er Digitaliseringsdirektoratets tjeneste for å hjelpe offentlig sektor med å ta i bruk kunstig intelligens på en trygg og ansvarlig måte. Her finner du veiledning, eksempler og praktiske verktøy for statlige og kommunale virksomheter.',
  },
  {
    question: 'Hva er KI-sandkassen?',
    answer: 'KI-sandkassen er en regulatorisk sandkasse der offentlige og private virksomheter kan teste ut KI-løsninger sammen med Datatilsynet og andre relevante myndigheter. Formålet er å få juridisk veiledning om personvern og andre regelverk i en kontrollert setting før løsningen settes i produksjon.',
  },
  {
    question: 'Hvem kan søke om å delta i KI-sandkassen?',
    answer: 'Både offentlige og private virksomheter kan søke. Prosjektet må handle om utvikling eller bruk av kunstig intelligens som reiser personvernrettslige spørsmål. Prosjekter som tjener samfunnsnyttige formål blir prioritert.',
  },
  {
    question: 'Er det trygt å bruke KI i offentlig sektor?',
    answer: 'KI kan brukes trygt i offentlig sektor, men det krever at virksomheten forstår teknologien, vurderer risiko, og overholder regelverk som personvernforordningen (GDPR), forvaltningsloven og KI-forordningen. Veiledningen vår hjelper deg med å gjøre de nødvendige vurderingene.',
  },
  {
    question: 'Hvordan kommer jeg i gang med KI?',
    answer: 'Start med å lese veiledningen under Veiledning. Den tar deg gjennom hva du må tenke på før du setter i gang, hvordan du utvikler og tester KI-systemer, og hvilke regelverk som gjelder. Du finner også gode eksempler fra andre virksomheter under Eksempler.',
  },
  {
    question: 'Hvor finner jeg eksempler på hvordan andre bruker KI?',
    answer: 'På siden Eksempler har vi samlet erfaringer fra virksomheter som allerede har tatt i bruk kunstig intelligens. Du kan lese om hva de har gjort, hvilke utfordringer de møtte, og hva de lærte underveis.',
  },
  {
    question: 'Hvem står bak KI Norge?',
    answer: 'KI Norge drives av Digitaliseringsdirektoratet i samarbeid med Datatilsynet og andre relevante aktører i offentlig sektor. Målet er å hjelpe offentlige virksomheter med ansvarlig bruk av kunstig intelligens.',
  },
];

const usingFallback = faqs.length === 0;

const faqJsonLd = faqPageSchema(
  usingFallback
    ? fallbackFaqs.map(f => ({ question: f.question, answer: f.answer }))
    : faqs.map(faq => ({ question: faq.sporsmal, answer: getPlainText(faq.svar) })),
);
---

<Layout title="Ofte stilte spørsmål (FAQ)" description="Svar på ofte stilte spørsmål om KI Norge, den regulatoriske sandkassen og kunstig intelligens i offentlig sektor.">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />

  <div class="faq-page">
    <div class="faq-title-bar">
      <h1 class="faq-title">Ofte stilte spørsmål</h1>
      <div class="faq-lead" set:html={leadHtml}></div>
    </div>

    <div class="faq-content">
      <div class="ds-card" data-variant="tinted">
        {usingFallback
          ? fallbackFaqs.map(faq => (
              <details class="ds-details">
                <summary>{faq.question}</summary>

                  <p>{faq.answer}</p>

              </details>
            ))
          : faqs.map(faq => (
              <details class="ds-details">
                <summary>{faq.sporsmal}</summary>
                <BlocksRenderer blocks={faq.svar} />
              </details>
            ))
        }
      </div>
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .faq-page {
    padding-top: var(--ds-size-4);
  }

  .faq-title-bar {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px var(--ds-size-4) 24px;
    border-bottom: 1px solid #b8bcc1;
  }

  .faq-title {
    font-size: 1.625rem;
    font-weight: 500;
    margin: 0 0 8px;
    color: #000;
  }

  .faq-lead {
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
  }

  .faq-content {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--ds-size-8) var(--ds-size-4);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }
</style>
