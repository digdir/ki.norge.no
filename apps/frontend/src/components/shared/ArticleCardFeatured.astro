---
import AkselIcon from './AkselIcon.astro';

interface Props {
  href: string;
  title: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
}

const { href, title, lead, image, imageAlt = '' } = Astro.props;
const id = `featured-card-${crypto.randomUUID().slice(0, 8)}`;
---

<article class="featured-card" data-clickdelegatefor={id}>
  <div class="featured-card-image">
    {image ? <img src={image} alt={imageAlt} loading="lazy" /> : <div class="featured-card-placeholder"></div>}
  </div>
  <div class="featured-card-body">
    <h3 class="featured-card-title"><a id={id} href={href}>{title}</a><span class="featured-card-arrow "><AkselIcon name="ArrowRight" size={20} aria-hidden="true" /></span>
    </h3>
    {lead && <p class="featured-card-lead">{lead}</p>}
  </div>
</article>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    cursor: pointer;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }

    & a {
      text-decoration: none;
      color: inherit;

      &:focus-visible {
        outline: none;
      }
    }

    &:focus-within {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
      border-radius: var(--ds-border-radius-md);
    }
  }

  .featured-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .featured-card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--image-fallback-bg);
  }

  .featured-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    justify-content: center;
  }

  .featured-card-title {
    font-size: var(--ds-heading-lg-font-size);
    font-weight: 400;
    margin: 0;
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
  }

  .featured-card-lead {
    font-size: var(--ds-body-lg-font-size);
    color: var(--ds-color-text-default);
    margin: 0;
    line-height: 1.6;
  }

.featured-card-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--ds-color-surface-tinted);
}
</style>
