---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="info-card">
  <div class="info-card-header">
    <span class="info-card-icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M4 3.25C3.58579 3.25 3.25 3.58579 3.25 4V20C3.25 20.4142 3.58579 20.75 4 20.75H20C20.4142 20.75 20.75 20.4142 20.75 20V4C20.75 3.58579 20.4142 3.25 20 3.25H4ZM4.75 19.25V4.75H19.25V19.25H4.75ZM11 7.75C11 7.19772 11.4477 6.75 12 6.75C12.5523 6.75 13 7.19772 13 7.75C13 8.30228 12.5523 8.75 12 8.75C11.4477 8.75 11 8.30228 11 7.75ZM10.5 10C10.0858 10 9.75 10.3358 9.75 10.75C9.75 11.1642 10.0858 11.5 10.5 11.5H11.25V15.5H10.5C10.0858 15.5 9.75 15.8358 9.75 16.25C9.75 16.6642 10.0858 17 10.5 17H12H13.5C13.9142 17 14.25 16.6642 14.25 16.25C14.25 15.8358 13.9142 15.5 13.5 15.5H12.75V10.75C12.75 10.3358 12.4142 10 12 10H10.5Z" fill="#202733"/>
      </svg>
    </span>
    <span class="info-card-title">{title}</span>
  </div>
  <div class="info-card-body">
    <slot />
  </div>
</div>
<style>
  .info-card {
    background-color: var(--ds-color-neutral-background-tinted);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    color: var(--ds-color-neutral-text-subtle);
    border-radius: var(--ds-border-radius-lg);
    padding-block: var(--ds-size-8);
    padding-inline: var(--ds-size-6);
    margin-block: var(--ds-size-6);
  }
  .info-card-header {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    margin-bottom: var(--ds-size-4);
  }
  .info-card-icon {
    display: flex;
    place-items: center;
  }
  .info-card-title {
    font-weight: 700;
  }
  .info-card-body :global(p) {
    margin: 0 0 var(--ds-size-3);
  }
  .info-card-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .info-card-body :global(ol), .info-card-body :global(ul) {
    margin: var(--ds-size-2) 0;
    padding-inline-start: var(--ds-size-6);
  }
  .info-card-body :global(li) {
    margin-bottom: var(--ds-size-1);
  }
</style>
