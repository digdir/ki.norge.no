---
/**
 * Grid: wrapper component for a 12-column responsive grid.
 *
 * Usage:
 *   <Grid>
 *     <div class="col-all">Full width</div>
 *     <div class="col-center-6">Body text</div>
 *   </Grid>
 *
 * Props:
 *   tag     : HTML element (default: div)
 *   class   : extra CSS classes
 *   bleed   : whether the content should have a full-bleed background
 *
 * See grid.css for details on column classes and breakpoints.
 */

interface Props {
  tag?: string;
  class?: string;
  bleed?: boolean;
}

const { tag: Tag = 'div', class: className, bleed } = Astro.props;
const classes = ['grid', className].filter(Boolean).join(' ');
---

{bleed ? (
  <div class="grid-bleed">
    <Tag class={classes}>
      <slot />
    </Tag>
  </div>
) : (
  <Tag class={classes}>
    <slot />
  </Tag>
)}
