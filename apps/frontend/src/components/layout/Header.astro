---
import { Link } from '@digdir/designsystemet-react';
import Logo from '../shared/Logo.astro';


const navItems = [
  { href: '/veiledning', label: 'Veiledning' },
  { href: '/caser', label: 'Caser' },
];

const currentPath = Astro.url.pathname;
---

<header class="header" data-color="neutral">
  <div class="header-container">
    <Link href="/" className="logo-link" aria-label="KI Norge - Hjem">
      <Logo />
    </Link>

    <nav class="nav-desktop" aria-label="Hovednavigasjon">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <Link
              href={item.href}
              className={`nav-link ${currentPath.startsWith(item.href) ? 'active' : ''}`}
              aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </Link>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
</script>

<style>
  .header {
    background: transparent;
    position: relative;
    z-index: 1000;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--ds-size-4) var(--ds-size-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-size-6);
  }

  :global(.logo-link) {
    text-decoration: none;
    color: var(--ds-color-neutral-text-default);
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    gap: var(--ds-size-1);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }

  :global(.nav-link) {
    text-decoration: none;
    color: var(--ds-color-neutral-text-default);
    font-size: var(--ds-font-size-4);
    font-weight: var(--ds-font-weight-medium);
    padding-inline: var(--ds-size-5);
    padding-block: var(--ds-size-2);
    transition: all 0.2s ease;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }

  :global(.nav-link:hover) {
    border-bottom: 2px solid var(--ds-color-neutral-border-subtle);
  }

  :global(.nav-link.active) {
    border-bottom: 2px solid var(--ds-color-neutral-border-default);
  }
</style>
