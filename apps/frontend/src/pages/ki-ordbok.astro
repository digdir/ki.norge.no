---
import Layout from '../components/layout/Layout.astro';
import { getOrdbokOppslag, getOrdbokSamling } from '../lib/umbraco';
import { definedTermSetSchema } from '../lib/seo';

const ordbokSamling = await getOrdbokSamling().catch(() => null);
const ordbokTittel = ordbokSamling?.tittel || 'KI Ordboka';
const ordbokLeadHtml = ordbokSamling?.lead || '<p>KI ordboken forklarer vanlige begreper innen kunstig intelligens. Søk etter et ord eller bla deg gjennom listen.</p>';

interface OrdEntry {
  term: string;
  altTerm?: string;
  definisjon: string;
}

// Try to load terms from CMS first
let cmsOrdliste: OrdEntry[] = [];
try {
  const cmsRes = await getOrdbokOppslag();
  if (cmsRes.data.length > 0) {
    cmsOrdliste = cmsRes.data.map((item) => ({
      term: item.term,
      altTerm: item.alternativTerm,
      definisjon: item.definisjon,
    }));
  }
} catch (e) {
  console.error('Failed to fetch ordbok from CMS:', e);
}

// Hardcoded fallback — used when CMS returns no terms
const fallbackOrdliste: OrdEntry[] = [
  { term: 'Kunstig intelligens (KI) eller Artificial Intelligence', altTerm: 'AI', definisjon: 'Kunstig intelligens er datasystemer som kan utføre oppgaver som vanligvis krever menneskelig intelligens, for eksempel å forstå tekst, bilder eller tale og ta enkle beslutninger.' },
  { term: 'A/B-testing', definisjon: 'A/B-testing er å sammenligne to versjoner av en løsning, for eksempel to KI-modeller, for å se hvilken som gir best resultater i praksis.' },
  { term: 'A/B-testing med KI', definisjon: 'A/B-testing med KI betyr at modellen hjelper til med å lage flere varianter og finne ut hvilke budskap, bilder eller vinklinger som fungerer best.' },
  { term: 'Adaptere', altTerm: 'adapter layers', definisjon: 'Adaptere er små tilleggsmoduler som settes inn i en eksisterende modell for å tilpasse den til nye oppgaver uten å endre hele modellen.' },
  { term: 'Agent-samarbeid', altTerm: 'multi-agent systems, MAS', definisjon: 'Agent-samarbeid betyr at flere KI-agenter med ulike roller jobber sammen om en oppgave, litt som et team med spesialister.' },
  { term: 'Agentisk KI', altTerm: 'agentic AI', definisjon: 'Agentisk KI beskriver systemer der KI opptrer mer som en aktiv aktør som planlegger, tar initiativ og følger opp oppgaver på egen hånd innenfor gitte rammer.' },
  { term: 'AI governance', altTerm: 'KI-styring', definisjon: 'KI-styring, kjent som AI governance er strukturer, roller og prosesser som sikrer at KI brukes kontrollert, i tråd med lover, strategi og etiske krav.' },
  { term: 'AI policy / KI-policy', definisjon: 'En KI-policy er et sett med retningslinjer som beskriver hvordan virksomheten skal bruke kunstig intelligens på en trygg og ansvarlig måte.' },
  { term: 'AI-agent / KI-agent', definisjon: 'En KI-agent er en «arbeidende» KI som kan ta imot instrukser, hente informasjon, bruke verktøy og utføre oppgaver en etterspør mer selvstendig over tid.' },
  { term: 'AI-strategi / KI-strategi', definisjon: 'En KI-strategi beskriver hvordan virksomheten skal bruke kunstig intelligens for å støtte prioriteringer, organisering og investeringer.' },
  { term: 'Anbefalingssystem', altTerm: 'recommender system', definisjon: 'Et anbefalingssystem foreslår relevante produkter, tjenester eller innhold basert på tidligere atferd og lignende brukere.' },
  { term: 'Anomaly detection', altTerm: 'avviksdeteksjon', definisjon: 'Avviksdeteksjon brukes til å finne uvanlige mønstre som skiller seg fra normalen, for eksempel mulig svindel eller tekniske feil.' },
  { term: 'API', altTerm: 'Application Programming Interface', definisjon: 'Et API er et grensesnitt som gjør at ulike systemer kan snakke sammen og for eksempel sende forespørsler til en KI-modell og motta svar.' },
  { term: 'Arbeidsflyt / workflow', definisjon: 'En arbeidsflyt er en definert kjede av steg og beslutninger som beskriver hvordan en oppgave gjennomføres fra start til slutt.' },
  { term: 'Automatisering', definisjon: 'Automatisering betyr at oppgaver som tidligere ble gjort manuelt blir utført av systemer eller programvare, ofte ved hjelp av KI.' },
  { term: 'Automatisering av prosesser', definisjon: 'Automatisering av prosesser betyr å bruke teknologi, ofte KI, til å utføre deler av eller hele arbeidsprosesser uten manuelle steg.' },
  { term: 'Autoregressiv modell', definisjon: 'En autoregressiv modell genererer innhold steg for steg ved å forutsi neste ord eller element basert på det som allerede er skrevet.' },
  { term: 'Basismodell / grunnmodell', altTerm: 'foundation model', definisjon: 'En grunnmodell er en stor, generell KI-modell som kan brukes som utgangspunkt og tilpasses ulike oppgaver i en virksomhet.' },
  { term: 'Benchmarking', altTerm: 'standardtester', definisjon: 'Benchmarking er å teste modellen på standardiserte oppgaver og datasett for å kunne sammenligne den med andre modeller.' },
  { term: 'Beslutningsstøttesystem', definisjon: 'Et beslutningsstøttesystem er en løsning som gir analyser, anbefalinger eller visualiseringer som hjelper ledere å ta bedre beslutninger.' },
  { term: 'Bias', altTerm: 'skjevhet', definisjon: 'Bias er systematiske skjevheter i data eller modeller som gjør at enkelte grupper behandles annerledes eller urettferdig.' },
  { term: 'Bildemodell', altTerm: 'vision model, CV, Computer Vision', definisjon: 'En bildemodell er KI som kan forstå og analysere bilder og video, for eksempel gjenkjenne objekter eller lese tekst i bilder.' },
  { term: 'BLEU / ROUGE', altTerm: 'for språkmodeller', definisjon: 'BLEU og ROUGE er metrikker som sammenligner tekst generert av modellen med en «fasittekst» for å måle kvalitet, ofte brukt for oversettelse og oppsummering.' },
  { term: 'CE-merking av KI-systemer', definisjon: 'CE-merking for KI betyr at et høyrisiko KI-system er vurdert og erklært i samsvar med AI Act og andre relevante EU-regler, og kan settes lovlig på markedet i EU.' },
  { term: 'Chatbot / samtalerobot', definisjon: 'En chatbot er en løsning der brukere kan chatte med KI i et tekstvindu for å få hjelp, svar eller utføre enkle oppgaver.' },
  { term: 'Chunking', altTerm: 'deling i tekstbiter', definisjon: 'Chunking er å dele dokumenter opp i mindre tekstbiter slik at KI lettere kan hente frem og bruke de delene som er relevante.' },
  { term: 'CI/CD for KI-modeller', definisjon: 'CI/CD (Continuous Integration/Continuous Delivery or Deployment) for KI-modeller er automatiserte prosesser for å teste, godkjenne og rulle ut nye modellversjoner på en kontrollert måte.' },
  { term: 'Clusteranalyse', altTerm: 'clustering', definisjon: 'Clusteranalyse grupperer data i naturlige klynger, for eksempel å finne ulike kundegrupper basert på atferd.' },
  { term: 'Data lake', definisjon: 'En data lake er et stort lagringsområde der du kan samle rådata i ulike formater på ett sted, før de struktureres og brukes videre.' },
  { term: 'Data mesh', definisjon: 'Data mesh er en måte å organisere datadeling i større virksomheter der ulike team har ansvar for sine «dataprodukter», men deler dem via felles standarder.' },
  { term: 'Data minimization', altTerm: 'dataminimering', definisjon: 'Dataminimering betyr at virksomheten bare skal samle inn og lagre de personopplysningene som er nødvendige for et tydelig definert formål, og ikke mer.' },
  { term: 'Data pipeline / datapipeline', definisjon: 'En datapipeline er den tekniske løsningen som flytter, bearbeider og klargjør data fra kilder til der de skal brukes, for eksempel i KI-modeller.' },
  { term: 'Data, datasett', definisjon: 'Enkelt sagt, er data er informasjon som kan lagres og behandles digitalt, og et datasett er en samling av slik informasjon som hører tematisk sammen.' },
  { term: 'Databehandler vs behandlingsansvarlig', definisjon: 'Behandlingsansvarlig bestemmer hvorfor og hvordan personopplysninger behandles, mens databehandler kun behandler data på oppdrag og etter instruks fra den behandlingsansvarlige.' },
  { term: 'Datagovernance / datastyring', definisjon: 'Datastyring er de prosessene, rollene og reglene som sikrer at data behandles sikkert, korrekt og i tråd med lover, avtaler og virksomhetens egne retningslinjer.' },
  { term: 'Datakvalitet', definisjon: 'Datakvalitet handler om hvor korrekte, fullstendige, oppdaterte og konsistente dataene dine er.' },
  { term: 'Datasporbarhet', altTerm: 'data lineage', definisjon: 'Datasporbarhet beskriver hvor data kommer fra, hvordan de er behandlet og hvor de brukes, slik at man kan spore og forstå hele reisen til dataene og oppdage feil.' },
  { term: 'Datavarehus', altTerm: 'data warehouse', definisjon: 'Et datavarehus er en strukturert database som er tilpasset rapportering, analyse og styringsinformasjon på tvers av virksomheten.' },
  { term: 'Datavask', altTerm: 'data cleaning', definisjon: 'Datavask betyr å rydde opp i dataene ved å fjerne feil, duplikater og mangler, slik at de blir egnet til analyse av KI.' },
  { term: 'Deep reinforcement learning', definisjon: 'Deep reinforcement learning kombinerer dype nevrale nettverk med forsterkningslæring for å takle mer komplekse beslutningsoppgaver.' },
  { term: 'Diffusjonsmodell', altTerm: 'diffusion model', definisjon: 'En diffusjonsmodell er en type generativ KI som gradvis bygger opp et bilde eller annet innhold fra «støy» til et ferdig resultat.' },
  { term: 'Digital assistent / co-pilot', definisjon: 'En digital assistent eller co-pilot er KI som hjelper deg inne i verktøyene du allerede bruker, for eksempel i e-post, dokumenter eller CRM.' },
  { term: 'Digital tvilling', definisjon: 'En digital tvilling er en digital modell av et fysisk system, en prosess eller en organisasjon som brukes til å simulere og teste endringer.' },
  { term: 'Diskriminering i data og modeller', definisjon: 'Diskriminering oppstår når KI forsterker eller skaper ulik behandling av personer basert på for eksempel kjønn, alder, etnisitet eller andre beskyttede kjennetegn.' },
  { term: 'Dokumentlager / dokumentbase', definisjon: 'Et dokumentlager er et sted der virksomheten lagrer dokumenter som rapporter, rutiner og håndbøker som kan kobles til KI.' },
  { term: 'DoRA', altTerm: 'Weight-Decomposed Low-Rank Adaptation', definisjon: 'DoRA er en videreutvikling av LoRA som finjusterer modellens vekter enda mer effektivt for å få bedre resultater med lite ekstra trening.' },
  { term: 'DPIA', altTerm: 'Data Protection Impact Assessment', definisjon: 'En DPIA er en personvernkonsekvensvurdering som kartlegger risiko for enkeltpersoner når en behandling av personopplysninger kan være særlig inngripende, for eksempel ved bruk av ny teknologi.' },
  { term: 'Dynamiske landingssider', definisjon: 'Dynamiske landingssider tilpasser innhold og budskap automatisk til hver besøkende, for eksempel basert på bransje eller tidligere atferd.' },
  { term: 'Dyp læring', altTerm: 'DL, Deep Learning', definisjon: 'Dyp læring er en type maskinlæring som bruker mange lag i nevrale nettverk for å finne mer avanserte mønstre i store datamengder.' },
  { term: 'E-postassistent', definisjon: 'En e-postassistent bruker generativ KI til å foreslå eller skrive svar på kunders e-poster, som deretter kan godkjennes eller justeres av medarbeiderne.' },
  { term: 'Edge AI', definisjon: 'Edge AI betyr at KI-kjøringen skjer nær brukeren eller enheten, for eksempel i sensorer, mobiltelefoner eller maskiner ute i felt.' },
  { term: 'Embedding', altTerm: 'vektorrepresentasjon', definisjon: 'En embedding er selve tallrekken som representerer et ord, en setning eller et dokument i en vektorisert form.' },
  { term: 'Promptkjede', definisjon: 'En promptkjede er når du deler en større oppgave opp i flere steg og bruker flere etterfølgende prompts som bygger videre på hverandre.' },
  { term: 'Eskalering til menneske', altTerm: 'handover', definisjon: 'Eskalering til menneske er når en sak som KI ikke bør løse selv, automatisk sendes videre til en medarbeider med nødvendig kontekst.' },
  { term: 'Etisk KI', definisjon: 'Etisk KI betyr at løsninger med kunstig intelligens tar hensyn til menneskerettigheter, verdighet, rettferdighet og mulige utilsiktede konsekvenser.' },
  { term: 'EU AI Act', altTerm: 'EUs KI-forordning, AI Act', definisjon: 'EU AI Act er EUs nye regelverk for kunstig intelligens som stiller ulike krav til KI-systemer avhengig av hvor høy risiko de utgjør for mennesker og samfunn.' },
  { term: 'Evalueringsmetrikker', definisjon: 'Evalueringsmetrikker er mål som brukes for å vurdere hvor godt en KI-modell fungerer.' },
  { term: 'Explainable AI', altTerm: 'XAI, forklarbar KI', definisjon: 'Forklarbar KI er metoder og verktøy som gjør det mulig å forstå hvorfor en modell gir et bestemt resultat eller anbefaling.' },
  { term: 'F1-score', definisjon: 'F1-score er et samlet mål som balanserer presisjon og recall i én verdi.' },
  { term: 'Fairness', altTerm: 'rettferdighet', definisjon: 'Fairness handler om at KI-løsninger skal behandle personer og grupper på en mest mulig rettferdig og ikke-diskriminerende måte.' },
  { term: 'Feature', altTerm: 'egenskap', definisjon: 'En feature er en enkelt egenskap eller variabel i dataene som modellen bruker for å gjøre beregninger, for eksempel alder, pris eller kundetype.' },
  { term: 'Feature store', definisjon: 'En feature store er et felles lager der du samler og gjenbruker bearbeidede datapunkter (features) som brukes i flere KI-modeller.' },
  { term: 'Few-shot learning', definisjon: 'Few-shot learning er når du gir modellen noen få eksempler i prompten for å vise hvordan du vil ha svaret.' },
  { term: 'Fine-tuning', definisjon: 'Fine-tuning er å tilpasse en ferdig pre-trent modell til en bestemt oppgave eller et bestemt domene ved å trene videre på egne data.' },
  { term: 'Foundation model / grunnmodell i EU-regulering', definisjon: 'I AI Act får grunnmodeller egne krav, blant annet til dokumentasjon, risikohåndtering og åpenhet om trening, fordi de brukes som basis i mange andre KI-løsninger.' },
  { term: 'GDPR', altTerm: 'personvernforordningen', definisjon: 'GDPR er EUs regelverk for personvern som setter krav til hvordan virksomheter samler inn, lagrer og bruker personopplysninger.' },
  { term: 'Generaliseringsevne', definisjon: 'Generaliseringsevne er modellens evne til å gi gode resultater på nye data som den ikke har sett under trening.' },
  { term: 'Generativ kunstig intelligens', altTerm: 'GenAI, Generative AI', definisjon: 'Generativ KI er systemer som kan skape nytt innhold, for eksempel tekst, bilder, lyd eller video, basert på det de har lært fra store mengder data.' },
  { term: 'Generator', altTerm: 'genereringsmodell i RAG', definisjon: 'Generatoren er KI-modellen som bruker de hentede tekstbitene til å formulere et naturlig og sammenhengende svar.' },
  { term: 'GPU', altTerm: 'Graphics Processing Unit', definisjon: 'En GPU er en type prosessor som er spesielt god til å kjøre tunge KI-beregninger raskt.' },
  { term: 'Ground truth', altTerm: 'fasitdata', definisjon: 'Ground truth er «fasiten» modellen måles mot, altså de riktige svarene som brukes til å vurdere hvor god modellen er.' },
  { term: 'Grounding', altTerm: 'faktagrunnlag for svar', definisjon: 'Grounding betyr at KI svarer med utgangspunkt i konkrete kilder, for eksempel egne dokumenter, slik at svaret får et tydelig faktagrunnlag.' },
  { term: 'Guardrails', altTerm: 'sikkerhets- og policy-gjerder', definisjon: 'Guardrails er tekniske og praktiske sikkerhetstiltak som sørger for at KI-modellen følger lover, etiske krav og virksomhetens retningslinjer.' },
  { term: 'Hallusinasjon', altTerm: 'model hallucination', definisjon: 'Hallusinasjon betyr at KI-modellen gir et svar som ser troverdig ut, men som er feil eller finner opp fakta.' },
  { term: 'Halvstrukturerte data', definisjon: 'Halvstrukturerte data har noe struktur, men ikke like strengt som en tabell, for eksempel JSON-, XML- eller loggfiler.' },
  { term: 'Handlinger', altTerm: 'actions', definisjon: 'Handlinger er konkrete operasjoner agenten utfører, for eksempel å sende en e-post, opprette en sak i et system eller hente et dokument.' },
  { term: 'Human evaluation', altTerm: 'menneskelig evaluering', definisjon: 'Menneskelig evaluering betyr at mennesker vurderer kvaliteten på modellens svar ut fra for eksempel nytte, korrekthet og forståelighet.' },
  { term: 'Hybrid søk', altTerm: 'semantisk + nøkkelord', definisjon: 'Hybrid søk kombinerer semantisk søk og tradisjonelt nøkkelordssøk for å gi mer treffsikre resultater.' },
  { term: 'Hyperautomatisering', definisjon: 'Hyperautomatisering er når en virksomhet kombinerer KI, programvare og prosessverktøy for å automatisere så mange arbeidsoppgaver og prosesser som mulig fra ende til ende.' },
  { term: 'Hyperparametere', definisjon: 'Hyperparametere er innstillinger som styrer hvordan en modell trenes, for eksempel læringsrate eller hvor mange ganger den skal gå gjennom dataene.' },
  { term: 'Høyrisikosystemer i AI Act', definisjon: 'Høyrisikosystemer er KI-løsninger som kan påvirke sikkerhet, helse, rettigheter eller viktige beslutninger og som derfor må oppfylle strenge krav til dokumentasjon, risikostyring og tilsyn.' },
  { term: 'Indeksering', altTerm: 'index, vector index', definisjon: 'Indeksering er å organisere tekstbiter og embeddings i en struktur som gjør søk og gjenfinning raskt og effektivt.' },
  { term: 'Inferens', altTerm: 'inference', definisjon: 'Inferens er når en ferdigtrent KI-modell brukes til å svare, forutsi eller anbefale noe i sanntid eller nær sanntid.' },
  { term: 'Innholdsgenerering', definisjon: 'Innholdsgenerering er når generativ KI skriver utkast til artikler, annonser, nyhetsbrev eller sosiale medier-innlegg basert på en kort instruks.' },
  { term: 'Instruct-modell', altTerm: 'instruksjonstrent modell', definisjon: 'En instruct-modell er en grunnmodell som er videre trent til å følge instruksjoner og svare mer presist på konkrete spørsmål og oppgaver.' },
  { term: 'Instruksjonstuning', altTerm: 'instruction tuning', definisjon: 'Instruksjonstuning er fine-tuning der modellen trenes spesielt på å følge menneskelige instruksjoner og svare mer strukturert og nyttig.' },
  { term: 'Jailbreak', definisjon: 'Jailbreak er forsøk på å lure modellen til å bryte sikkerhetsregler og gi svar den egentlig ikke skal gi.' },
  { term: 'Klassifikasjonsmodell', definisjon: 'En klassifikasjonsmodell deler ting inn i kategorier, for eksempel «spammail» eller «ikke spam».' },
  { term: 'Klassisk KI vs generativ KI', definisjon: 'Klassisk KI løser spesifikke oppgaver som å sortere eller forutsi tall, mens generativ KI i tillegg kan skape nytt innhold, som tekst og bilder.' },
  { term: 'Knowledge cutoff / kunnskapsavgrensning', definisjon: 'Knowledge cutoff er tidspunktet der modellen sluttet å lære av nye data, som forklarer hvorfor den ikke kjenner hendelser eller endringer etter en viss dato.' },
  { term: 'Knowledge distillation', altTerm: 'modell-destillasjon', definisjon: 'Knowledge distillation er når en mindre modell trenes til å etterligne en stor modell, slik at man får raskere og lettere løsninger med mye av samme kunnskap.' },
  { term: 'Kontekstvindu', altTerm: 'context window', definisjon: 'Kontekstvindu er den mengden tekst og informasjon modellen kan «ha i hodet» samtidig når den svarer.' },
  { term: 'Kundeservicebot', altTerm: 'chatbot', definisjon: 'En kundeservicebot er en KI-drevet chatløsning som svarer på kundehenvendelser automatisk i kanalene deres, for eksempel på nettsiden eller i sosiale medier.' },
  { term: 'Kunnskapsbase', altTerm: 'knowledge base', definisjon: 'En kunnskapsbase er et strukturert lager med informasjon, ofte spørsmål og svar eller artikler, som KI kan hente fra.' },
  { term: 'Kunstig generell intelligens', altTerm: 'AGI, Artificial General Intelligence', definisjon: 'AGI er en teoretisk form for KI som kan løse et bredt spekter av oppgaver like godt eller bedre enn mennesker, og som ikke har blitt utviklet i skrivende stund.' },
  { term: 'Label / målvariabel', definisjon: 'Label eller målvariabel er det modellen prøver å forutsi, for eksempel om en kunde vil slutte, eller hvilken kategori et bilde tilhører.' },
  { term: 'Latens', definisjon: 'Latens er tiden det tar fra en forespørsel sendes til KI-modellen til svaret kommer tilbake.' },
  { term: 'LLMOps', altTerm: 'operasjonalisering av språkmodeller', definisjon: 'LLMOps er MLOps spesielt tilpasset store språkmodeller, fra trening og tilpasning til drift, overvåking og forbedring.' },
  { term: 'LoRA', altTerm: 'Low-Rank Adaptation', definisjon: 'LoRA er en PEFT-metode der man legger til små ekstra lag i modellen i stedet for å endre alle de opprinnelige parameterne.' },
  { term: 'Marketing automation', definisjon: 'Marketing automation er bruk av KI og regler for å automatisere utsendelser og kampanjer basert på mottakerens atferd og interesser.' },
  { term: 'Maskinlæring', altTerm: 'ML, Machine Learning', definisjon: 'Maskinlæring er en metode der datamodeller lærer mønstre fra data for å kunne forutsi, foreslå eller ta beslutninger uten å være detaljprogrammert for hver oppgave.' },
  { term: 'Metadata', definisjon: 'Metadata er «data om data», for eksempel hvem som har laget datasettet, når det ble oppdatert og hva feltene betyr.' },
  { term: 'Minne i agenter', altTerm: 'short-term og long-term memory', definisjon: 'Minne i agenter er informasjon de husker fra tidligere steg eller økter, slik at de kan tilpasse seg brukeren og jobben over tid.' },
  { term: 'MLOps', altTerm: 'Machine Learning Operations', definisjon: 'MLOps er metodikk og verktøy for å få KI-modeller trygt og effektivt fra utvikling til drift og holde dem oppdatert.' },
  { term: 'Model cards / system cards', definisjon: 'Model cards og system cards er dokumenter som beskriver formål, trening, begrensninger og risiko ved en KI-modell på en forståelig måte.' },
  { term: 'Modellarkitektur', definisjon: 'Modellarkitektur er «oppskriften» på hvordan en KI-modell er bygget opp, for eksempel hvilke lag den har og hvordan data flyter gjennom modellen.' },
  { term: 'Modellendepunkt', altTerm: 'inference endpoint', definisjon: 'Et modellendepunkt er en teknisk «adresse» der andre systemer kan sende inn data og få svar tilbake fra KI-modellen via nettverk.' },
  { term: 'Modellgjennomsiktighet', altTerm: 'transparency', definisjon: 'Modellgjennomsiktighet betyr at det finnes innsikt i hvordan modellen er bygget, hvilke data den er trent på og hvilke begrensninger den har.' },
  { term: 'Modellregister', altTerm: 'model registry', definisjon: 'Et modellregister er et system der du lagrer og versjonerer KI-modeller, med oversikt over hvilke som er godkjent og i bruk.' },
  { term: 'Modellrisiko', definisjon: 'Modellrisiko er risikoen for at KI-modellen tar feil, brukes feil eller oppfører seg uventet og dermed påvirker beslutninger eller prosesser negativt.' },
  { term: 'Multimodal modell', definisjon: 'En multimodal modell er KI som kan forstå og kombinere flere typer innhold samtidig, for eksempel tekst, bilder, lyd og video.' },
  { term: 'MVP', altTerm: 'Minimum Viable Product', definisjon: 'En MVP er en første versjon av en løsning med bare de viktigste funksjonene, slik at man kan teste verdien raskt og forbedre videre.' },
  { term: 'Nevralt nettverk', altTerm: 'neural network, NN', definisjon: 'Et nevralt nettverk er en modell inspirert av hjernen vår, bygget opp av mange enkle «noder» som samarbeider for å gjenkjenne mønstre i data.' },
  { term: 'Nøyaktighet', altTerm: 'accuracy', definisjon: 'Nøyaktighet viser hvor stor andel av alle prediksjonene modellen gjør som er riktige.' },
  { term: 'Observability for KI', definisjon: 'Observability for KI betyr å ha god innsikt i hvordan modeller og datastrømmer fungerer i praksis, slik at du kan oppdage problemer og forbedringsmuligheter.' },
  { term: 'Observasjoner', altTerm: 'observations', definisjon: 'Observasjoner er tilbakemeldinger agenten får etter en handling, for eksempel svaret fra en API eller innholdet i et dokument den har åpnet.' },
  { term: 'On-prem', altTerm: 'lokalt', definisjon: 'On-prem betyr at løsningene kjører på servere virksomheten selv eier og drifter i egne lokaler eller datasentre.' },
  { term: 'One-shot learning', definisjon: 'One-shot learning er når du gir modellen ett eksempel i prompten for å styre hvordan den skal svare.' },
  { term: 'Opphavsrett og KI-trening', definisjon: 'Når det gjelder opphavsrett og KI-trening, handler dette om når og hvordan opphavsrettslig beskyttet materiale kan brukes som treningsdata for KI-modeller, og hvilke begrensninger og krav til hjemmel som gjelder.' },
  { term: 'Opphavsrett til KI-generert innhold', definisjon: 'Opphavsrett til KI-generert innhold dreier seg om hvem som eventuelt har rettigheter til innhold skapt ved hjelp av KI, og i hvilken grad dette regnes som verk med menneskelig opphav.' },
  { term: 'Orkestrering', altTerm: 'orchestration', definisjon: 'Orkestrering er å styre samspillet mellom flere KI-agenter, verktøy og systemer slik at de utfører en prosess i riktig rekkefølge.' },
  { term: 'Overfitting', altTerm: 'overtilpasning', definisjon: 'Overfitting betyr at modellen blir for godt tilpasset treningsdataene og derfor gjør det dårligere på nye, ukjente data.' },
  { term: 'Overvåking', altTerm: 'monitoring', definisjon: 'Overvåking er å følge med på hvordan KI-systemer og infrastruktur oppfører seg, for eksempel ytelse, feil og kostnader.' },
  { term: 'Parameter-efficient fine-tuning', altTerm: 'PEFT', definisjon: 'PEFT er teknikker som gjør det mulig å tilpasse store modeller med mye mindre datamengder og beregningskraft enn full trening krever.' },
  { term: 'Perpleksitet', altTerm: 'perplexity', definisjon: 'Perpleksitet er et mål på hvor godt en språkmodell forstår og forutsier tekst, der lavere verdi betyr bedre modell.' },
  { term: 'Personaliseringsmotor', definisjon: 'En personaliseringsmotor er en løsning som tilpasser innhold, tilbud eller kommunikasjon til hver enkelt bruker basert på data og atferd.' },
  { term: 'Personvern', altTerm: 'privacy', definisjon: 'Personvern handler om den enkeltes rett til kontroll over egne personopplysninger og hvordan de brukes av offentlige og private aktører.' },
  { term: 'Pilotprosjekt', definisjon: 'Et pilotprosjekt er en test av KI-løsningen i en begrenset del av virksomheten med ekte brukere og data.' },
  { term: 'Planlegging og resonnement', altTerm: 'planning and reasoning', definisjon: 'Planlegging og resonnement er agentens evne til å bryte ned et mål i deloppgaver, ta fornuftige valg og justere kursen underveis.' },
  { term: 'Plugins / verktøy / connectors', definisjon: 'Plugins, verktøy og connectors er «adaptere» som kobler KI til andre systemer, som e-post, dokumentlager eller fagsystemer.' },
  { term: 'Pre-trening', altTerm: 'pre-training', definisjon: 'Pre-trening er den første, omfattende treningen der modellen lærer generelle mønstre fra enorme datamengder før den tilpasses konkrete oppgaver.' },
  { term: 'Predictive analytics', definisjon: 'Predictive analytics bruker data og modeller til å forutsi hva som sannsynligvis vil skje fremover, for eksempel salg, avgang eller etterspørsel.' },
  { term: 'Prescriptive analytics', definisjon: 'Prescriptive analytics går et steg videre og foreslår konkrete tiltak eller valg basert på analyser og prediksjoner.' },
  { term: 'Presisjon', altTerm: 'precision', definisjon: 'Presisjon måler hvor stor andel av det modellen har merket som «riktig» som faktisk er riktig.' },
  { term: 'Privacy by design / by default', definisjon: 'Privacy by design / by default betyr at personvern skal bygges inn i løsninger fra starten av, og at høyeste grad av personvern skal være standardinnstilling.' },
  { term: 'Prompt', altTerm: 'innprompt, instruksjon', definisjon: 'En prompt er teksten eller instruksjonen du gir KI-modellen for å fortelle hva den skal gjøre.' },
  { term: 'Prompt engineering', definisjon: 'Prompt engineering er kunsten å formulere gode og presise spørsmål eller instruksjoner slik at KI gir bedre og mer nyttige svar.' },
  { term: 'Prompt template', altTerm: 'promptmal', definisjon: 'En promptmal er en ferdig struktur for hvordan du stiller spørsmål til KI, som du kan gjenbruke på tvers av oppgaver.' },
  { term: 'Proof of Concept', definisjon: 'En PoC er et avgrenset forsøk som skal vise om en idé eller KI-løsning faktisk fungerer teknisk og faglig før man investerer mer.' },
  { term: 'Prosesskartlegging', definisjon: 'Prosesskartlegging er å beskrive hvordan arbeidet faktisk gjøres i dag, steg for steg, for å se hvor KI og automatisering kan gi verdi.' },
  { term: 'Recall', definisjon: 'Recall måler hvor stor andel av alle de riktige tilfellene i dataene som modellen klarer å finne.' },
  { term: 'Regressjonsmodell', definisjon: 'En regresjonsmodell forutsier et tall, for eksempel omsetning neste måned eller forventet kundelivstid.' },
  { term: 'Regularisering', definisjon: 'Regularisering er teknikker som hindrer modellen i å lære for mye «støy» i dataene og hjelper den å generalisere bedre.' },
  { term: 'Reinforcement learning', altTerm: 'orsterkningslæring', definisjon: 'Forsterkningslæring betyr at en modell lærer ved å prøve seg frem og få belønning eller «straff» basert på hvor gode beslutninger den tar.' },
  { term: 'Ansvarlig KI', definisjon: 'Ansvarlig KI handler om å utvikle og bruke kunstig intelligens på en måte som er trygg, rettferdig, lovlig og i tråd med samfunnets verdier.' },
  { term: 'Retrieval-Augmented Generation', altTerm: 'RAG', definisjon: 'RAG er en måte å kombinere KI med egne dokumenter, der modellen først henter relevant informasjon og så skriver et svar basert på denne informasjonen.' },
  { term: 'Retriever', altTerm: 'hentekomponent i RAG', definisjon: 'Retrieveren er den delen av RAG-løsningen som finner og henter de mest relevante dokumentene eller tekstbitene før svaret genereres.' },
  { term: 'Risikoanalyse', definisjon: 'Risikoanalyse for KI er en systematisk vurdering av mulige negative konsekvenser ved å ta i bruk en KI-løsning og hvordan disse kan håndteres.' },
  { term: 'ROI for KI-prosjekter', definisjon: 'ROI (Return on Investment) for KI-prosjekter er forholdet mellom gevinstene prosjektet skaper og kostnadene ved å gjennomføre det.' },
  { term: 'Sales intelligence', definisjon: 'Sales intelligence er bruk av KI til å samle og analysere kunde- og markedsdata for å gi selgere bedre innsikt før møter og oppfølging.' },
  { term: 'Self-supervised learning', definisjon: 'Self-supervised learning er en teknikk der modellen lager sine egne «treningsoppgaver» fra rådata for å lære mønstre uten manuelt merkearbeid.' },
  { term: 'Selvbetjent førstelinje', definisjon: 'Selvbetjent førstelinje betyr at KI håndterer de vanligste og enkleste henvendelsene før saken eventuelt sendes videre til et menneske.' },
  { term: 'Semantisk søk', definisjon: 'Semantisk søk betyr at systemet søker etter mening og sammenheng i teksten, ikke bare nøyaktige ord og uttrykk.' },
  { term: 'Semi-supervised learning', definisjon: 'Semi-supervised learning kombinerer litt merkede data med mye umerkede data for å trene modeller mer effektivt.' },
  { term: 'Sentimentanalyse', definisjon: 'Sentimentanalyse er når KI vurderer om kunden virker fornøyd, frustrert eller sint, slik at alvorlige saker kan prioriteres.' },
  { term: 'Skalerbarhet', altTerm: 'scalability', definisjon: 'Skalerbarhet er systemets evne til å håndtere flere brukere eller mer trafikk uten å stoppe opp eller bli veldig tregt.' },
  { term: 'Skyplattform', altTerm: 'cloud', definisjon: 'En skyplattform er infrastruktur levert over internett der du kan leie datakraft, lagring og KI-tjenester etter behov.' },
  { term: 'Smal KI', altTerm: 'narrow AI', definisjon: 'Smal KI er kunstig intelligens som er laget for én avgrenset oppgave, for eksempel å anbefale produkter eller oppdage svindel i betalinger.' },
  { term: 'Stor språkmodell', altTerm: 'Large Language Model, LLM', definisjon: 'En stor språkmodell er en type KI som er trent på store mengder tekst og kan skrive, oppsummere, oversette og svare på spørsmål i naturlig språk.' },
  { term: 'Strukturerte data', definisjon: 'Strukturerte data er informasjon som er organisert i faste formater, for eksempel rader og kolonner i en tabell eller database.' },
  { term: 'Supervised learning', altTerm: 'overvåket læring', definisjon: 'Overvåket læring betyr at modellen lærer fra data der fasiten allerede er kjent, for eksempel bilder merket som «kunde» eller «ikke kunde».' },
  { term: 'Systemprompt', definisjon: 'En systemprompt er en «grunninstruks» som setter rolle, stil og rammer for hvordan KI-modellen skal opptre i en samtale.' },
  { term: 'Tale til tekst', altTerm: 'ASR, automatic speech recognition', definisjon: 'Tale til tekst er teknologi som omgjør lydopptak eller tale i sanntid til skriftlig tekst.' },
  { term: 'Tekst til bilde', altTerm: 'text-to-image', definisjon: 'Text-to-image til bilde betyr at du skriver inn en beskrivelse og KI genererer et nytt bilde basert på teksten.' },
  { term: 'Tekst til tale', altTerm: 'TTS, text-to-speech', definisjon: 'Text-to-speech er teknologi som leser opp tekst med syntetisk stemme, for eksempel lydbøker eller opplesning av artikler.' },
  { term: 'Tekst til tekst', altTerm: 'text-to-text', definisjon: 'Text-to-text til tekst betyr at du skriver inn tekst og modellen svarer med ny tekst, for eksempel et utkast, en oppsummering eller en oversettelse.' },
  { term: 'Tekst til video', altTerm: 'text-to-video', definisjon: 'Text-to-video betyr at du beskriver en scene eller et innhold og KI lager en enkel video som matcher beskrivelsen.' },
  { term: 'Temperatur', altTerm: 'sampling temperature', definisjon: 'Temperatur styrer hvor kreative svarene blir, lav temperatur gir tryggere og mer forutsigbare svar mens høy temperatur gir mer varierte og kreative svar.' },
  { term: 'Testdata', altTerm: 'test set', definisjon: 'Testdata er et eget datasett som brukes til å sjekke hvor godt en ferdigtrent modell fungerer på nye data.' },
  { term: 'Testdata, valideringsdata, hold-out set', definisjon: 'Testdata, valideringsdata og hold-out set er egne datasett som holdes utenfor treningen og brukes til å måle hvor godt modellen fungerer på nye data.' },
  { term: 'Throughput', definisjon: 'Throughput er hvor mange forespørsler eller beregninger et system kan håndtere per sekund eller per tidsenhet.' },
  { term: 'Tidsserieanalyse', definisjon: 'Tidsserieanalyse er metoder som analyserer utvikling over tid, for eksempel salg per uke eller strømpris per time, for å kunne forstå og forutsi trender.' },
  { term: 'Token', definisjon: 'En token er en liten tekstbit (ofte et ord eller en del av et ord) som modellen teller når den leser og skriver. Siden den bare kan håndtere et begrenset antall om gangen, er det antallet tokens som bestemmer hvor mye av samtalen den kan «ha i hodet» på en gang.' },
  { term: 'Tokenisering', definisjon: 'Tokenisering er prosessen der tekst deles opp i tokens som modellen kan behandle.' },
  { term: 'Top-k sampling', definisjon: 'Top-k er en metode som begrenser valgene modellen gjør til de k mest sannsynlige ordene, for eksempel de 40 mest sannsynlige.' },
  { term: 'Top-p / nucleus sampling', definisjon: 'Top-p er en metode som begrenser valgene modellen gjør til de mest sannsynlige ordene som samlet utgjør en viss sannsynlighet, for eksempel 90 prosent.' },
  { term: 'Total cost of ownership', altTerm: 'TCO', definisjon: 'TCO er den samlede kostnaden ved en KI-løsning over tid, inkludert lisens, drift, vedlikehold, opplæring og endringer.' },
  { term: 'TPU', altTerm: 'Tensor Processing Unit', definisjon: 'En TPU er en spesiallaget prosessor fra Google som er optimalisert for maskinlæring og KI-arbeidslaster.' },
  { term: 'Transfer learning', definisjon: 'Transfer learning betyr at en modell som allerede kan mye fra ett område finjusteres til en ny oppgave med mindre data.' },
  { term: 'Transformer-arkitektur', altTerm: 'Transformer', definisjon: 'Transformer er en moderne modellarkitektur som er spesielt god til å håndtere tekst og sekvenser, og som ligger til grunn for dagens store språkmodeller.' },
  { term: 'Trening', altTerm: 'training', definisjon: 'Trening er prosessen der en KI-modell lærer mønstre ved å gå gjennom store mengder data mange ganger.' },
  { term: 'Treningsdata', altTerm: 'training data', definisjon: 'Treningsdata er de dataene en KI-modell lærer fra for å finne mønstre og sammenhenger.' },
  { term: 'Underfitting', definisjon: 'Underfitting betyr at modellen er for enkel eller for dårlig trent til å fange de viktige mønstrene i dataene.' },
  { term: 'Unsupervised learning', altTerm: 'uovervåket læring', definisjon: 'Uovervåket læring brukes når modellen skal finne mønstre og grupper i data uten at det finnes en kjent fasit.' },
  { term: 'Use case', altTerm: 'bruksområde', definisjon: 'Et use case er en konkret beskrivelse av hvordan KI skal brukes i praksis for å gi verdi, for eksempel «automatisere kundeservice» eller «forutsi etterspørsel».' },
  { term: 'Ustrukturerte data', definisjon: 'Ustrukturerte data er informasjon uten fast struktur, som e-poster, dokumenter, bilder, video eller fritekst.' },
  { term: 'Valideringsdata', altTerm: 'validation set', definisjon: 'Valideringsdata er et datasett som brukes under trening for å finjustere modellen og unngå at den blir for tilpasset treningsdataene.' },
  { term: 'Vektordatabase', altTerm: 'vector database, vector store', definisjon: 'En vektordatabase er en database som lagrer embeddings slik at systemet raskt kan finne innhold som ligner på det brukeren spør om.' },
  { term: 'Vektorisering', definisjon: 'Vektorisering betyr å gjøre tekst eller innhold om til tall som gjør det mulig for KI å sammenligne betydning og likhet mellom ulike tekster.' },
  { term: 'Verktøyskalling / tool calling', altTerm: 'function calling', definisjon: 'Verktøyskalling betyr at KI-modellen kan kalle eksterne verktøy eller funksjoner, for eksempel søk i CRM eller oppslag i et fagsystem, mens den løser en oppgave.' },
  { term: 'Zero-shot learning', definisjon: 'Zero-shot learning er når modellen løser en oppgave kun basert på instruksjonen, uten at du gir eksempler i prompten.' },
];

// Use CMS data if available, otherwise fall back to hardcoded list
const ordliste: OrdEntry[] = cmsOrdliste.length > 0 ? cmsOrdliste : fallbackOrdliste;

// Group by first letter
const grouped = ordliste
  .sort((a, b) => a.term.localeCompare(b.term, 'nb'))
  .reduce<Record<string, OrdEntry[]>>((acc, entry) => {
    const letter = entry.term[0].toUpperCase();
    if (!acc[letter]) acc[letter] = [];
    acc[letter].push(entry);
    return acc;
  }, {});

const letters = Object.keys(grouped).sort((a, b) => a.localeCompare(b, 'nb'));

// Build letter groups of ~20 entries each for pagination
const PAGE_SIZE = 20;
interface LetterGroup {
  label: string;       // e.g. "A–B" or "K"
  letters: string[];   // e.g. ["A", "B"]
  entries: OrdEntry[];
}

const allGroups: LetterGroup[] = [];
let currentGroup: LetterGroup = { label: '', letters: [], entries: [] };

for (const letter of letters) {
  const letterEntries = grouped[letter];
  // If adding this letter would exceed PAGE_SIZE and we already have entries, start a new group
  if (currentGroup.entries.length > 0 && currentGroup.entries.length + letterEntries.length > PAGE_SIZE) {
    currentGroup.label = currentGroup.letters.length === 1
      ? currentGroup.letters[0]
      : `${currentGroup.letters[0]}–${currentGroup.letters[currentGroup.letters.length - 1]}`;
    allGroups.push(currentGroup);
    currentGroup = { label: '', letters: [], entries: [] };
  }
  currentGroup.letters.push(letter);
  currentGroup.entries.push(...letterEntries);
}
// Push remaining
if (currentGroup.entries.length > 0) {
  currentGroup.label = currentGroup.letters.length === 1
    ? currentGroup.letters[0]
    : `${currentGroup.letters[0]}–${currentGroup.letters[currentGroup.letters.length - 1]}`;
  allGroups.push(currentGroup);
}

// Use URL param for current page
const currentPage = parseInt(Astro.url.searchParams.get('side') || '0');
const activePage = Math.max(0, Math.min(currentPage, allGroups.length - 1));
const activeGroup = allGroups[activePage];

const ordbokJsonLd = definedTermSetSchema(
  ordliste.map((e) => ({ term: e.term, definition: e.definisjon, alternativTerm: e.altTerm })),
);
---

<Layout
  title={ordbokTittel}
  description={ordbokSamling?.lead?.replace(/<[^>]+>/g, '').trim() || 'KI ordboken forklarer vanlige begreper innen kunstig intelligens. Søk etter et ord eller bla deg gjennom listen.'}
>
  <script type="application/ld+json" set:html={JSON.stringify(ordbokJsonLd).replace(/</g, '\\u003c')} />
  <div class="ordbok-page">
    <div class="ordbok-header">
      <h1 class="ordbok-title">{ordbokTittel}</h1>
      <div class="ordbok-lead" set:html={ordbokLeadHtml}></div>

      <div class="search-container">
        <div class="search-inner">
          <label for="ordbok-search" class="sr-only">Søk etter begrep</label>
          <div class="search-input-wrap">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              id="ordbok-search"
              class="search-input"
              type="search"
              placeholder="Søk etter begrep..."
              autocomplete="off"
            />
          </div>
          <button class="search-btn" type="button" aria-label="Søk">Søk</button>
        </div>
      </div>
    </div>

    <div class="ordbok-content">
      <div class="sort-toolbar">
        <span class="sort-label">Begreper</span>
        <button class="sort-btn" type="button" aria-label="Sorter alfabetisk">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="14" y2="12"/>
            <line x1="4" y1="18" x2="10" y2="18"/>
          </svg>
          Alfabetisk
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      </div>

      <nav class="letter-nav" aria-label="Velg bokstavgruppe">
        {allGroups.map((group, idx) => (
          <a
            href={`?side=${idx}`}
            class={`letter-nav-link ${idx === activePage ? 'active' : ''}`}
          >{group.label}</a>
        ))}
      </nav>

      <div id="ordbok-list" class="ordbok-list">
        {letters.map((letter) => (
          <section
            class={`letter-section ${activeGroup.letters.includes(letter) ? '' : 'paginated-hidden'}`}
            data-letter={letter}
            data-page-visible={activeGroup.letters.includes(letter) ? 'true' : 'false'}
            id={`letter-${letter}`}
          >
            <h2 class="letter-heading">{letter}</h2>
            <ul class="term-list" role="list">
              {grouped[letter].map((entry, idx) => (
                <li
                  class={`term-item ${idx % 2 === 0 ? 'term-item--blue' : 'term-item--white'}`}
                  data-term={entry.term.toLowerCase()}
                  data-alt={entry.altTerm?.toLowerCase() ?? ''}
                >
                  <details class="term-details">
                    <summary class="term-summary">
                      <span class="term-name">{entry.term}</span>
                      {entry.altTerm && (
                        <span class="term-alt">({entry.altTerm})</span>
                      )}
                      <svg class="term-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </summary>
                    <div class="term-definition">
                      <p>{entry.definisjon}</p>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <p id="no-results" class="no-results" hidden>
          Ingen begreper samsvarer med søket ditt.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('ordbok-search') as HTMLInputElement | null;
  const searchBtn = document.querySelector('.search-btn') as HTMLButtonElement | null;
  const ordbokList = document.getElementById('ordbok-list');
  const noResults = document.getElementById('no-results');

  function filterOrdbok(query: string) {
    const q = query.trim().toLowerCase();
    const sections = ordbokList?.querySelectorAll<HTMLElement>('.letter-section');
    let totalVisible = 0;

    sections?.forEach((section) => {
      const items = section.querySelectorAll<HTMLElement>('.term-item');
      let sectionVisible = 0;

      items.forEach((item) => {
        const term = item.dataset.term ?? '';
        const alt = item.dataset.alt ?? '';
        const matches = q === '' || term.includes(q) || alt.includes(q);
        item.hidden = !matches;
        if (matches) sectionVisible++;
      });

      section.hidden = sectionVisible === 0;
      totalVisible += sectionVisible;
    });

    if (noResults) noResults.hidden = totalVisible > 0;
  }

  searchInput?.addEventListener('input', (e) => {
    filterOrdbok((e.target as HTMLInputElement).value);
  });

  searchBtn?.addEventListener('click', () => {
    filterOrdbok(searchInput?.value ?? '');
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') filterOrdbok(searchInput.value);
  });

  // Sort toggle: reverse everything (sections + terms within each section + nav links)
  let reversed = false;
  const sortBtn = document.querySelector('.sort-btn') as HTMLButtonElement | null;
  const sortChevron = sortBtn?.querySelector('svg:last-child') as SVGElement | null;

  sortBtn?.addEventListener('click', () => {
    reversed = !reversed;

    // Reverse sections in DOM
    const sections = Array.from(ordbokList?.querySelectorAll<HTMLElement>('.letter-section') ?? []);
    sections.reverse().forEach((s) => ordbokList?.appendChild(s));

    // Reverse terms within each section
    sections.forEach((section) => {
      const list = section.querySelector('.term-list');
      if (!list) return;
      const items = Array.from(list.children);
      items.reverse().forEach((item) => list.appendChild(item));
    });

    // Reverse nav links
    const nav = document.querySelector('.letter-nav');
    if (nav) {
      const links = Array.from(nav.children);
      links.reverse().forEach((link) => nav.appendChild(link));
    }

    if (sortChevron) sortChevron.style.transform = reversed ? 'rotate(180deg)' : '';
    sortBtn.setAttribute('aria-label', reversed ? 'Sortert Å–A' : 'Sortert A–Å');
  });

  // When searching: show ALL sections (bypass pagination), filter across everything.
  // When search is cleared: restore pagination.
  const letterNav = document.querySelector('.letter-nav') as HTMLElement | null;
  const allSections = ordbokList?.querySelectorAll<HTMLElement>('.letter-section');

  function filterGlobal(query: string) {
    const q = query.trim().toLowerCase();
    const isSearching = q.length > 0;

    // Show/hide pagination nav
    if (letterNav) letterNav.style.display = isSearching ? 'none' : '';

    let totalVisible = 0;
    allSections?.forEach((section) => {
      // When searching: unhide paginated sections. When not: restore pagination.
      if (!isSearching) {
        section.classList.toggle('paginated-hidden', section.dataset.pageVisible !== 'true');
      } else {
        section.classList.remove('paginated-hidden');
      }

      const items = section.querySelectorAll<HTMLElement>('.term-item');
      let sectionVisible = 0;
      items.forEach((item) => {
        const term = item.dataset.term ?? '';
        const alt = item.dataset.alt ?? '';
        const matches = !isSearching || term.includes(q) || alt.includes(q);
        item.hidden = !matches;
        if (matches) sectionVisible++;
      });

      if (isSearching) {
        section.hidden = sectionVisible === 0;
      } else {
        section.hidden = false;
      }
      totalVisible += sectionVisible;
    });

    if (noResults) noResults.hidden = totalVisible > 0;
  }

  // Override the original filter
  filterOrdbok = filterGlobal;
</script>

