---
import Layout from '../../components/layout/Layout.astro';
import ArticleLayout from '../../components/shared/ArticleLayout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';
import NewsCard from '../../components/shared/NewsCard.astro';

import { getArtikkel, getArtikler, getPlainText } from '../../lib/umbraco';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Artikler', url: '/artikler' },
  { name: article.tittel, url: `/artikler/${slug}` },
]);

// Fetch other articles for "Flere artikler" section
const allArticlesRes = await getArtikler(10);
const otherArticles = allArticlesRes.data.filter(a => a.slug !== slug).slice(0, 3);
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />

  <section class="article-hero" data-layout-block="edge">
    <h1 class="ds-heading article-title" data-size="xl">{article.tittel}</h1>
  </section>

  <ArticleLayout>
    <Fragment slot="sidebar">
      <time class="article-sidebar-date" datetime={article.publishedAt}>
        <span class="article-sidebar-label">Publisert</span>
        {formattedDate}
      </time>
      <button class="ds-button" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
        Del
      </button>
    </Fragment>

    {article.ingress && (
      <p class="article-ingress ds-paragraph" data-size="lg">{article.ingress}</p>
    )}

    <ArticleBlocksRenderer blocks={article.innhold} defaultDate={article.publishedAt} />
  </ArticleLayout>

  {otherArticles.length > 0 && (
    <section class="more-articles" data-layout-block="content">
      <h2 class="more-articles-heading">Flere artikler</h2>
      <div class="more-articles-grid">
        {otherArticles.map(a => (
          <NewsCard
            href={`/artikler/${a.slug}`}
            title={a.tittel}
            date={a.publishedAt}
            lead={getPlainText(a.innhold, 80)}
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style is:global>
  body {
    background-color: var(--ds-color-surface-active) !important;
  }
</style>

<style>
  /* Hero / Artikkelhode */
  .article-hero {
    padding-top: var(--ds-size-30);
    padding-bottom: 48px;
    display: grid;
    grid-template-columns:
      1fr
      200px
      var(--ds-size-8)
      minmax(0, 680px)
      1fr;
  }

  .article-title {
    grid-column: 4;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .article-hero {
      grid-template-columns: 1fr;
    }
    .article-title {
      grid-column: 1;
    }
  }

  .article-ingress {
    font-family: 'PT Serif';
    margin: 0;
  }

  @media (min-width: 1024px) {
    .article-ingress {
      font-size: 28px;
    }
  }

  /* Sidebar */
  .article-sidebar-date {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  .article-sidebar-label {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-sidebar-share {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid var(--ds-color-border-default);
    border-radius: 100px;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: var(--ds-color-text-default);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .article-sidebar-share:hover {
    background-color: var(--ds-color-surface-hover);
  }

  /* More articles */
  .more-articles {
    padding: 64px 0 120px;
  }

  .more-articles-heading {
    font-size: 32px;
    font-weight: 700;
    color: #000;
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 1024px) {
    .more-articles-heading {
      font-size: 40px;
      margin-bottom: 32px;
    }
  }

  .more-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .more-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .more-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
