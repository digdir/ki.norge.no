---
import Layout from '../../components/layout/Layout.astro';
import ArticleLayout from '../../components/shared/ArticleLayout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';
import AkselIcon from '../../components/shared/AkselIcon.astro';
import NewsCard from '../../components/shared/NewsCard.astro';
import { getKalenderhendelser, getArtikler, getPlainText, getCardImage, type Kalenderhendelse } from '../../lib/umbraco';
import { breadcrumbSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

let hendelse: Kalenderhendelse | null = null;
let relatedArticles: any[] = [];

try {
  const res = await getKalenderhendelser({ preview: isPreview });
  hendelse = res.data.find(h => h.slug === slug) || null;
  const artiklerRes = await getArtikler(3);
  relatedArticles = artiklerRes.data;
} catch (e) {
  console.error('Failed to fetch kalenderhendelse:', e);
}

if (!hendelse) return Astro.redirect('/kalender');

const seoTitle = hendelse.tittel;
const seoDesc = hendelse.ingress || '';

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Kalender', url: '/kalender' },
  { name: hendelse.tittel, url: `/kalender/${slug}` },
]);

// Format date
const formatFullDate = (iso: string) => {
  const d = new Date(iso);
  return d.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
};

const dateDisplay = formatFullDate(hendelse.startDato);
const timeDisplay = hendelse.tid || '';

const arrangør = hendelse.arrangor || '';
const pris = hendelse.pris || '';
const påmeldingUrl = hendelse.lenke || '';
// Arrangementet er over: påmelding gir ikke mening lenger, men siden skal fortsatt
// kunne leses for opptak og presentasjoner.
const erAvsluttet = new Date(hendelse.sluttDato || hendelse.startDato) < new Date();
---

<Layout title={seoTitle} description={seoDesc}>
  
  <section class="article-hero" data-layout-block="edge">
    <h1 class="ds-heading article-title" data-size="xl">{hendelse.tittel}</h1>
    <p class="event-datetime">
      <time datetime={hendelse.startDato}><strong>{dateDisplay}</strong></time>
      {timeDisplay && <span class="event-time">{timeDisplay}</span>}
    </p>
  </section>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <ArticleLayout>
    <Fragment slot="sidebar">
      <div class="event-meta-item">
        <AkselIcon name="LocationPin" size={24} />
        <div><span class="event-meta-label">Sted:</span> <strong>{hendelse.sted || 'Ikke oppgitt'}</strong></div>
      </div>
      {arrangør && (
        <div class="event-meta-item">
          <AkselIcon name="HouseHeart" size={24} />
          <div><span class="event-meta-label">Arrangør:</span> <strong>{arrangør}</strong></div>
        </div>
      )}
      {pris && (
        <div class="event-meta-item">
          <AkselIcon name="Receipt" size={24} />
          <div><span class="event-meta-label">Pris:</span> <strong>{pris}</strong></div>
        </div>
      )}
      {påmeldingUrl && !erAvsluttet && (
        <a href={påmeldingUrl} class="ds-button">Påmelding</a>
      )}
    </Fragment>

    {hendelse.ingress && (
      <p class="article-ingress ds-paragraph" data-size="lg">{hendelse.ingress}</p>
    )}

    <ArticleBlocksRenderer blocks={hendelse.detaljertBeskrivelse} />
  </ArticleLayout>

  {relatedArticles.length > 0 && (
    <section class="event-related" data-layout-block="content">
      <h2 class="ds-heading event-related-heading" data-size="md">Aktuelt</h2>
      <div class="event-related-grid">
        {relatedArticles.map(a => (
          <NewsCard
            href={`/artikler/${a.slug}`}
            title={a.tittel}
            date={a.publishedAt}
            variant="image"
            image={getCardImage(a.artikkelBilde)}
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .article-hero :global(.article-title) {
    grid-column: 2 / -1;
  }

  .event-datetime {
    grid-column: 2 / -1;
    font-size: var(--ds-font-size-5);
    margin: 0;
    display: flex;
    gap: var(--ds-size-4);
    color: var(--ds-color-text-default);
    margin-block-start: var(--ds-size-6);
  }

  @media (max-width: 1024px) {
    .article-hero :global(.article-title) {
      grid-column: 1;
    }
    .event-datetime {
      grid-column: 1;
    }
  }

  :global(.event-meta-item) {
    display: flex;
    align-items: start;
    gap: var(--ds-size-2);
    font-size: var(--ds-font-size-5);

    & :global(svg) {
      flex-shrink: 0;
    }

    &:last-of-type {
      margin-block-end: var(--ds-size-6);
    }
  }

  :global(.event-meta-label) {
    font-weight: 400;
  }

  :global(.event-register-btn) {
    display: inline-block;
    margin-top: var(--ds-size-3);
    padding: var(--ds-size-2) var(--ds-size-5);
    background-color: var(--ds-color-base-default);
    color: var(--ds-color-base-contrast-default);
    border-radius: var(--ds-border-radius-md);
    font-size: var(--ds-font-size-3);
    font-weight: 600;
    text-decoration: none;
    width: fit-content;
  }

  :global(.event-register-btn:hover) {
    background-color: var(--ds-color-base-hover);
  }

  /* ── Related articles ── */
  .event-related {
    padding-block: var(--ds-size-12) var(--ds-size-22);
  }

  .event-related-heading {
    margin-block-end: var(--ds-size-8);
  }

  .event-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  /* minmax(0, 1fr) og ikke 1fr: et gridelement har min-content som automatisk
     minstebredde, og kortene her kan ikke smalne under 293px, som er 220px
     min-height gjennom aspect-ratio 4/3. Tre slike spor ble 960px, og siden
     rullet vannrett fra 768px til 1022px. Målt: 192px overflyt på 768. Samme
     grep som CardGrid (#735). */
  @media (min-width: 768px) {
    .event-related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
