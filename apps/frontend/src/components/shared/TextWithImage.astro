---
import AkselIcon from './AkselIcon.astro';

interface Props {
  title: string;
  href: string;
  image: string;
  imageAlt?: string;
}

const { title, href, image, imageAlt = '' } = Astro.props;
---

<div class="text-with-image">
  <div class="text">
    <h2 class="ds-heading" data-size="xl">
      <a href={href} class="ds-focus">
        {title}
        <span class="arrow" aria-hidden="true">
          <AkselIcon name="ArrowRight" size={28} />
        </span>
      </a>
    </h2>
    <div class="body">
      <slot />
    </div>
  </div>
  <div class="illustration">
    <img src={image} alt={imageAlt} />
  </div>
</div>

<style is:global>
  .text-with-image {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-22);

    @media (min-width: 768px) {
      grid-template-columns: 2fr 1fr;
      align-items: center;
    }

    & .text {
      display: flex;
      flex-direction: column;
      gap: var(--ds-size-3);

      & h2 {

        & a {
          display: inline-flex;
          align-items: center;
          gap: var(--ds-size-3);
          color: inherit;
          text-decoration: none;
        }
      }

      & .arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #FFD7E9;
        flex-shrink: 0;
      }

      & .body {
        font-size: 18px;
        line-height: 1.6;
        color: inherit;

        & ol, & ul {
            font-size: 1.5rem;
        }

        & li {
          line-height: 1.5;
        }

        & li p,
        & p {
          margin: 0;
          color: inherit;
        }

        & p + p {
          margin-top: var(--ds-size-4);
        }
      }
    }

    & .illustration {
      display: flex;
      align-items: center;
      justify-content: center;

      & img {
        max-width: 100%;
      }
    }
  }
</style>
