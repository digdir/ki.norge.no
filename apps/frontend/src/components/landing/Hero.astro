---
// Hero — CSS gradient background (absolute, doesn't affect flow), centered bold headline
---

<section class="hero" data-layout-block="content">
  <div class="hero-container">
    <h1 class="ds-heading" data-size="xl">Felleskapet for <strong>innovativ og ansvarlig</strong> utvikling og bruk av kunstig intelligens</h1>
    <img src="/og-image.png" alt="Illustrasjon av mennesker som samarbeider med AI" />
  </div>
</section>

<style>
  .hero {
    padding-block-start: 120px;
    padding-block-end: 80px;
  }
  
  .hero-container {
    margin: 0 auto;
    display: grid;
    gap: var(--ds-size-30);
    grid-template-columns: 1fr 1fr;

    @media (max-width: 1023px) {
      grid-template-columns: 1fr;
      gap: var(--ds-size-8);

      & h1 {
        --ds-size-mode-font-size: 0.8;
      }
    }

    & img {
      max-width: 100%;
      height: auto;
      border-radius: var(--ds-border-radius-xl);
    }

    & h1 {
      margin-block: auto;
      text-wrap: balance;
    }
  }
</style>
