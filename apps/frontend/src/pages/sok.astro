---
import Layout from '../components/layout/Layout.astro';
import { Heading, Paragraph, Link, Button } from '@digdir/designsystemet-react';
import { searchContent, type SearchResult } from '../lib/umbraco';

const query = Astro.url.searchParams.get('q')?.trim() || '';

// Content type labels and route prefixes
const typeLabels: Record<string, string> = {
  artikkel: 'Artikkel',
  eksempel: 'Eksempel',
  veiledning: 'Veiledning',
  veiledningGuide: 'Veiledning',
  veiledningSteg: 'Veiledning',
  side: 'Side',
};

const typeRoutes: Record<string, string> = {
  artikkel: '/artikler/',
  eksempel: '/eksempler/',
  veiledning: '/veiledning/',
  veiledningGuide: '/veiledning/',
  veiledningSteg: '/veiledning/',
  side: '/',
};

let results: SearchResult[] = [];
let searchError = false;

if (query) {
  try {
    const response = await searchContent(query);
    results = response.data;
  } catch (error) {
    console.error('Search failed:', error);
    searchError = true;
  }
}

function getResultUrl(result: SearchResult): string {
  const prefix = typeRoutes[result.contentType] || '/';
  return `${prefix}${result.slug}`;
}

function formatDate(dateStr: string): string {
  try {
    return new Date(dateStr).toLocaleDateString('nb-NO', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return '';
  }
}
---

<Layout title={query ? `Søk: ${query}` : 'Søk'} description="Søk i KI Norges innhold.">
  <section class="search-header">
    <div class="header-container">
      <Heading level={1} size="xlarge" className="search-heading">Søk</Heading>
      <form class="search-form" action="/sok" method="get">
        <div class="search-input-wrapper">
          <span class="material-symbols-outlined search-icon">search</span>
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Søk etter artikler, veiledninger, eksempler..."
            class="search-input"
            autocomplete="off"
            autofocus
          />
          <Button type="submit" variant="primary" size="small">Søk</Button>
        </div>
      </form>
      {query && (
        <Paragraph className="result-count">
          {results.length} {results.length === 1 ? 'resultat' : 'resultater'} for «{query}»
        </Paragraph>
      )}
    </div>
  </section>

  <div class="results-container">
    {!query ? (
      <div class="empty-state-box">
        <span class="material-symbols-outlined">manage_search</span>
        <Heading level={2} size="medium">Hva leter du etter?</Heading>
        <Paragraph>Skriv inn et søkeord for å finne artikler, veiledninger og eksempler.</Paragraph>
      </div>
    ) : searchError ? (
      <div class="empty-state-box">
        <span class="material-symbols-outlined">error_outline</span>
        <Heading level={2} size="medium">Noe gikk galt</Heading>
        <Paragraph>Søket kunne ikke gjennomføres. Prøv igjen senere.</Paragraph>
      </div>
    ) : results.length === 0 ? (
      <div class="empty-state-box">
        <span class="material-symbols-outlined">search_off</span>
        <Heading level={2} size="medium">Ingen resultater</Heading>
        <Paragraph>Vi fant ingen treff for «{query}». Prøv med andre søkeord.</Paragraph>
        <div class="suggestions">
          <Paragraph size="small">Forslag:</Paragraph>
          <div class="suggestion-links">
            <Link href="/veiledning">Utforsk veiledninger</Link>
            <Link href="/eksempler">Se eksempler</Link>
            <Link href="/artikler">Les artikler</Link>
          </div>
        </div>
      </div>
    ) : (
      <div class="results-list">
        {results.map((result) => (
          <article class="result-item">
            <div class="result-meta">
              <span class={`type-badge type-badge--${result.contentType}`}>
                {typeLabels[result.contentType] || result.contentType}
              </span>
              {result.publishedAt && (
                <span class="result-date">{formatDate(result.publishedAt)}</span>
              )}
            </div>
            <Link href={getResultUrl(result)} className="result-title">
              <Heading level={2} size="small">{result.tittel}</Heading>
            </Link>
            {result.excerpt && (
              <Paragraph size="small" className="result-excerpt">{result.excerpt}</Paragraph>
            )}
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .search-header {
    background: linear-gradient(
      135deg,
      var(--ds-color-neutral-background-default) 0%,
      var(--ds-color-accent-surface-default) 100%
    );
    padding: var(--ds-size-10) var(--ds-size-4);
  }

  .header-container {
    max-width: 700px;
    margin: 0 auto;
  }

  :global(.search-heading) {
    margin: 0 0 var(--ds-size-5);
  }

  .search-form {
    margin-bottom: var(--ds-size-4);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    background-color: var(--ds-color-neutral-surface-default);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-lg);
    padding: var(--ds-size-2) var(--ds-size-3);
  }

  .search-icon {
    color: var(--ds-color-neutral-text-subtle);
    font-size: 20px;
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--ds-font-size-1);
    font-family: var(--ds-font-family);
    color: var(--ds-color-neutral-text-default);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--ds-color-neutral-text-subtle);
  }

  :global(.result-count) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
  }

  .results-container {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--ds-size-8) var(--ds-size-4) var(--ds-size-12);
  }

  /* Results list */
  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-5);
  }

  .result-item {
    padding: var(--ds-size-5);
    background-color: var(--ds-color-neutral-surface-default);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-lg);
    transition: border-color 0.2s ease;
  }

  .result-item:hover {
    border-color: var(--ds-color-accent-border-default);
  }

  .result-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-3);
    margin-bottom: var(--ds-size-2);
  }

  .type-badge {
    display: inline-flex;
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--ds-size-1) var(--ds-size-2);
    border-radius: var(--ds-border-radius-full);
    background-color: var(--ds-color-accent-surface-default);
    color: var(--ds-color-accent-text-default);
  }

  .type-badge--eksempel {
    background-color: var(--ds-color-success-surface-default, #e6f5ea);
    color: var(--ds-color-success-text-default, #1a5c2b);
  }

  .type-badge--veiledning {
    background-color: var(--ds-color-warning-surface-default, #fff8e6);
    color: var(--ds-color-warning-text-default, #6b5900);
  }

  .result-date {
    font-size: var(--ds-font-size-0);
    color: var(--ds-color-neutral-text-subtle);
  }

  :global(.result-title) {
    text-decoration: none;
    display: block;
    margin-bottom: var(--ds-size-1);
  }

  :global(.result-title h2) {
    margin: 0;
    color: var(--ds-color-accent-text-default);
  }

  :global(.result-title:hover h2) {
    text-decoration: underline;
  }

  :global(.result-excerpt) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
  }

  /* Empty states */
  .empty-state-box {
    text-align: center;
    padding: var(--ds-size-12);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
  }

  .empty-state-box .material-symbols-outlined {
    font-size: 48px;
    color: var(--ds-color-neutral-text-subtle);
    opacity: 0.5;
    margin-bottom: var(--ds-size-4);
  }

  .empty-state-box :global(h2) {
    margin: 0 0 var(--ds-size-3);
  }

  .empty-state-box :global(p) {
    margin: 0 0 var(--ds-size-4);
    color: var(--ds-color-neutral-text-subtle);
  }

  .suggestions {
    margin-top: var(--ds-size-6);
    padding-top: var(--ds-size-4);
    border-top: 1px solid var(--ds-color-neutral-border-subtle);
  }

  .suggestion-links {
    display: flex;
    justify-content: center;
    gap: var(--ds-size-5);
    margin-top: var(--ds-size-2);
  }
</style>
