{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms-kinorgeportal",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev hosts MUST be on: the frontend's UMBRACO_PUBLIC_URL (media URLs
  // in the browser) points to cms-kinorgeportal-prod...workers.dev. They were turned on
  // in the dashboard (drift); "false" here turned them off at the next deploy (2026-07-15).
  "workers_dev": true,
  "env": {
    "tt02": {
      "name": "cms-kinorgeportal-tt02",
      "workers_dev": true,
      "vars": {
        "ORIGIN": "https://kinorgeportal.tt02.dis-core.altinn.cloud",
      },
    },
    "prod": {
      "name": "cms-kinorgeportal-prod",
      "workers_dev": true,
      "vars": {
        "ORIGIN": "https://kinorgeportal.prod.dis-core.altinn.cloud",
      },
    },
  },
}
