---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class:list={['logo', className]}>
  <img loading="lazy" decoding="async" class="logo-icon" src="/logo.svg" alt="ki.norge.no" width="32" height="34" />
  <span class="logo-text">ki.norge.no</span>
</div>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-icon {
    width: 28px;
    height: 30px;
  }

  .logo-text {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ds-color-neutral-text-default);
    letter-spacing: -0.015em;
  }

  :global([data-header-theme="dark"]) .logo-text {
    color: white;
  }

  :global([data-header-theme="dark"]) .logo-icon {
    filter: brightness(0) invert(1);
  }
</style>
