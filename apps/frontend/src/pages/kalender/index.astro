---
import Layout from '../../components/layout/Layout.astro';
import EventCard from '../../components/shared/EventCard.astro';
import { getKalender, getKalenderhendelser, type Kalenderhendelse } from '../../lib/umbraco';
import { hendelseTilEventCard, tidligereTomTekst } from '../../lib/kalender';
import { collectionPageSchema, breadcrumbSchema } from '../../lib/seo';
import { ordlengde } from '../../lib/text';

let kalender = null;
let hendelser: Kalenderhendelse[] = [];
try {
  const [k, h] = await Promise.all([getKalender(), getKalenderhendelser()]);
  kalender = k;
  hendelser = h.data;
} catch (e) {
  console.error('Failed to fetch kalender:', e);
  // CMS fetch failed: do not cache the degraded render (see middleware).
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const tittel = kalender?.tittel;
const ingress = kalender?.ingress;
const seoTitle = kalender?.seoTittel || tittel;
const seoDesc = kalender?.seoBeskrivelse || ingress;

const now = new Date();
const sortByStart = (a: Kalenderhendelse, b: Kalenderhendelse) =>
  new Date(a.startDato).getTime() - new Date(b.startDato).getTime();

// Use sluttDato if set so multi-day events stay "upcoming"
// until the last day has passed. Sorting still uses startDato.
const effectiveEnd = (h: Kalenderhendelse) => new Date(h.sluttDato || h.startDato);

// The featured entry is controlled by the editor alone. Without a chosen event no
// featured box is shown, so the editor can remove it when there is nothing to highlight.
// We used to fall back to the first upcoming event, and then there was no
// way to turn it off.
// The picker object from the Delivery API has empty properties (no slug/date), so
// look up the full event in the list by id.
const allKommende = hendelser
  .filter(h => effectiveEnd(h) >= now)
  .sort(sortByStart);
const featured = (kalender?.featuredHendelse
  ? hendelser.find(h => h.id === kalender!.featuredHendelse!.id)
  : null) ?? null;
const featuredId = featured?.id;

const kommende = allKommende
  .filter(h => h.id !== featuredId);
// When the only upcoming event has been lifted to featured, this tab becomes
// empty. Then we should not say "Ingen kommende arrangement" (that contradicts the
// featured one at the top), but point the user upwards.
const featuredErKommende = !!featured && effectiveEnd(featured) >= now;
const tidligere = hendelser
  .filter(h => h.id !== featuredId)
  .filter(h => effectiveEnd(h) < now)
  .sort((a, b) => sortByStart(b, a));

// Without upcoming events the past tab is the only one with content. Open it
// right away instead of letting the user land on an empty tab. u-tabs keeps
// the tab that already has aria-selected="true" at startup.
const startfane = allKommende.length === 0 && tidligere.length > 0 ? 'tidligere' : 'kommende';

// Upcoming first, then past. That is the order that is useful for an agent
// asking "what is happening next".
const collectionJsonLd = collectionPageSchema({
  name: tittel || seoTitle || 'Kalender',
  description: seoDesc,
  url: '/kalender',
  items: [...allKommende, ...hendelser.filter(h => effectiveEnd(h) < now).sort((a, b) => sortByStart(b, a))]
    .map(h => ({ name: h.tittel, url: `/kalender/${h.slug}` })),
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Hjem', url: '/' },
  { name: tittel || 'Kalender', url: '/kalender' },
]);
---
<Layout title={seoTitle} description={seoDesc} ogImage={kalender?.seoBilde?.url}>
  <Fragment slot="head">
    {hendelser.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd).replace(/</g, '\\u003c')} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <header class="kalender-header" data-layout-block="content">
    {tittel && <h1 class="ds-heading" data-size="xl" style={ordlengde(tittel)}>{tittel}</h1>}
    {ingress && <p class="kalender-ingress">{ingress}</p>}
  </header>

  {featured && (
    <section class="kalender-featured" data-layout-block="edge" data-clickdelegatefor="featured-event">
      <div class="kalender-featured-inner" data-layout-block="content">
        <h2 class="ds-heading" data-size="lg"><a id="featured-event" href={`/kalender/${featured.slug}`}>{featured.tittel}</a></h2>
        {featured.ingress && <p class="kalender-featured-ingress">{featured.ingress}</p>}
        <EventCard {...hendelseTilEventCard(featured, { variant: 'featured', clickable: false })} />
      </div>
    </section>
  )}

  <!-- No visible heading here: the page title is "Arrangementer", and an h2 with
       the same word right below reads as a duplicate (#640). Instead the panels each
       have their own hidden h2, otherwise the page jumps from h1 straight to the card titles' h3. The
       hidden panel has hidden, so only the active one contributes to the heading list. -->
  <section class="kalender-arrangementer" data-layout-block="content">
    <ds-tabs class="ds-tabs kalender-tabs">
      <ds-tablist aria-label="Arrangementer">
        <ds-tab aria-controls="panel-kommende" data-value="kommende" aria-selected={String(startfane === 'kommende')}>Kommende arrangement</ds-tab>
        <ds-tab aria-controls="panel-tidligere" data-value="tidligere" aria-selected={String(startfane === 'tidligere')}>Tidligere arrangement</ds-tab>
      </ds-tablist>

      <ds-tabpanel id="panel-kommende">
        <h2 class="ds-sr-only">Kommende arrangement</h2>
        {kommende.length === 0 ? (
          featuredErKommende ? (
            <p class="kalender-empty">Det kommende arrangementet er vist øverst på siden.</p>
          ) : (
            <p class="kalender-empty">Ingen kommende arrangementer</p>
          )
        ) : (
          <div class="kalender-list">
            {kommende.map(h => (
              <EventCard {...hendelseTilEventCard(h)} />
            ))}
          </div>
        )}
      </ds-tabpanel>

      <ds-tabpanel id="panel-tidligere">
        <h2 class="ds-sr-only">Tidligere arrangement</h2>
        {tidligere.length === 0 ? (
          <p class="kalender-empty">{tidligereTomTekst(featured, now)}</p>
        ) : (
          <div class="kalender-list">
            {tidligere.map(h => (
              <EventCard {...hendelseTilEventCard(h)} />
            ))}
          </div>
        )}
      </ds-tabpanel>
    </ds-tabs>
  </section>
</Layout>

<style>
  .kalender-header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
    padding-block: var(--ds-size-8);
  }

  .kalender-ingress {
    margin: 0;
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-lg-line-height);
  }

  /* ── Featured event ─────────────────────────────── */
  .kalender-featured {
    background: var(--ds-color-base-active);
    color: var(--ds-color-base-contrast-default);
    padding-block: var(--ds-size-10);
    cursor: pointer;

    &:has(a:focus-visible) {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
      box-shadow: var(--dsc-focus-boxShadow);
    }

    &:hover {
      & a {
        text-decoration: underline;
      }
    }

    & a {
      color: inherit;
      text-decoration: none;

      &:focus-visible {
        outline: none;
      }
    }

    @media (min-width: 768px) {
      & :global(.event-card) {
        grid-template-columns: 180px 1fr;
      }
    }

    & :global(.event-card-body) {
      grid-template-columns: 1fr;
      align-items: start;
    }

    & :global(.event-card-info) {
      padding-inline-end: 0;
    }

    & :global(.event-card-details) {
      padding-inline-start: 0;
      border-top: none;
      padding-block-start: 0;
    }
  }

  .kalender-featured-inner {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
    padding-inline: var(--ds-size-22);

    @media (max-width: 1024px) {
      padding-inline: 0;
    }

    & h2 {
      word-break: break-word;
    }
  }

  .kalender-featured-ingress {
    margin: 0;
  }

  /* ── Arrangementer section ──────────────────────── */
  .kalender-arrangementer {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
    padding-block: var(--ds-size-10);
  }

  .kalender-tabs {
    --dsc-tabs-content-padding: var(--ds-size-6) 0;
  }

  .kalender-empty {
    margin: 0;
    color: var(--ds-color-text-default);
  }

  /* ── Event list ─────────────────────────────────── */
  .kalender-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }
</style>
