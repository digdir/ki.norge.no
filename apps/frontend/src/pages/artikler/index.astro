---
import Layout from '../../components/layout/Layout.astro';
import NewsCard from '../../components/shared/NewsCard.astro';
import { getArtikler, getPlainText, type Artikkel } from '../../lib/umbraco';

let articles: Artikkel[] = [];
try {
  const artiklerRes = await getArtikler();
  articles = artiklerRes.data;
} catch (e) {
  console.error('Failed to fetch artikler:', e);
}

const featured = articles[0];
const compactCards = articles.slice(1, 4);
const imageGridTop = articles.slice(4, 7);
const imageGridBottom = articles.slice(7, 9);
const bottomFeatured = articles[9];
const remaining = articles.slice(10);

function getImageUrl(article: Artikkel) {
  return article.artikkelBilde?.url || undefined;
}

function getTag(article: Artikkel) {
  if (article.bakgrunn === 'lyseblaa') return 'Offentlig sektor';
  return 'KI-strategien';
}
---

<Layout title="Aktuelt" description="Nyheter, analyser og artikler om kunstig intelligens i norsk offentlig sektor.">
  <section data-layout-block="content" class="artikler-page">
    <h1 class="artikler-title">Aktuelt</h1>

    {featured && (
      <NewsCard
        variant="featured"
        href={`/artikler/${featured.slug}`}
        title={featured.tittel}
        lead={featured.ingress || getPlainText(featured.innhold, 150)}
        image={getImageUrl(featured)}
        imageAlt={featured.bildeAlt}
      />
    )}

    {compactCards.length > 0 && (
      <div class="compact-grid">
        {compactCards.map(article => (
          <NewsCard
            variant="small"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            tag={getTag(article)}
            date={article.publishedAt}
          />
        ))}
      </div>
    )}

    {imageGridTop.length > 0 && (
      <div class="image-grid">
        {imageGridTop.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getImageUrl(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {imageGridBottom.length > 0 && (
      <div class="image-grid image-grid--2col">
        {imageGridBottom.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getImageUrl(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {bottomFeatured && (
      <NewsCard
        variant="featured"
        href={`/artikler/${bottomFeatured.slug}`}
        title={bottomFeatured.tittel}
        lead={bottomFeatured.ingress || getPlainText(bottomFeatured.innhold, 150)}
        image={getImageUrl(bottomFeatured)}
        imageAlt={bottomFeatured.bildeAlt}
      />
    )}

    {remaining.length > 0 && (
      <div class="image-grid">
        {remaining.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getImageUrl(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {articles.length === 0 && (
      <p class="empty-state">Ingen artikler funnet.</p>
    )}
  </section>
</Layout>

<style>
  .artikler-page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-10);
    padding-block: var(--ds-size-10) var(--ds-size-16);
  }

  .artikler-title {
    font-size: var(--ds-heading-lg-font-size);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .compact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-4);
    border-top: 1px solid var(--ds-color-neutral-border-subtle);
    padding-top: var(--ds-size-6);

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .image-grid--2col {
    @media (min-width: 1024px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--ds-size-12);
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
