# Local development. Prod and tt02 do NOT read this file, they get vars from
# wrangler.jsonc and secrets from `wrangler secret put --env <environment>`.

# Umbraco CMS. Points to the prod CMS by default, so you get real content without
# running the CMS locally. To use a local instance, run `pnpm run cms:dev` and
# set both to http://localhost:5000.
UMBRACO_URL=https://cms.ki.norge.no
UMBRACO_API_KEY=your-api-key-for-preview  # Must match Umbraco:CMS:DeliveryApi:ApiKey

# The host the browser fetches media from. Used as a plain prefix before /media/...,
# so it must have no path (not /umbraco either) and no trailing slash.
# Must point to the same place as UMBRACO_URL, otherwise the media IDs don't match and
# the images break. In prod it is deliberately the workers.dev proxy, see wrangler.jsonc.
UMBRACO_PUBLIC_URL=https://cms.ki.norge.no

# Preview of unpublished content. Must be identical to
# HeadlessPreview:PreviewSecret in the CMS, which adds the value to the
# preview links the backoffice creates. Against a local CMS it is the value in
# apps/cms-umbraco/appsettings.Development.json. Otherwise create a new one with
#   openssl rand -hex 32
# Empty, shorter than 32 characters or with characters other than A-Z, 0-9, - and _ means
# disabled, and everyone sees only published content.
#PREVIEW_SECRET=

# Cloudflare cache purge. scripts/purge-cache.mjs runs after every deploy, so
# the edge doesn't keep serving HTML that points to deleted _astro files.
# If they are missing, the deploy stops.
#   ZONE_ID:      Cloudflare dashboard -> norge.no -> Overview -> Zone ID
#   PURGE_TOKEN:  My Profile -> API Tokens -> Create Custom Token
#                 Permissions: Zone -> Cache Purge -> Purge
#                 Zone Resources: Include -> Specific zone -> norge.no
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PURGE_TOKEN=cfat_...

# Hybrid search (Elastic), server-side only, drives the search modal via /api/search.
# Optional locally: without ES_API_KEY the search falls back to Umbraco's simple search,
# which gives more and worse sorted hits than prod. Not used for indexing.
ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
KI_INDEX=ki-content

# "Del KI-tiltak" sends submissions to the editorial mailbox via Microsoft
# Graph. Tenant and client id are identifiers, not secrets, and live
# in wrangler.jsonc for tt02 and prod. Only GRAPH_CLIENT_SECRET is secret.
# Without these, /api/ki-tiltak responds 503 and the form shows "Vi klarte ikke å
# sende inn tiltaket", which is the correct behaviour locally.
# Note: the secret is the VALUE from Azure, not the Secret ID. Mixing up the two gives
# AADSTS7000215. It expires 20.02.2028.
GRAPH_TENANT_ID=008e560f-08af-4cec-a056-b35447503991
GRAPH_CLIENT_ID=ac5194d9-cdac-404b-9568-9006a149c395
GRAPH_CLIENT_SECRET=hemmeligheten-fra-drift
KI_TILTAK_MAILBOX=ki-tiltak@kin.norge.no

# Who the submission is sent to. The sender is locked to the mailbox above by
# the RBAC assignment, but the recipient is free. Leave the line out, and the mailbox
# sends to itself. Separate multiple recipients with commas.
#KI_TILTAK_RECIPIENTS=ki-tiltak@kin.norge.no

# Cloudflare Turnstile on "Del KI-tiltak". Create the widget in the Cloudflare
# dashboard under Turnstile, add the domains (the workers.dev host now,
# ki.norge.no when DNS is in place, and localhost for local testing).
# The site key is public and lives in wrangler.jsonc for tt02 and prod.
# Only TURNSTILE_SECRET_KEY is secret:
#   wrangler secret put TURNSTILE_SECRET_KEY --env prod
# If they are empty, submissions are rejected with 503. The exception is localhost, where
# they get through with a log line.
# Cloudflare's test keys respond with hostname example.com and are therefore rejected by
# the host check. Locally, empty keys are easiest.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
