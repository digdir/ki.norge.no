---
// Fyller plassen til et bilde som mangler, i samme form som bildet ville hatt.
// Logoen tegnes som bakgrunn med luft rundt, så den er hel uansett hvor smal
// boksen blir, i motsetning til et foto som beskjæres.
interface Props {
  form: readonly [number, number];
}

const { form } = Astro.props;
---

<div class="standardbilde" style={`aspect-ratio: ${form[0]} / ${form[1]}`}></div>

<style>
  /* Samme burgunder som og-image.svg. */
  .standardbilde {
    width: 100%;
    box-sizing: border-box;
    background-color: #541321;
    background-image: url('/ki-norge-logo-hvit.svg');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    background-origin: content-box;
    background-clip: border-box;

    /* Paddingen styrer størrelsen: logoen er 5:1 bred, så «contain» treffer alltid
       bredden, og innholdsboksens bredde blir logoens bredde. Sidepaddingen er 30 og
       ikke 20 prosent fordi Sara ville ha teksten mindre, det gir 40 mot 60 prosent
       av boksen, altså to tredeler av den opprinnelige størrelsen. */
    padding: 15% 30%;
  }
</style>
