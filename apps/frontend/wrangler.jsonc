{
	"compatibility_date": "2026-05-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"name": "ki-norge-frontend",
	"account_id": "4c4f444ed739a1c06fe2f2aa5195a8a8",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	"env": {
		"tt02": {
			"vars": {
				"UMBRACO_URL": "https://kinorgeportal.tt02.dis-core.altinn.cloud",
				"UMBRACO_PUBLIC_URL": "https://kinorgeportal.tt02.dis-core.altinn.cloud",
				// Holding page on ki.test.norge.no until launch. Flip to "live" to go public.
				"LAUNCH_MODE": "coming-soon",
			},
		},
		"prod": {
			"vars": {
				"UMBRACO_URL": "https://kinorgeportal.prod.dis-core.altinn.cloud",
				"UMBRACO_PUBLIC_URL": "https://kinorgeportal.prod.dis-core.altinn.cloud",
				// Holding page on ki.norge.no until launch. Flip to "live" to go public.
				"LAUNCH_MODE": "coming-soon",
			},
		},
	},
}