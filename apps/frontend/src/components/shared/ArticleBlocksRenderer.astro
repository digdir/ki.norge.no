---
/**
 * Renders the artikkel block list (UmbracoBlock[]) used by:
 *   - pages/artikler/[slug].astro
 *   - pages/eksempler/[slug].astro
 *   - pages/sandkasse/index.astro
 *
 * Single source of truth for how every artikkel module renders. CSS lives in
 * styles/article-blocks.css (also imported here, so any page using this
 * component picks up the styles for free).
 *
 * Caller is responsible for constraining width (e.g. via data-layout-article
 * or a wrapper with max-width).
 */
import type { UmbracoBlock } from '../../lib/umbraco';
import { getMediaUrl } from '../../lib/umbraco';
import '../../styles/article-blocks.css';

interface Props {
  blocks?: UmbracoBlock[];
  /**
   * Default date to render in the byline if the byline block has no date set.
   * Typically the article's publishedAt timestamp.
   */
  defaultDate?: string;
}

const { blocks, defaultDate } = Astro.props;

function formatDate(dateStr?: string): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('nb-NO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

/**
 * Walks the block list and groups consecutive `artikkelTrekkspill` blocks
 * into one wrapper. The wrapper becomes a single grid child, so the parent
 * page's `row-gap` only applies between the group and surrounding blocks
 * — not between accordions inside the group. CSS collapses the borders so
 * the group reads as one cohesive component.
 *
 * Group break rules:
 * - A non-trekkspill block always closes the current group.
 * - A trekkspill with `settings.gruppeTittel` set starts a new group with
 *   that title (closes any previous group). Editor uses this to split a
 *   long sequence of accordions into multiple titled sections.
 * - A trekkspill with no settings joins the current group (default).
 *
 * Net effect: editor flow for "titled FAQ" = open the first accordion,
 * Innstillinger tab, write "Ofte stilte spørsmål". To split into two
 * groups, set gruppeTittel on the accordion that should start the second
 * group. To force standalone accordions: drop a non-trekkspill block
 * between them.
 */
type GroupedItem =
  | { kind: 'block'; block: UmbracoBlock }
  | { kind: 'accordionGroup'; tittel: string; blocks: UmbracoBlock[] };

function groupConsecutiveTrekkspill(items?: UmbracoBlock[]): GroupedItem[] {
  if (!items) return [];
  const out: GroupedItem[] = [];
  for (const block of items) {
    if (block.contentType !== 'artikkelTrekkspill') {
      out.push({ kind: 'block', block });
      continue;
    }
    const tittel = ((block.settings?.gruppeTittel as string) || '').trim();
    const last = out[out.length - 1];
    // Start a new group when: previous wasn't a group OR this block declares its own title
    if (!last || last.kind !== 'accordionGroup' || tittel) {
      out.push({ kind: 'accordionGroup', tittel, blocks: [block] });
    } else {
      last.blocks.push(block);
    }
  }
  return out;
}

const renderItems = groupConsecutiveTrekkspill(blocks);
---

{renderItems.map((item) => {
  if (item.kind === 'accordionGroup') {
    return (
      <section class="article-accordion-group">
        {item.tittel && <h2 class="article-accordion-group-title">{item.tittel}</h2>}
        <div class="ds-card" data-variant="tinted">
          {item.blocks.map((block) => (
            <details class="ds-details">
              <summary>
                {block.content.tittel}
              </summary>
              <div set:html={block.content.innhold} />
            </details>
          ))}
        </div>
      </section>
    );
  }
  const block = item.block;
  // existing per-block branches below — falls through to the original switch
  return (() => {
  if (block.contentType === 'artikkelByline') {
    const c = block.content;
    const date = c.dato || defaultDate;
    const formatted = formatDate(date);
    const parts = [c.navn, c.stilling, c.virksomhet ? `i ${c.virksomhet}` : ''].filter(Boolean).join(' ');
    if (!parts && !formatted) return null;
    return (
      <div class="article-byline">
        {parts && <span class="article-byline-author">{parts}</span>}
        {parts && formatted && <span class="article-byline-sep">·</span>}
        {formatted && <time class="article-byline-date" datetime={date}>{formatted}</time>}
      </div>
    );
  }
  if (block.contentType === 'artikkelInnholdFra') {
    const c = block.content;
    if (!c.virksomhet && !c.dato) return null;
    const date = c.dato || defaultDate;
    const formatted = formatDate(date);
    return (
      <aside class="article-innhold-fra">
        {c.virksomhet && (
          <>
            <span class="article-innhold-fra-label">Innhold fra</span>
            <strong class="article-innhold-fra-org">{c.virksomhet}</strong>
          </>
        )}
        {formatted && (
          <span class="article-innhold-fra-date">Sist oppdatert {formatted}</span>
        )}
      </aside>
    );
  }
  if (block.contentType === 'artikkelKontaktkort') {
    const c = block.content;
    return (
      <aside class="article-kontaktkort" data-layout-block="edge">
        <div data-layout-block="content">
          {c.tittel && <h3 class="article-kontaktkort-title">{c.tittel}</h3>}
          <p class="article-kontaktkort-name">{c.navn}</p>
          {c.stilling && <p class="article-kontaktkort-row">{c.stilling}</p>}
          {c.virksomhet && <p class="article-kontaktkort-row">{c.virksomhet}</p>}
          {c.epost && <p class="article-kontaktkort-row"><a class="ds-link" href={`mailto:${c.epost}`}>{c.epost}</a></p>}
          {c.telefon && <p class="article-kontaktkort-row"><a class="ds-link" href={`tel:${c.telefon.replace(/\s/g, '')}`}>{c.telefon}</a></p>}
        </div>
      </aside>
    );
  }
  if (block.contentType === 'artikkelProsessteg') {
    const c = block.content;
    return (
      <section class="article-prosessteg">
        {c.tittel && <h2 class="article-prosessteg-title">{c.tittel}</h2>}
        <ol class="article-prosessteg-list">
          {c.steg.map((s, i) => (
            <li class="article-prosessteg-item">
              <div class="article-prosessteg-header">
                <span class="article-prosessteg-number">{i + 1}</span>
                {s.tittel && <span class="article-prosessteg-label">{s.tittel}</span>}
              </div>
              <div class="article-prosessteg-body" set:html={s.beskrivelse} />
            </li>
          ))}
        </ol>
      </section>
    );
  }
  if (block.contentType === 'artikkelFremheving') {
    const c = block.content;
    const classes = [
      'article-fremheving',
      c.visBakgrunn ? 'article-fremheving--bg' : '',
      c.visAnforselstegn ? 'article-fremheving--quote' : '',
      c.bilde?.url ? 'article-fremheving--with-image' : '',
    ].filter(Boolean).join(' ');
    return (
      <div class={classes}>
        {c.bilde?.url && (
          <div class="article-fremheving-image">
            <img src={getMediaUrl(c.bilde)} alt={c.bildeAlt || ''} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="article-fremheving-content">
          {c.tittel && <h3 class="article-fremheving-title">{c.tittel}</h3>}
          {c.visAnforselstegn ? (
            <blockquote class="article-fremheving-text article-fremheving-text--quote">
              <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--open">«</span>
              <div set:html={c.tekst} />
              <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--close">»</span>
            </blockquote>
          ) : (
            <div class="article-fremheving-text" set:html={c.tekst} />
          )}
          {c.kilde && (
            <footer class="article-fremheving-source">
              <cite>{c.kilde}</cite>
            </footer>
          )}
        </div>
      </div>
    );
  }
  if (block.contentType === 'artikkelInfoBoks') {
    return (
      <div class="article-info-box">
        {block.content.tittel && <h3 class="info-box-title">{block.content.tittel}</h3>}
        <div class="info-box-body" set:html={block.content.innhold} />
      </div>
    );
  }
  if (block.contentType === 'artikkelHero') {
    return (
      <div class="article-info-box">
        {block.content.tittel && <h3 class="info-box-title">{block.content.tittel}</h3>}
        {block.content.tekst && <div class="info-box-body" set:html={block.content.tekst} />}
      </div>
    );
  }
  // artikkelTrekkspill is handled above by the accordion-group wrapper —
  // the per-block branch never fires now. Keeping for safety (defensive
  // fallback if a non-grouped trekkspill ever shows up).
  if (block.contentType === 'artikkelSitat') {
    return (
      <blockquote class="article-quote">
        <p class="article-quote-text">{block.content.sitat}</p>
        {block.content.kilde && (
          <footer class="article-quote-source">
            <cite>{block.content.kilde}</cite>
          </footer>
        )}
      </blockquote>
    );
  }
  if (block.contentType === 'artikkelCallout') {
    const variant = block.content.variant || 'info';
    return (
      <div class={`article-callout article-callout--${variant}`} role={variant === 'advarsel' ? 'alert' : 'note'}>
        {block.content.tittel && <p class="article-callout-title">{block.content.tittel}</p>}
        <div class="article-callout-body" set:html={block.content.innhold} />
      </div>
    );
  }
  if (block.contentType === 'artikkelBildeSeksjon') {
    return (
      <figure class="article-image-section">
        {block.content.bilde?.url ? (
          <img src={getMediaUrl(block.content.bilde)} alt={block.content.bildeAlt || ''} class="stub-img" loading="lazy" decoding="async" />
        ) : (
          <div class="article-image-placeholder"></div>
        )}
        {block.content.bildetekst && <figcaption>{block.content.bildetekst}</figcaption>}
      </figure>
    );
  }
  return (
    <div class="article-text-block" set:html={block.content.innhold} />
  );
  })();
})}
