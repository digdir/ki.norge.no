---
import AkselIcon from './AkselIcon.astro';
import Bilde from './Bilde.astro';
import type { UmbracoMedia } from '../../lib/umbraco';

interface Props {
  title: string;
  href: string;
  // Illustrasjonen vises i sin egen form og kuttes ikke.
  image?: UmbracoMedia;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  label?: string;
}

const { title, href, image, imageAlt = '', imagePosition = 'right', label } = Astro.props;

// Pilen limes til siste ord så den ikke brekker alene (#464)
---

<div class="text-with-image" data-image-position={imagePosition}>
  <div class="text">
    {label && <p class="ds-paragraph" data-size="xl">{label}</p>}
    <slot />
    <h2 class="ds-heading" data-size="lg">
      <a href={href} class="ds-focus">{title}<span class="text-with-image-arrow" aria-hidden="true"><AkselIcon name="ArrowRight" size={20} /></span></a>
    </h2>
    <div class="body ds-paragraph" data-size="lg">
      <slot name="body" />
    </div>
  </div>
  {image?.url && (
    <div class="illustration">
      <Bilde media={image} sizes="(max-width: 767px) 60vw, 500px" alt={imageAlt} />
    </div>
  )}
</div>

<style is:global>
  .text-with-image {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-12);

    @media (min-width: 768px) {
      /* Smalere tekstkolonne gir illustrasjonen mer plass (#585). */
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--ds-size-22);
    }

    &[data-image-position='left'] {
      @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;

        & .illustration {
          order: -1;
        }
      }
    }

    & .text {
      display: flex;
      flex-direction: column;
      gap: var(--ds-size-3);

      & .ds-paragraph {
        margin-block-end: var(--ds-size-4)
      }


      & h2 {
        & a {
          color: inherit;
          text-decoration: underline;
          text-underline-offset: 4px;
          text-decoration-thickness: 2px;

          & .text-with-image-arrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--ds-color-accent-surface-tinted);
            color: var(--ds-color-accent-text-default);
            margin-left: var(--ds-size-2);
            vertical-align: middle;
          }
        }
      }


      & .body {
        color: inherit;

        & ol, & ul {
            font-size: 1.5rem;
        }

        & li {
          line-height: 1.5;
        }

        & li p,
        & p {
          margin: 0;
          color: inherit;
        }

        & p + p {
          margin-top: var(--ds-size-4);
        }
      }
    }

    & .illustration {
      display: flex;
      align-items: center;
      justify-content: center;

      & img {
        max-width: 100%;

        @media (max-width: 768px) {
          max-width: 60%;
        }
      }

    }
  }
</style>
