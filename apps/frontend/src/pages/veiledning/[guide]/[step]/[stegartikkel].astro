---
import Layout from '../../../../components/layout/Layout.astro';
import ArticleBlocksRenderer from '../../../../components/shared/ArticleBlocksRenderer.astro';
import {
  getVeiledningGuide,
  getVeiledningSteg,
  getStegartikkel,
  getPlainText,
  getMediaUrl,
  MEDIA_WIDTH,
} from '../../../../lib/umbraco';
import { articleSchema, breadcrumbSchema } from '../../../../lib/seo';

const { guide: guideSlug, step: stepSlug, stegartikkel: stegartikkelSlug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

const guideData = await getVeiledningGuide(guideSlug!, { preview: isPreview });
if (!guideData) return Astro.redirect('/veiledning');

const allSteps = await getVeiledningSteg(guideSlug!, { preview: isPreview });
const currentStep = allSteps.find(s => s.slug === stepSlug);
if (!currentStep) return Astro.redirect(`/veiledning/${guideSlug}`);

const article = await getStegartikkel(stegartikkelSlug!, { preview: isPreview });
if (!article) return Astro.redirect(`/veiledning/${guideSlug}/${stepSlug}`);

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const heroImage = article.artikkelBilde || article.seoBilde;
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;
const heroImageUrl = heroImage?.url ? getMediaUrl(heroImage, MEDIA_WIDTH.hero) : undefined;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: `${guideSlug}/${stepSlug}/${stegartikkelSlug}`,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Veiledning', url: '/veiledning' },
  { name: guideData.tittel, url: `/veiledning/${guideSlug}` },
  { name: currentStep.tittel, url: `/veiledning/${guideSlug}/${stepSlug}` },
  { name: article.tittel, url: `/veiledning/${guideSlug}/${stepSlug}/${stegartikkelSlug}` },
]);
---
<Layout
  title={seoTitle}
  description={seoDesc}
  ogType="article"
  publishedAt={article.publishedAt}
  ogImage={seoImage}
  bodyColor="brand1"
>
  <div class="article-hero" data-layout-block="content">
    <ds-breadcrumbs class="ds-breadcrumbs" aria-label="Brødsmulesti">
      <a class="step-back ds-link" href={`/veiledning/${guideSlug}/${stepSlug}`} aria-label={`Tilbake til ${currentStep.tittel}`}>
        {currentStep.tittel}
      </a>
    </ds-breadcrumbs>
    <h1 class="article-title ds-heading" data-size="xl">{article.tittel}</h1>
    {article.ingress && <p class="article-ingress ds-heading" data-size="md">{article.ingress}</p>}
  </div>
  <div class="article-page u-rich-text" data-layout-block="content">
    {heroImageUrl && (
      <div class="article-hero-image">
        <img src={heroImageUrl} alt={article.bildeAlt || ''} class="article-hero-img" loading="eager" decoding="async" />
      </div>
    )}

    <ArticleBlocksRenderer blocks={article.innhold} defaultDate={article.publishedAt} />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
</Layout>

<style>
  .ds-breadcrumbs {
    --dsc-breadcrumbs-icon-url: url(data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2214%22%20height%3D%2215%22%20viewBox%3D%220%200%2014%2015%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M13.707%208.071a1%201%200%200%200%200-1.414L7.343.293A1%201%200%200%200%205.93%201.707l5.657%205.657-5.657%205.657a1%201%200%201%200%201.414%201.414zM0%207.364v1h13v-2H0z%22%20fill%3D%22%2386567a%22%2F%3E%3C%2Fsvg%3E);
    --dsc-breadcrumbs-icon-size: var(--ds-size-3);
    margin-block-end: var(--ds-size-6);
  }

  .step-back {
    color: var(--ds-color-text-default);
    text-decoration: none;
  }

  .step-back:hover {
    text-decoration: underline;
  }

  .article-hero {
    max-width: 1000px;
    margin-inline: auto;
    margin-block-end: var(--ds-size-12);

    & h1 {
      margin-block-end: var(--ds-size-6);
    }
  }

  .article-title {
    margin: 0;
  }

  .article-ingress {
    font-weight: 400;
    font-family: var(--ki-heading-font);
  }

  .article-page {
    max-width: 680px;
    margin-inline: auto;
  }

  .article-hero-image {
    margin-block-end: var(--ds-size-8);
  }

  .article-hero-img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
  }
</style>
