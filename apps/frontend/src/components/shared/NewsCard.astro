---
import AkselIcon from './AkselIcon.astro';

interface Props {
  href: string;
  title: string;
  tag?: string;
  tagColor?: 'brand1' | 'brand2' | 'brand3' | 'neutral';
  date?: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
  variant?: 'small' | 'image' | 'featured';
}

const {
  href,
  title,
  tag,
  date,
  lead,
  image,
  imageAlt = '',
  variant = 'small',
} = Astro.props;

const id = `news-card-${crypto.randomUUID().slice(0, 8)}`;

const formattedDate = date
  ? variant === 'small'
    ? new Date(date).toLocaleDateString('nb-NO', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' })
    : new Date(date).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long' })
  : undefined;
---

<article class:list={['news-card', `news-card--${variant}`]} data-clickdelegatefor={id}>
  {variant === 'featured' && (
    <div class="news-card-image">
      <img
        src={image ?? '/article_placeholder.png'}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {variant === 'image' && (
    <div class="news-card-image">
      <img
        src={image ?? '/article_placeholder.png'}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="news-card-body">
    {tag && <span class="ds-tag" data-variant="outline">{tag.toUpperCase()}</span>}
    <h3 class="ds-heading news-card-title" data-size={variant === 'featured' ? 'lg' : 'sm'}>
      <a id={id} href={href}>
        {title}
        {variant === 'featured' && (
          <span class="news-card-title-arrow" aria-hidden="true">
            <AkselIcon name="ArrowRight" size={24} />
          </span>
        )}
      </a>
    </h3>
    {variant === 'featured' && lead && <p class="news-card-lead">{lead}</p>}
    {formattedDate && (
      <span class="news-card-meta">
        {formattedDate}
      </span>
    )}
  </div>
</article>

<style>
  .news-card {
    color: var(--ds-color-text-default);
    cursor: pointer;
    display: flex;
    flex-direction: column;

    & a {
      text-decoration: none;
      color: inherit;

      &.\:click-delegate-hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: none;
        box-shadow: none;
      }
    }

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }

    .news-card-body .ds-tag {
      --dsc-tag-background: var(--ds-color-surface-tinted);
      --dsc-tag-color: var(--ds-color-text-subtle);
    }
  }

  /* ── Small variant (no image) ─────────────────────── */
  .news-card--small {
    padding: var(--ds-size-6);
    gap: var(--ds-size-3);
  }

  .news-card--small .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    flex: 1;
  }

  .news-card--small .news-card-title {
    margin: 0;
  }

  /* ── Image variant ────────────────────────────────── */
  .news-card--image {
    gap: 0;
    background: none;
    height: 100%;
  }

  .news-card--image .news-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--image-fallback-bg, #d9d9d9);
  }

  .news-card--image .news-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card--image .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    padding-top: var(--ds-size-4);
  }

  .news-card--image .news-card-title {
    margin: 0;
  }

  /* ── Featured variant (large, optional image) ──────── */
  .news-card--featured {
    position: relative;
    flex-direction: row;
    gap: var(--ds-size-8);

    @media (max-width: 767px) {
      flex-direction: column;
    }
  }

  .news-card--featured .news-card-image {
    flex: 0 0 45%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .news-card--featured .news-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card--featured .news-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    flex: 1;
    justify-content: center;
    padding-block: var(--ds-size-8);
  }

  .news-card--featured .news-card-title {
    margin: 0;
    text-wrap: balance;
  }

  .news-card--featured .news-card-title a {
    color: var(--ds-color-text-default);
  }

  .news-card--featured .news-card-title-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2em;
    height: 1.2em;
    margin-left: 0.25em;
    border-radius: 50%;
    background-color: var(--ds-color-surface-active);
    color: var(--ds-color-brand1-text-default);
    vertical-align: middle;
    flex-shrink: 0;
  }

  .news-card--featured .news-card-lead {
    font-size: var(--ds-font-size-3);
    color: var(--ds-color-text-subtle);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Shared elements ──────────────────────────────── */
  .news-card-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-size: var(--ds-font-size-3);
    font-weight: 500;
    color: var(--ds-color-text-default);
  }
</style>
