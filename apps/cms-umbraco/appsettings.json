{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "da0350ed-abc3-4b1a-adfb-147dd1286c77",
        "SanitizeHostName": true,
        "MainDomUri": "https://ki.norge.no"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "AllowedUploadedFileExtensions": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "svg",
          "pdf",
          "mp4",
          "webm"
        ],
        "DisallowedUploadedFileExtensions": [
          "exe",
          "dll",
          "bat",
          "sh",
          "ps1",
          "cmd",
          "vbs",
          "js",
          "html",
          "htm",
          "xml",
          "asp",
          "aspx",
          "php",
          "jar"
        ]
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "RichTextOutputAsJson": true
      },
      "Hosting": {
        "Debug": false
      },
      "Runtime": {
        "MaxRequestLength": 102400
      },
      "Security": {
        "UserPasswordConfiguration": {
          "RequiredLength": 10,
          "RequiredUniqueChars": 2,
          "RequireNonLetterOrDigit": true,
          "RequireDigit": false,
          "RequireLowercase": true,
          "RequireUppercase": true
        }
      }
    }
  },
  "Elasticsearch": {
    "Endpoint": "",
    "IndexName": "ki-content"
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}