---
import Layout from '../../components/layout/Layout.astro';
import { getCaser, getCaserOversikt, getMediaUrl, type Case } from '../../lib/umbraco';

let cases: Case[] = [];
let oversikt = null;
try {
  const [oversiktData, casesRes] = await Promise.all([
    getCaserOversikt(),
    getCaser(),
  ]);
  oversikt = oversiktData;
  cases = casesRes.data;
} catch (e) {
  console.error('Failed to fetch caser:', e);
}

const heroTittel = oversikt?.heroTittel || 'Caser';
const heroIngress = oversikt?.heroIngress || 'Lær av andre offentlige virksomheters erfaringer med kunstig intelligens.';
const seoTitle = oversikt?.seoTittel || heroTittel;
const seoDesc = oversikt?.seoBeskrivelse || heroIngress;
---

<Layout title={seoTitle} description={seoDesc}>
  <div class="caser-page grid" data-layout-block="content">
    <div class="caser-title-bar col-center-6">
      <h1 class="caser-title">{heroTittel}</h1>
      <p class="caser-lead">{heroIngress}</p>
    </div>

    <div class="caser-grid col-center-10">
      {cases.map(c => (
        <a href={`/caser/${c.slug}`} class="case-card">
          <div class="case-card-image">
            {c.artikkelBilde ? (
              <img src={getMediaUrl(c.artikkelBilde)} alt={c.bildeAlt || ''} loading="lazy" />
            ) : (
              <div class="case-card-placeholder"></div>
            )}
          </div>
          <div class="case-card-text">
            <h2 class="case-card-title">{c.tittel}</h2>
            {c.ingress && <p class="case-card-lead">{c.ingress}</p>}
          </div>
        </a>
      ))}
    </div>

    {cases.length === 0 && (
      <p class="empty-state col-center-6">Ingen caser funnet.</p>
    )}
  </div>
</Layout>

<style>
  .caser-title {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .caser-lead {
    font-size: 21px;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    margin: 0;
  }
  .caser-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .caser-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }
  @media (min-width: 1024px) {
    .caser-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }
  .case-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }
  .case-card-image {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: var(--image-fallback-bg, #D9D9D9);
  }
  .case-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .case-card-placeholder {
    width: 100%;
    height: 100%;
  }
  .case-card-title {
    font-size: 21px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .case-card-lead {
    font-size: 16px;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
    line-height: 1.5;
  }
  .empty-state {
    color: rgba(0, 0, 0, 0.55);
    text-align: center;
  }
</style>
