---
import Layout from '../../components/layout/Layout.astro';
import ArticleCardFeatured from '../../components/shared/ArticleCardFeatured.astro';
import ExampleLinkCards from '../../components/shared/ExampleLinkCards.astro';
import ExampleCard from '../../components/shared/ExampleCard.astro';
import ArticleCardCompact from '../../components/shared/ArticleCardCompact.astro';
import { getEksempler, getEksemplerOversikt, getArtikler, getVeiledningGuider, getMediaUrl, MEDIA_WIDTH, type Eksempel, type Artikkel, type VeiledningGuide, type EksemplerSeksjon } from '../../lib/umbraco';

const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

let eksempler: Eksempel[] = [];
let oversikt = null;
let artikler: Artikkel[] = [];
let guider: VeiledningGuide[] = [];
try {
  const [oversiktData, eksemplerRes, artiklerRes, guiderRes] = await Promise.all([
    getEksemplerOversikt({ preview: isPreview }),
    getEksempler({ preview: isPreview }),
    getArtikler(undefined, { preview: isPreview }),
    getVeiledningGuider({ preview: isPreview }),
  ]);
  oversikt = oversiktData;
  eksempler = eksemplerRes.data;
  artikler = artiklerRes.data;
  guider = guiderRes.data;
} catch (e) {
  console.error('Failed to fetch eksempler:', e);
}

const heroTittel = oversikt?.heroTittel || 'Eksempler';
const seoTitle = oversikt?.seoTittel || heroTittel;
const seoDesc = oversikt?.seoBeskrivelse || 'Lær av andre offentlige virksomheters erfaringer med kunstig intelligens.';

const eksempelById = new Map(eksempler.map(e => [e.id, e]));
const relatertById = new Map<string, Artikkel | VeiledningGuide>();
artikler.forEach(a => relatertById.set(a.id, a));
guider.forEach(g => relatertById.set(g.id, g));

// Hard-coded seksjoner som matcher Figma-designet. Refererer til eksempler og artikler
// fra mock-fixturen via ID. Brukes når CMS ikke leverer seksjoner.
const eksempelIder = eksempler.map(e => e.id);
const artikkelIder = artikler.map(a => a.id);

const fallbackSeksjoner: EksemplerSeksjon[] = [
  // 1) Featured eksempel
  { contentType: 'eksempelFeatured', id: 'fallback-featured', eksempelId: eksempelIder[0], ingress: 'Denne artikkelen gir en oversikt over den norske situasjonen, basert på tidligere utredninger og utviklingstrekk i den nasjonale KI-infrastrukturen.' },
  // 2) 2x2 grid (4 kort)
  { contentType: 'eksempelGruppe', id: 'fallback-gruppe-1', eksempelIds: eksempelIder.slice(0, 4), kortFarger: ['dark', 'light', 'light', 'dark'] },
  // 3) 3-kolonne grid (3 kort)
  { contentType: 'eksempelGruppe', id: 'fallback-gruppe-2', antallKolonner: 3, eksempelIds: eksempelIder.slice(0, 3), kortFarger: ['dark', 'light', 'dark'] },
  // 4) Enda en featured
  { contentType: 'eksempelFeatured', id: 'fallback-featured-2', eksempelId: eksempelIder[1] || eksempelIder[0], ingress: 'Denne artikkelen gir en oversikt over den norske situasjonen, basert på tidligere utredninger og utviklingstrekk i den nasjonale KI-infrastrukturen.' },
  // 5) 2 kort
  { contentType: 'eksempelGruppe', id: 'fallback-gruppe-3', eksempelIds: eksempelIder.slice(0, 2), kortFarger: ['dark', 'light'] },
  // 6) Relatert innhold (3 artikler)
  { contentType: 'eksempelRelatert', id: 'fallback-relatert', relatertIds: artikkelIder.slice(0, 3), relatertTags: ['Digitaliseringsstrategien', 'Offentlig sektor', 'Arbeidsmarkedet'] },
  // 7) Kontakt-seksjon
  { contentType: 'eksempelKontakt', id: 'fallback-kontakt', tittel: 'Ønsker du å dele et eksempel?', navn: 'Navn Navnesen', epost: 'navn@digdir.no', stilling: 'Rådgiver i Digitaliseringsdirektoratet' },
];

const seksjoner = oversikt?.seksjoner?.length ? oversikt.seksjoner : fallbackSeksjoner;
---

<Layout title={seoTitle} description={seoDesc} ogImage={oversikt?.seoBilde?.url}>
  <div class="eksempler-page">
    <header class="eksempler-header" data-layout-block="content">
      <h1 class="ds-heading eksempler-title" data-size="xl">{heroTittel}</h1>
    </header>

    {seksjoner.length === 0 && eksempler.length > 0 && (
      <section data-layout-block="edge" class="eksempler-section">
        <div class="eksempler-fallback-grid" data-layout-block="content">
          {eksempler.map((e, i) => (
            <ExampleCard href={`/eksempler/${e.slug}`} title={e.tittel} variant={(['dark', 'medium', 'light'] as const)[i % 3]} />
          ))}
        </div>
      </section>
    )}

    {seksjoner.map(s => {
      if (s.contentType === 'eksempelFeatured' && s.eksempelId) {
        const e = eksempelById.get(s.eksempelId);
        if (!e) return null;
        return (
          <section data-layout-block="edge" class="eksempler-section">
            <div data-layout-block="content">
              <ArticleCardFeatured
                href={`/eksempler/${e.slug}`}
                title={e.tittel}
                lead={s.ingress || e.ingress}
                image={e.artikkelBilde ? getMediaUrl(e.artikkelBilde, MEDIA_WIDTH.card) : '/article_placeholder.png'}
                imageAlt={e.bildeAlt || ''}
              />
            </div>
          </section>
        );
      }

      if (s.contentType === 'eksempelGruppe') {
        const items = (s.eksempelIds || []).map(id => eksempelById.get(id)).filter((e): e is Eksempel => !!e);
        if (items.length === 0) return null;
        return (
          <section data-layout-block="edge" class="eksempler-section">
            <div data-layout-block="content">
              {s.tittel && <h2 class="ds-heading section-heading" data-size="lg">{s.tittel}</h2>}
              <ExampleLinkCards cards={items.map((e, i) => ({
                href: `/eksempler/${e.slug}`,
                title: e.tittel,
                tag: s.kortTag || 'Eksempel',
                variant: s.kortFarger?.[i],
              }))} />
            </div>
          </section>
        );
      }

      if (s.contentType === 'eksempelRelatert') {
        const items = (s.relatertIds || []).map(id => relatertById.get(id)).filter((x): x is Artikkel | VeiledningGuide => !!x);
        if (items.length === 0) return null;
        return (
          <section data-layout-block="edge" class="eksempler-section eksempler-relatert">
            <div data-layout-block="content">
              {s.tittel && <h2 class="ds-heading section-heading" data-size="lg">{s.tittel}</h2>}
              <div class="eksempler-relatert-grid">
                {items.map((item, i) => {
                  const href = artikler.some(a => a.id === item.id) ? `/artikler/${item.slug}` : `/veiledning/${item.slug}`;
                  return <ArticleCardCompact href={href} title={item.tittel} date={item.publishedAt} tag={s.relatertTags?.[i]} tagColor="accent" />;
                })}
              </div>
            </div>
          </section>
        );
      }

      if (s.contentType === 'eksempelKontakt') {
        if (!s.tittel && !s.navn && !s.epost && !s.stilling) return null;
        return (
          <section data-layout-block="edge" class="eksempler-kontakt">
            <div data-layout-block="content">
              {s.tittel && <h2 class="eksempler-kontakt-tittel ds-heading">{s.tittel}</h2>}
              <div class="eksempler-kontakt-info" data-size="lg">
                {s.navn && <p class="ds-paragraph">{s.navn}</p>}
                {s.epost && <a href={`mailto:${s.epost}`} class="ds-link">{s.epost}</a>}
                {s.stilling && <p class="ds-paragraph">{s.stilling}</p>}
              </div>
            </div>
          </section>
        );
      }

      return null;
    })}

    {seksjoner.length === 0 && eksempler.length === 0 && (
      <p class="empty-state">Ingen eksempler funnet.</p>
    )}
  </div>
</Layout>

<style>
  .eksempler-page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-16);
    padding-block: var(--ds-size-10) var(--ds-size-22);
  }

  .eksempler-section:has(.example-link-cards) + .eksempler-section:has(.example-link-cards) {
    margin-top: var(--ds-size-0);
    padding-top: var(--ds-size-0);
  }

  .eksempler-header {
    display: flex;
    width: 100%;

    & .eksempler-title {
      width: 100%;
      margin: 0;
      margin-inline-end: auto;
    }
  }

  .eksempler-lead {
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-lg-line-height);
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
    max-width: 60ch;
  }

  .section-heading {
    margin: 0 0 var(--ds-size-8);
  }

  /* Relatert: themed links with a colored top rule (alternating accent shades) */
  .eksempler-relatert-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    rule: 1px solid var(--ds-color-surface-active);
  }
  @media (min-width: 768px) {
    .eksempler-relatert-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .eksempler-relatert-grid > :global(.compact-card) {
    border-radius: 0;
    padding-top: var(--ds-size-4);
  }

  /* Kontakt: full-width burgundy band */
  .eksempler-kontakt {
    background: var(--ds-color-base-active);
    color: var(--ds-color-base-contrast-default);
    padding: var(--ds-size-12);
  }

  .eksempler-kontakt-tittel {
    font-weight: 400;
    font-family: var(--ds-font-family);
  }

  .eksempler-kontakt-info {
    margin: 0;
  }

  .eksempler-kontakt {
    background: var(--ds-color-base-active);
    color: var(--ds-color-background-default);
    padding-block: var(--ds-size-12);
  }
  .eksempler-kontakt a {
    --dsc-link-color: var(--ds-color-base-contrast-default);
    --dsc-link-color--hover: var(--ds-color-base-contrast-subtle);
    --dsc-link-color--active: var(--ds-color-base-contrast-default);
  }
  .eksempler-kontakt h2 {
    margin-block-end: var(--ds-size-5);
  }

  .eksempler-kontakt p {
    line-height: 1.7;
    margin: 0;
  }

  .eksempler-fallback-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .eksempler-fallback-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    color: var(--ds-color-neutral-text-subtle);
    text-align: center;
  }
</style>
