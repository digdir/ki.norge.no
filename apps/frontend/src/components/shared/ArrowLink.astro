---
import AkselIcon from './AkselIcon.astro';

interface Props {
  href: string;
  text: string;
  variant?: 'default' | 'light';
}

const { href, text } = Astro.props;
---

<a href={href} class="arrow-link ds-focus" data-variant={Astro.props.variant || 'default'}>
    {text}
    <span class="arrow-link-circle" aria-hidden="true">
      <AkselIcon name="ArrowRight" size={24} />
    </span>
</a>

<style>
  .arrow-link {
    --ki-background: var(--ds-color-surface-active);

    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-3);
    font-size: var(--ds-body-lg-font-size);
    font-weight: 500;
    color: var(--ds-color-neutral-text-default);
    text-decoration: none;

    &[data-variant="light"] {
      --ki-background: var(--ds-color-neutral-background-default);
    }

    &:hover {
      text-decoration: underline;
    }

    & .arrow-link-circle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--ds-size-10);
      aspect-ratio: 1 / 1;
      border-radius: 50%;
      background-color: var(--ki-background);
      font-size: 2rem;
      flex-shrink: 0;
      line-height: 1;
    }
  }

</style>
