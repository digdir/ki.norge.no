---
import Layout from '../../components/layout/Layout.astro';
import NewsCard from '../../components/shared/NewsCard.astro';
import { getArtikler, getPlainText, type Artikkel } from '../../lib/umbraco';

let articles: Artikkel[] = [];
try {
  const artiklerRes = await getArtikler();
  articles = artiklerRes.data;
} catch (e) {
  console.error('Failed to fetch artikler:', e);
}
---

<Layout title="Aktuelt" description="Nyheter, analyser og artikler om kunstig intelligens i norsk offentlig sektor.">
  <div class="artikler-page">
    <div class="artikler-header">
      <h1 class="artikler-title">Aktuelt</h1>
      <p class="artikler-lead">Hold deg oppdatert på nyheter, analyser og artikler om kunstig intelligens i norsk offentlig sektor.</p>
    </div>

    <div class="artikler-content">
      {articles.length > 0 ? (
        <div class="artikler-grid">
          {articles.map(article => (
            <NewsCard
              href={`/artikler/${article.slug}`}
              title={article.tittel}
              date={article.publishedAt}
              lead={getPlainText(article.innhold, 100)}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">Ingen artikler funnet.</p>
      )}
    </div>
  </div>
</Layout>

<style>
  .artikler-page {
    padding-top: var(--ds-size-4);
  }

  .artikler-header {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px 24px 48px;
  }

  .artikler-title {
    font-size: 40px;
    font-weight: 700;
    color: #000;
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .artikler-lead {
    font-size: 18px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
    line-height: 1.5;
    max-width: 600px;
  }

  .artikler-content {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 120px;
  }

  .artikler-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .artikler-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .artikler-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--ds-size-12);
    color: rgba(0, 0, 0, 0.62);
  }
</style>
