---
import Layout from '../components/layout/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import AkselIcon from '../components/shared/AkselIcon.astro';
import NewsCard from '../components/shared/NewsCard.astro';
import ArrowLink from '../components/shared/ArrowLink.astro';
import { websiteSchema } from '../lib/seo';
import { getForside, getArtikler, getPlainText } from '../lib/umbraco';

let forside = null;
let latestArticles: any[] = [];
try {
  forside = await getForside();
  const artiklerRes = await getArtikler(3);
  latestArticles = artiklerRes.data;
} catch (e) {
  console.error('Failed to fetch frontpage CMS data:', e);
}

const title = forside?.seoTittel || 'Hjem';
const seoDescription = forside?.seoBeskrivelse || 'KI Norge - Norges nasjonale strategi for kunstig intelligens. Veiledning, regulatorisk sandkasse og gode eksempler for offentlig sektor.';
const websiteJsonLd = websiteSchema(seoDescription);

// CMS fields with fallbacks
const v = {
  overskrift: forside?.veiledningOverskrift || 'Veiledning',
  kort1Tittel: forside?.veiledning1Tittel || 'Vi skal ta i bruk KI',
  kort1Beskrivelse: forside?.veiledning1Beskrivelse || 'For deg som vil ta i bruk ferdig trent KI →',
  kort1Url: forside?.veiledning1Url || '/veiledning',
  kort2Tittel: forside?.veiledning2Tittel || 'Vi skal lage et KI-system',
  kort2Beskrivelse: forside?.veiledning2Beskrivelse || 'For deg som ønsker å bygge en KI-løsning selv →',
  kort2Url: forside?.veiledning2Url || '/veiledning',
};
const a = {
  overskrift: forside?.aktueltOverskrift || 'Aktuelt',
  lenkeTekst: forside?.aktueltLenkeTekst || 'Finn inspirasjon og lær av andre',
  lenkeUrl: forside?.aktueltLenkeUrl || '/caser',
};

const sectionOrder = {
  veiledning: forside?.rekkefolgeVeiledning ?? 1,
  aktuelt: forside?.rekkefolgeAktuelt ?? 2,
  treraad: forside?.rekkefolgeTreRaad ?? 3,
  sandkasse: forside?.rekkefolgeSandkasse ?? 4,
};
---

<Layout title={title} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd).replace(/</g, '\\u003c')} />
  <Hero />

  <div class="sections-container grid">
  <!-- Veiledning -->
  <section class="veiledning col-center-10" style={`order: ${sectionOrder.veiledning}`}>
      <h2 class="section-heading">{v.overskrift}</h2>
      <div class="veiledning-grid">
        <a href={v.kort1Url} class="veiledning-card">
          <span class="veiledning-card-top">
            <AkselIcon name="HandHeart" size={24} />
            <span class="veiledning-card-title">{v.kort1Tittel}</span>
          </span>
          <div class="veiledning-card-illustration"></div>
          <span class="veiledning-card-desc">{v.kort1Beskrivelse}</span>
        </a>
        <a href={v.kort2Url} class="veiledning-card">
          <span class="veiledning-card-top">
            <AkselIcon name="Package" size={24} />
            <span class="veiledning-card-title">{v.kort2Tittel}</span>
          </span>
          <div class="veiledning-card-illustration"></div>
          <span class="veiledning-card-desc">{v.kort2Beskrivelse}</span>
        </a>
      </div>
  </section>

  <!-- Aktuelt -->
  <section class="aktuelt col-center-10" style={`order: ${sectionOrder.aktuelt}`}>
      <h2 class="section-heading">{a.overskrift}</h2>
      <div class="aktuelt-grid grid-subrows" data-color="neutral">
        {latestArticles.map(article => (
          <NewsCard
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            tag="Artikkel"
          />
        ))}
      </div>
      <ArrowLink href={a.lenkeUrl} text={a.lenkeTekst} />
  </section>

  <!-- Tre råd -->
  <section class="tre-raad col-all" style={`order: ${sectionOrder.treraad}`}>
    <div class="tre-raad-inner">
      <h2 class="tre-raad-heading">Tre råd før du går i gang med KI</h2>
      <div class="tre-raad-grid">
        <div class="tre-raad-card">
          <div class="tre-raad-illustration"></div>
          <h3 class="tre-raad-card-title">Start med problemet</h3>
          <p class="tre-raad-card-desc">Definer klart hva du ønsker å oppnå før du velger teknologi. Gode KI-prosjekter starter med et tydelig behov.</p>
        </div>
        <div class="tre-raad-card">
          <div class="tre-raad-illustration"></div>
          <h3 class="tre-raad-card-title">Forstå dataene dine</h3>
          <p class="tre-raad-card-desc">Kartlegg hvilke data du har tilgang til, kvaliteten på dem, og om de er egnet for formålet.</p>
        </div>
        <div class="tre-raad-card">
          <div class="tre-raad-illustration"></div>
          <h3 class="tre-raad-card-title">Sjekk rammer og ansvar</h3>
          <p class="tre-raad-card-desc">Forstå regelverket som gjelder for ditt bruksområde. Sørg for at løsningen ivaretar personvern og etikk.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sandkasse -->
  <section class="sandkasse col-center-10" style={`order: ${sectionOrder.sandkasse}`}>
      <a href="/sandkasse" class="sandkasse-card">
        <h2 class="sandkasse-title">Regulatorisk sandkasse for kunstig intelligens</h2>
        <div class="sandkasse-bottom">
          <p class="sandkasse-desc">I den regulatoriske sandkassen får du råd og veiledning som hjelper deg å utvikle et KI-system som følger loven.</p>
          <span class="sandkasse-arrow">→</span>
        </div>
      </a>
  </section>

  </div>
</Layout>

<style>
  /* Sections container for CMS-driven reordering */
  .sections-container {
    row-gap: 64px;
    padding-block: 64px;
  }

  /* Shared */
  .section-heading {
    font-family: 'Inter', sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 32px;
    color: #000;
  }

  /* Veiledning */
  .veiledning {
    position: relative;
    z-index: 1;
  }
  .veiledning-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 640px) {
    .veiledning-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .veiledning-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px;
    background-color: #e2f0fc;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
    justify-content: space-between;
  }
  .veiledning-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .veiledning-card-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .veiledning-card-title {
    font-size: 24px;
    font-weight: 600;
    color: #111d46;
  }
  .veiledning-card-illustration {
    width: 100%;
    height: 180px;
    background-color: #d9d9d9;
    border-radius: 8px;
    margin-bottom: 16px;
  }
  .veiledning-card-desc {
    font-size: 18px;
    font-weight: 500;
    color: rgba(35, 44, 60, 0.75);
  }

  /* Aktuelt */
  .aktuelt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }
  @media (min-width: 1024px) {
    .aktuelt-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tre råd */
  .tre-raad {
    background-color: #eef7ff;
    padding: 64px var(--grid-min-margin);
  }
  .tre-raad-inner {
    max-width: calc(var(--grid-max-width) - 2 * var(--grid-min-margin));
    margin: 0 auto;
    text-align: center;
  }
  .tre-raad-heading {
    font-family: 'Inter', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #1a2a6d;
    margin: 0 0 48px;
  }
  .tre-raad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .tre-raad-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tre-raad-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px;
  }
  .tre-raad-illustration {
    width: 206px;
    height: 218px;
    background-color: #d9d9d9;
    border-radius: 12px;
    margin-bottom: 24px;
  }
  .tre-raad-card-title {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
    color: #000;
  }
  .tre-raad-card-desc {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0,0,0,0.55);
    margin: 0;
    line-height: 1.5;
    max-width: 340px;
  }

  /* Sandkasse */
  .sandkasse-card {
    display: flex;
    flex-direction: column;
    background-color: #f1e8d0;
    border-radius: 8px;
    padding: 24px 24px 32px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
  }
  .sandkasse-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .sandkasse-title {
    font-size: 32px;
    font-weight: 600;
    margin: 0 0 16px;
    color: #000;
    line-height: 1.3;
  }
  .sandkasse-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .sandkasse-desc {
    font-size: 24px;
    font-weight: 400;
    color: rgba(0,0,0,0.7);
    margin: 0;
    line-height: 1.5;
  }
  .sandkasse-arrow {
    font-size: 24px;
    color: rgba(0,0,0,0.7);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .section-heading {
      font-size: 24px;
    }
    .veiledning-card-title {
      font-size: 20px;
    }
    .tre-raad-heading {
      font-size: 24px;
    }
    .tre-raad-illustration {
      width: 160px;
      height: 170px;
    }
    .sandkasse-title {
      font-size: 24px;
    }
    .sandkasse-desc {
      font-size: 18px;
    }
  }
</style>
