---
/**
 * ContactCard - Reusable "Vil du vite mer?" contact CTA for article pages.
 * Contained card with image placeholder on left, matching Figma design.
 */
---

<div class="contact-wrapper">
  <div class="contact-card">
    <div class="contact-image" aria-hidden="true"></div>
    <div class="contact-content">
      <p class="contact-heading">Vil du vite mer?</p>
      <p class="contact-subtext">Har du spørsmål, eller ønsker du å komme i kontakt?</p>
      <div class="contact-buttons">
        <a href="tel:75006000" class="ds-button" data-variant="secondary" data-color="neutral">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Ring 75 00 60 00
        </a>
        <a href="mailto:kontakt@ki.norge.no" class="ds-button" data-variant="secondary" data-color="neutral">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Send mail
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-wrapper {
    max-width: 1120px;
    margin: var(--ds-size-10) auto;
    padding: var(--ds-size-4);
  }

  .contact-card {
    background-color: #f4eeff;
    border-radius: 6px;
    padding: 24px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .contact-image {
    width: 287px;
    height: 161px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    flex-shrink: 0;
  }

  .contact-content {
    flex: 1;
    min-width: 0;
  }

  .contact-heading {
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 var(--ds-size-2);
    color: var(--ds-color-text-neutral-default, #1e2b3c);
    line-height: 1.3;
  }

  .contact-subtext {
    font-size: 1rem;
    color: #475569;
    margin: 0 0 var(--ds-size-6);
  }

  .contact-buttons {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 639px) {
    .contact-image {
      display: none;
    }

    .contact-card {
      flex-direction: column;
    }

    .contact-buttons {
      flex-direction: column;
    }
  }
</style>
