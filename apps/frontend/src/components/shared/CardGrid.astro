---
interface Props {
  columns?: 2 | 3 | 4;
  divided?: boolean;
}

const { columns = 3, divided = false } = Astro.props;
---

<div class:list={['card-grid', `card-grid--${columns}`, divided && 'card-grid--divided']}>
  <slot />
</div>

<style>
  /* Same spacing as the cards on /artikler, so it is clear which image
     belongs to which heading when the cards are stacked (#796). */
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-12);
    rule: 1px solid var(--ds-color-border-subtle);
  }

  /* ── Column variants ──────────────────────────────── */
  /* minmax(0, 1fr) and not 1fr: a grid item has min-content as its automatic
     minimum width, so a card that cannot shrink below 341px locked each track
     to 341px. Three such tracks became 1024px, and the front page got horizontal scrolling on
     everything from 768px to 1023px. With 0 as the minimum the tracks follow the viewport. */
  @media (min-width: 768px) {
    .card-grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .card-grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ── Divided variant ───────────────────────────────── */
  .card-grid--divided {
    padding-block: var(--ds-size-6);
  }

  @media (min-width: 768px) {
    .card-grid--divided {
      gap: 0;
      margin-inline: calc(-1 * var(--ds-size-6));
      width: calc(100% + 2 * var(--ds-size-6));
    }

    .card-grid--divided > :global(*) {
      padding-inline: var(--ds-size-6);
    }

    .card-grid--divided > :global(*:last-child) {
      border-right: none;
    }
  }
</style>
