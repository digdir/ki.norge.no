---
import AkselIcon from '../shared/AkselIcon.astro';

interface Props {
  title: string;
  href: string;
}
const { title, href } = Astro.props;
---
<a href={href} class="next-bar ds-focus">
  <div>
    <p class="ds-paragraph" data-size="lg">Neste steg</p>
    <p class="ds-paragraph" data-size="lg">{title}</p>
  </div>
  <AkselIcon name="ArrowRight" size={24} />
</a>
<style>
  .next-bar {
    background: var(--ds-color-base-active);
    padding-block: var(--ds-size-8);
    padding-inline: var(--ds-size-7);
    border-radius: var(--ds-border-radius-xl);
    color: var(--ds-color-base-contrast-default);
    text-decoration: none;
    display: grid;
    grid-template-columns: auto max-content;
  }
  .next-bar:hover {
    background: var(--ds-color-base-hover);
  }

  .next-bar :global(svg) {
    margin-block-start: auto;
    vertical-align: middle;
    color: var(--ds-color-base-contrast-default);
  }
</style>
