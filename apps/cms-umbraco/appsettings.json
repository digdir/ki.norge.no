{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "da0350ed-abc3-4b1a-adfb-147dd1286c77",
        "SanitizeHostName": true,
        "MainDomUri": "https://ki.norge.no",
        "ReservedPaths": "~/app_plugins/,~/install/,~/mini-profiler-resources/,~/umbraco/,~/signin-entra",
        "TimeOut": "02:00:00"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "AllowedUploadedFileExtensions": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "svg",
          "pdf",
          "mp4",
          "webm"
        ],
        "DisallowedUploadedFileExtensions": [
          "exe",
          "dll",
          "bat",
          "sh",
          "ps1",
          "cmd",
          "vbs",
          "js",
          "html",
          "htm",
          "xml",
          "asp",
          "aspx",
          "php",
          "jar"
        ]
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "RichTextOutputAsJson": true
      },
      "Hosting": {
        "Debug": false
      },
      "Unattended": {
        // Without this, Umbraco skips pending database migrations at
        // startup, and the Delivery API answers 200 OK with an empty list.
        "UpgradeUnattended": true
      },
      "Runtime": {
        "MaxRequestLength": 102400
      },
      "Security": {
        "UserPasswordConfiguration": {
          "RequiredLength": 10,
          "RequiredUniqueChars": 2,
          "RequireNonLetterOrDigit": true,
          "RequireDigit": false,
          "RequireLowercase": true,
          "RequireUppercase": true
        }
      }
    }
  },
  "Elasticsearch": {
    "Endpoint": "",
    "IndexName": "ki-content"
  },
  // ZoneId + ApiToken from Key Vault, SiteBaseUrl per environment in syncroot.
  "Cloudflare": {
    "Enabled": true,
    "ApiHost": "api.cloudflare.com",
    "ZoneId": "",
    "ApiToken": "",
    "SiteBaseUrl": "",
    "MaxUrlsPerRequest": 30,
    "TimeoutSeconds": 5,
    "AffectedUrlThreshold": 30
  },
  // uSync mirrors content, media and schema from prod to tt02. Prod owns the schema
  // via ContentTypeComposer (the Default set is read-only). tt02 can let uSync own
  // the schema (the Speiling set + env USYNC_OWNS_SCHEMA=true, see kustomization).
  // All automation is off, uSync does nothing until an admin runs export or
  // import in the backoffice.
  "uSync": {
    "Settings": {
      "ImportAtStartup": "None",
      "ExportAtStartup": "None",
      "ExportOnSave": "None",
      "ImportOnFirstBoot": false,
      // The schema handlers are in the Settings group. Without this, only
      // the content handlers show in the uSync dashboard, and schema cannot be exported
      // from the backoffice. Safe in prod: the Default set is export-only, so
      // the Import button is a dead no-op for schema too.
      "UIEnabledGroups": "Content,Settings",
      "DefaultSet": "Default"
    },
    "Sets": {
      // Default for ALL environments (incl. prod). CONTENT and MEDIA are still
      // export-only, so a misclicked import can never overwrite prod content.
      // SCHEMA (content types + data types) allows import, because uSync is to own
      // the schema and reconcile it against the committed files at startup
      // (ImportAtStartup: "Settings"). The files are prod's own export, so
      // the import is a no-op as long as the files and the database are in sync.
      "Default": {
        "HandlerDefaults": { "Enabled": false },
        "Handlers": {
          "ContentHandler": { "Enabled": true, "Actions": [ "Export" ] },
          "MediaHandler": { "Enabled": true, "Actions": [ "Export" ] },
          "ContentTypeHandler": { "Enabled": true, "Actions": [ "All" ] },
          "DataTypeHandler": { "Enabled": true, "Actions": [ "All" ] }
        }
      },
      // Import + export, schema too. Used ONLY by tt02 via the env var
      // uSync__Settings__DefaultSet=Speiling (syncroot/tt02/kustomization.yaml).
      // Together with USYNC_OWNS_SCHEMA=true this lets uSync create the content types
      // from the prod export's files with prod's keys, so the article modules resolve
      // in mirrored content.
      "Speiling": {
        "HandlerDefaults": { "Enabled": false },
        "Handlers": {
          "ContentHandler": { "Enabled": true, "Actions": [ "All" ] },
          "MediaHandler": { "Enabled": true, "Actions": [ "All" ] },
          "ContentTypeHandler": { "Enabled": true, "Actions": [ "All" ] },
          "DataTypeHandler": { "Enabled": true, "Actions": [ "All" ] }
        }
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}