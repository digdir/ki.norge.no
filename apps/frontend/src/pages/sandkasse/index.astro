---
import Layout from '../../components/layout/Layout.astro';
import Bilde from '../../components/shared/Bilde.astro';
import ArticleLayout from '../../components/shared/ArticleLayout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';
import { getSandkasse, getPlainText, bakgrunnSurface } from '../../lib/umbraco';
import { breadcrumbSchema } from '../../lib/seo';
import { ordlengde } from '../../lib/text';

const isPreview = Astro.locals.isPreview;
const sandkasse = await getSandkasse({ preview: isPreview });

if (!sandkasse) {
  return Astro.redirect('/');
}

const seoTitle = sandkasse.seoTittel || sandkasse.tittel;
const seoDesc = sandkasse.seoBeskrivelse || sandkasse.ingress || getPlainText(sandkasse.innhold, 200);
const seoImage = sandkasse.seoBilde?.url ? sandkasse.seoBilde : sandkasse.artikkelBilde;

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: sandkasse.tittel, url: '/sandkasse' },
]);

// SEO-bildet er for delingsforhaandsvisning og skal aldri bli innhold (#738).
const heroImage = sandkasse.artikkelBilde;
const heroBg = bakgrunnSurface(sandkasse.bakgrunn);

const allBlocks = sandkasse.innhold ?? [];
const bylineBlock = allBlocks.find(b => b.contentType === 'artikkelByline');
const contentBlocks = allBlocks.filter(b => b.contentType !== 'artikkelByline');
---

<Layout title={seoTitle} description={seoDesc} ogImage={seoImage} bodyColor={sandkasse.bakgrunn?.replace(' ', '').toLocaleLowerCase()}>
  
  <section class="article-hero" data-layout-block="edge">
    <div class="article-hero-inner">
      <div class="article-hero-text">
        <h1 class="ds-heading article-title" data-size="xl" style={ordlengde(sandkasse.tittel)}>{sandkasse.tittel}</h1>
      </div>
      {heroImage?.url && (
        <div class="article-hero-image">
          <Bilde media={heroImage} format="sandkasse" sizes="(max-width: 1024px) 100vw, 680px" alt={sandkasse.bildeAlt || ''} prioritet />
        </div>
      )}
    </div>
  </section>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <ArticleLayout publishedAt={sandkasse.publishedAt} byline={(bylineBlock?.content ?? null) as any}>
    {sandkasse.ingress && (
      <p class="article-ingress ds-paragraph" data-size="lg">{sandkasse.ingress}</p>
    )}

    <ArticleBlocksRenderer blocks={contentBlocks} />
  </ArticleLayout>
</Layout>

<style>
  /* Hero: tittel over fullbredde banner-bilde (2:1, object-fit cover) */
  .article-hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  .article-hero-text { min-width: 0; }

  .article-hero-image {
    width: 100%;
    margin-block-start: 0;
    border-radius: 8px;
    overflow: hidden;
  }
</style>
