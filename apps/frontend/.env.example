# Umbraco CMS connection
UMBRACO_URL=http://localhost:5000
UMBRACO_API_KEY=your-api-key-for-preview  # Must match Umbraco:CMS:DeliveryApi:ApiKey in appsettings

# Site configuration
SITE_URL=http://localhost:4321

# Preview (must match preview secret configuration)
PREVIEW_SECRET=change-me

# Cloudflare cache purge (for Umbraco publish webhook)
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PURGE_TOKEN=your-api-token  # Needs Zone.Cache Purge permission
PURGE_SECRET=change-me  # Shared secret to authenticate webhook requests

# Hybrid search (Elastic) — server-side only; powers the search modal via /api/search.
# Unset → search falls back to Umbraco basic search. Use a SCOPED read-only key for prod.
ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
KI_INDEX=ki-content
