# Umbraco CMS
UMBRACO_URL=http://localhost:5000
UMBRACO_PUBLIC_URL=http://localhost:5000  # Host nettleseren henter media fra
UMBRACO_API_KEY=your-api-key-for-preview  # Må matche Umbraco:CMS:DeliveryApi:ApiKey

# Admin-tilgang til /status via /admin-tilgang?key=
ADMIN_SECRET=change-me

# Cloudflare cache purge. Brukes av scripts/purge-cache.mjs etter deploy, så
# edgen ikke serverer HTML som peker på slettede _astro-filer.
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PURGE_TOKEN=cfat_...  # Trenger Zone.Cache Purge

# Hybrid-søk (Elastic), kun server-side, driver søkemodalen via /api/search.
# Uten disse faller søket tilbake på Umbracos enkle søk.
ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
KI_INDEX=ki-content
