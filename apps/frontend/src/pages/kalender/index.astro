---
import Layout from '../../components/layout/Layout.astro';
import { getKalender, getKalenderhendelser, type Kalenderhendelse } from '../../lib/umbraco';

let kalender = null;
let hendelser: Kalenderhendelse[] = [];
try {
  const [k, h] = await Promise.all([getKalender(), getKalenderhendelser()]);
  kalender = k;
  hendelser = h.data;
} catch (e) {
  console.error('Failed to fetch kalender:', e);
}

const tittel = kalender?.tittel || 'Kalender';
const ingress = kalender?.ingress || 'Arrangementer om KI i offentlig sektor.';
const seoTitle = kalender?.seoTittel || tittel;
const seoDesc = kalender?.seoBeskrivelse || ingress;
const featured = kalender?.featuredHendelse || null;

const now = new Date();
const sortByStart = (a: Kalenderhendelse, b: Kalenderhendelse) =>
  new Date(a.startDato).getTime() - new Date(b.startDato).getTime();

// Bruk sluttDato hvis satt så flerdagers-arrangement holder seg som "kommende"
// helt til siste dag er passert. Sortering bruker fortsatt startDato.
const effectiveEnd = (h: Kalenderhendelse) => new Date(h.sluttDato || h.startDato);

const kommende = hendelser
  .filter(h => effectiveEnd(h) >= now)
  .sort(sortByStart);
const tidligere = hendelser
  .filter(h => effectiveEnd(h) < now)
  .sort((a, b) => sortByStart(b, a));

const monthAbbrev = ['jan', 'feb', 'mar', 'apr', 'mai', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'des'];
const formatDate = (iso: string) => {
  if (!iso) return { day: '', month: '' };
  const d = new Date(iso);
  return { day: String(d.getDate()), month: monthAbbrev[d.getMonth()] };
};
const parseTagger = (s?: string) =>
  (s || '').split(',').map(t => t.trim()).filter(Boolean);
---
<Layout title={seoTitle} description={seoDesc}>
  <div class="kalender-page grid">
    <header class="col-center-8 kalender-header">
      <h1 class="ds-heading" data-size="xl">{tittel}</h1>
      {ingress && <p class="kalender-ingress">{ingress}</p>}
    </header>

    {featured && (
      <section class="col-center-10 kalender-featured">
        <div class="kalender-featured-inner">
          <div class="kalender-featured-text">
            {featured.type && <p class="kalender-featured-type">{featured.type}</p>}
            <h2 class="ds-heading" data-size="lg">{featured.tittel}</h2>
            {featured.ingress && <p class="kalender-featured-ingress">{featured.ingress}</p>}
            {featured.lenke && (
              <a class="ds-button" data-color="neutral" data-variant="primary" href={featured.lenke}>
                Les mer
              </a>
            )}
          </div>
          <div class="kalender-featured-date">
            <div class="kalender-date-box">
              <span class="kalender-date-day">{formatDate(featured.startDato).day}</span>
              <span class="kalender-date-month">{formatDate(featured.startDato).month}</span>
            </div>
            {featured.tid && <p class="kalender-featured-time">{featured.tid}</p>}
            {featured.sted && <p class="kalender-featured-place">{featured.sted}</p>}
          </div>
        </div>
      </section>
    )}

    <div class="col-center-8 kalender-tabs">
      <h2 class="ds-heading" data-size="md">Arrangementer</h2>
      <div role="tablist" class="kalender-tablist">
        <button type="button" role="tab" aria-selected="true" data-tab="kommende" class="kalender-tab kalender-tab--active">
          Kommende arrangement
        </button>
        <button type="button" role="tab" aria-selected="false" data-tab="tidligere" class="kalender-tab">
          Tidligere arrangement
        </button>
      </div>

      <div role="tabpanel" data-panel="kommende" class="kalender-panel">
        {kommende.length === 0 ? (
          <p class="kalender-empty">Ingen kommende arrangement.</p>
        ) : (
          <ul class="kalender-list">
            {kommende.map(h => (
              <li class="kalender-card">
                <div class="kalender-date-box">
                  <span class="kalender-date-day">{formatDate(h.startDato).day}</span>
                  <span class="kalender-date-month">{formatDate(h.startDato).month}</span>
                </div>
                <div class="kalender-card-body">
                  {h.type && <p class="kalender-card-type">{h.type}</p>}
                  {parseTagger(h.tagger).length > 0 && (
                    <ul class="kalender-card-tags">
                      {parseTagger(h.tagger).map(t => <li>{t}</li>)}
                    </ul>
                  )}
                  <h3 class="ds-heading" data-size="sm">{h.tittel}</h3>
                  {h.ingress && <p class="kalender-card-ingress">{h.ingress}</p>}
                  <p class="kalender-card-meta">
                    {h.tid && <span>{h.tid}</span>}
                    {h.sted && <span>{h.sted}</span>}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div role="tabpanel" data-panel="tidligere" class="kalender-panel" hidden>
        {tidligere.length === 0 ? (
          <p class="kalender-empty">Ingen tidligere arrangement.</p>
        ) : (
          <ul class="kalender-list">
            {tidligere.map(h => (
              <li class="kalender-card">
                <div class="kalender-date-box">
                  <span class="kalender-date-day">{formatDate(h.startDato).day}</span>
                  <span class="kalender-date-month">{formatDate(h.startDato).month}</span>
                </div>
                <div class="kalender-card-body">
                  {h.type && <p class="kalender-card-type">{h.type}</p>}
                  <h3 class="ds-heading" data-size="sm">{h.tittel}</h3>
                  {h.ingress && <p class="kalender-card-ingress">{h.ingress}</p>}
                  <p class="kalender-card-meta">
                    {h.tid && <span>{h.tid}</span>}
                    {h.sted && <span>{h.sted}</span>}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.kalender-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      document.querySelectorAll<HTMLButtonElement>('.kalender-tab').forEach(b => {
        const active = b.dataset.tab === target;
        b.classList.toggle('kalender-tab--active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('.kalender-panel').forEach(p => {
        p.hidden = p.dataset.panel !== target;
      });
    });
  });
</script>

<style>
  .kalender-page {
    padding-block: var(--ds-size-8);
    padding-inline: var(--ds-size-4);
    row-gap: var(--ds-size-8);
  }
  .kalender-header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }
  .kalender-ingress {
    margin: 0;
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-lg-line-height);
    color: var(--ds-color-neutral-text-subtle);
  }

  .kalender-featured {
    background: var(--ds-color-accent-base-default, #5a1e1e);
    color: var(--ds-color-accent-contrast-default, #fff);
    border-radius: var(--ds-border-radius-lg, 16px);
    padding: var(--ds-size-6);
  }
  .kalender-featured-inner {
    display: grid;
    gap: var(--ds-size-6);
  }
  @media (min-width: 768px) {
    .kalender-featured-inner {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
  .kalender-featured-text {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }
  .kalender-featured-text .ds-heading {
    color: inherit;
  }
  .kalender-featured-type {
    margin: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.875rem;
  }
  .kalender-featured-ingress {
    margin: 0;
  }
  .kalender-featured-date {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    align-items: flex-start;
  }
  .kalender-featured-time,
  .kalender-featured-place {
    margin: 0;
  }

  .kalender-date-box {
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--ds-border-radius-md, 8px);
    padding: var(--ds-size-2) var(--ds-size-3);
    text-align: center;
    min-width: 64px;
  }
  .kalender-date-day {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .kalender-date-month {
    display: block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .kalender-tabs {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }
  .kalender-tablist {
    display: flex;
    gap: var(--ds-size-2);
    border-bottom: 1px solid var(--ds-color-neutral-border-subtle, #e5e5e5);
  }
  .kalender-tab {
    border: 0;
    background: transparent;
    padding: var(--ds-size-3) var(--ds-size-4);
    font: inherit;
    color: var(--ds-color-neutral-text-subtle);
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .kalender-tab--active {
    color: var(--ds-color-text-default);
    border-bottom-color: currentColor;
    font-weight: 600;
  }
  .kalender-panel[hidden] {
    display: none;
  }
  .kalender-empty {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
  }
  .kalender-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }
  .kalender-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--ds-size-4);
    padding: var(--ds-size-4);
    background: var(--ds-color-neutral-surface-default, #f7f7f7);
    border-radius: var(--ds-border-radius-md, 8px);
  }
  .kalender-card .kalender-date-box {
    background: var(--ds-color-neutral-surface-tinted, #ececec);
    color: var(--ds-color-text-default);
  }
  .kalender-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }
  .kalender-card-type {
    margin: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.875rem;
    color: var(--ds-color-neutral-text-subtle);
  }
  .kalender-card-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
  }
  .kalender-card-tags li {
    background: var(--ds-color-neutral-surface-tinted, #ececec);
    padding: 2px var(--ds-size-2);
    border-radius: 9999px;
    font-size: 0.75rem;
  }
  .kalender-card-ingress {
    margin: 0;
  }
  .kalender-card-meta {
    display: flex;
    gap: var(--ds-size-3);
    margin: 0;
    font-size: 0.875rem;
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
