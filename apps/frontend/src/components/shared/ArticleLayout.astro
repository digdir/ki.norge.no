---
/**
 * ArticleLayout — two-column grid: sidebar + content.
 *
 * Uses CSS Grid. All default-slot children become direct grid children.
 *   - By default they sit in the content column (col 2).
 *   - data-layout-block="edge" makes them span both columns (full width).
 *
 * The sidebar slot is placed in column 1, row 1.
 * If no sidebar slot is provided and publishedAt is set, a default
 * date + share sidebar is rendered automatically.
 *
 * Also sets the page body to the pink surface color — no need to do
 * this manually on each page that uses this layout.
 */
import '../../styles/article-layout.css';
import AkselIcon from './AkselIcon.astro';

interface Props {
  class?: string;
  publishedAt?: string;
  byline?: { navn?: string; stilling?: string; virksomhet?: string; dato?: string } | null;
}

const { class: className, publishedAt, byline } = Astro.props;
const classes = ['article-layout', className].filter(Boolean).join(' ');

// Byline date (editor-set) takes precedence over the CMS publish timestamp.
const publisertDate = byline?.dato || publishedAt;
const formattedDate = publisertDate
  ? new Date(publisertDate).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
const bylineAuthor = byline
  ? [byline.navn, byline.stilling, byline.virksomhet ? `i ${byline.virksomhet}` : ''].filter(Boolean).join(' ')
  : '';
---

<div class={classes} data-layout-block="edge">
  <div class="article-layout__grid u-rich-text">
    <aside class="article-layout__sidebar">
      <slot name="sidebar">
        {formattedDate && (
          <time class="article-layout__metadata ds-paragraph" data-size="sm" datetime={publisertDate}>
            <span class="article-layout__metadata-label">Publisert</span>
            {formattedDate}
          </time>
        )}
        {bylineAuthor && (
          <div class="article-layout__metadata ds-paragraph" data-size="sm">
            <span class="article-layout__metadata-label">Av</span>
            {bylineAuthor}
          </div>
        )}
        <button class="article-layout__share ds-button" type="button" data-size="sm" data-variant="tertiary" data-share-button>
            <AkselIcon name="ArrowForward" size={24} />
            Del
        </button>
      </slot>
    </aside>
    <slot />
  </div>
</div>

<style is:global>
  body {
    background-color: var(--ds-color-surface-active) !important;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-share-button]');
  btn?.addEventListener('click', async () => {
    const shareData = {
      title: document.title,
      url: window.location.href,
    };
    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch (e) {
        // User cancelled or share failed silently
      }
    } else {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = 'Kopiert!';
      setTimeout(() => { btn.textContent = 'Del'; }, 2000);
    }
  });
</script>
