---
import '../../styles/global.css';
import Header from './Header.tsx';
import SearchDialog from '../shared/SearchDialog.tsx';
import Footer from './Footer.astro';
import PreviewBanner from '../shared/PreviewBanner.astro';
import CookieNotice from '../shared/CookieNotice.astro';
import { toAbsoluteMediaUrl } from '../../lib/umbraco';
import '../../styles/layout.css';
import '../../styles/search-dialog.css';
import './header.css';

  interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedAt?: string;
  hideLogo?: boolean;
  bodyColor?: string;
}

const {
  title,
  description = 'Norges nasjonale strategi for kunstig intelligens',
  ogType = 'website',
  ogImage,
  publishedAt,
  hideLogo = false,
  bodyColor = 'accent',
} = Astro.props;

const isPreview = Astro.locals.isPreview;
const currentPath = Astro.url.pathname;
// Use Astro.site (configured in astro.config.mjs) — never trust Astro.url
// origin since it returns localhost when behind Azure's reverse proxy.
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://ki.norge.no';
const canonicalUrl = `${siteUrl}${currentPath}`;
// Mangler CMS-tittelen, faller vi tilbake til bare nettstedsnavnet (aldri "undefined | KI Norge").
const fullTitle = title ? `${title} | KI Norge` : 'KI Norge';
// Version query busts stale link-preview thumbnail caches without changing the asset path.
const DEFAULT_OG_IMAGE = '/og-image.png?v=3c5667a2';
// CMS-media (/media/...) gjores absolutt mot CMS-hosten; ellers prefikses
// site-hosten. Uten dette ble og:image til ki.norge.no/media/... (feil host),
// som ga utdatert/odelagt delingsbilde.
const resolvedOg = toAbsoluteMediaUrl(ogImage);
const ogImageUrl = resolvedOg
  ? (resolvedOg.startsWith('http') ? resolvedOg : `${siteUrl}${resolvedOg}`)
  : `${siteUrl}${DEFAULT_OG_IMAGE}`;
---

<!doctype html>
<html lang="no" data-ds-color-mode="light" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <style>@layer ds, layout, site, article-layout;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2a6d" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    {isPreview && <meta name="robots" content="noindex" />}
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KI Norge" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="KI Norge" />

    <!-- Fontene er selvhostet, se src/styles/fonts.css. Bare de to latin-filene
         som trengs over skjermkanten preloades: brødtekst og overskrifter.
         crossorigin er påkrevd selv for samme opphav, fonter hentes i CORS-modus. -->
    <link
      rel="preload"
      href="/fonts/instrument-sans-400-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/pt-serif-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Light mode only (dark mode not supported) -->
    <meta name="color-scheme" content="light" />

    <!-- Sidespesifikk metadata, i praksis JSON-LD. Må ligge her og ikke i main:
         main har negativ toppmargin, og kompensasjonen treffer main > :first-child.
         Et <script> som første barn rendres ikke, så padding-en forsvant og
         overskriften la seg oppå headeren. -->
    <slot name="head" />
  </head>
  <body data-color-scheme="light" data-color={bodyColor} class:list={[hideLogo && 'hide-header-logo']}>
    <a href="#main-content" class="ds-skip-link">Hopp til hovedinnhold</a>
    <CookieNotice />
    <Header client:load currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SearchDialog client:load />
    {isPreview && <PreviewBanner currentPath={currentPath} />}
    <script is:inline>
      document.querySelectorAll('a[href^="http"]').forEach(function(a) {
        if (!a.rel || !a.rel.includes('noopener')) {
          a.rel = a.rel ? a.rel + ' noopener' : 'noopener';
        }
      });
    </script>
    <script>
      // WebMCP. No-op i nettlesere uten modelContext, som er de aller fleste.
      import { registerWebMcpTools } from '../../lib/webmcp';
      void registerWebMcpTools();
    </script>
  </body>
</html>

<style>
  main {
    flex: 1;
    margin-top: calc(var(--header-height, 72px) * -1);
  }

  main > :global(:first-child) {
    padding-top: calc(var(--header-height, 72px) + var(--ds-size-14));
  }

  @media (max-width: 600px) {
    main > :global(:first-child) {
      padding-top: calc(var(--header-height, 72px) + var(--ds-size-6));
    }
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
