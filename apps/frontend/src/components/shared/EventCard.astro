---
import AkselIcon from './AkselIcon.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  day: string;
  month: string;
  year: string;
  time?: string;
  timeNote?: string;
  location?: string;
}

const {
  href,
  title,
  description,
  day,
  month,
  year,
  time,
  timeNote,
  location,
} = Astro.props;

const id = `event-card-${crypto.randomUUID().slice(0, 8)}`;
---

<div class="event-card" data-clickdelegatefor={id}>
  <div class="event-card-date">
    <span class="event-card-day">{day}.<br />{month}</span>
    <span class="event-card-year">{year}</span>
  </div>
  <div class="event-card-body">
    <div class="event-card-info">
      <h3 class="ds-heading event-card-title" data-size="sm"><a id={id} href={href}>{title}</a></h3>
      {description && <p class="event-card-desc">{description}</p>}
    </div>
    {(time || location) && (
      <div class="event-card-details">
        {time && (
          <span>
            <AkselIcon name="Clock" size={20} />
            <span>{time}{timeNote && <><br/>{timeNote}</>}</span>
          </span>
        )}
        {location && (
          <span>
            <AkselIcon name="LocationPin" size={20} />
            {location}
          </span>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .event-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0;
    background-color: #FFF; /* TODO: this does not have a proper DS color */
    overflow: hidden;
    cursor: pointer;

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }
  }


  .event-card-title {
    font-family: var(--ds-font-family);

      & a {
        text-decoration: none;
        color: inherit;
        &.\:click-delegate-hover {
          text-decoration: underline;
        }
        &:focus-visible {
          outline: none;
        }
    }
  }



  .event-card-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--ds-color-surface-active);
    padding-block: var(--ds-size-10);
    padding-inline: var(--ds-size-8);
    gap: var(--ds-size-3);
  }

  .event-card-day {
    font-family: 'PT Serif', serif;
    font-size: var(--ds-heading-md-font-size);
    text-align: center;
    line-height: 1;
  }
  .event-card-year {
    font-size: var(--ds-body-sm-font-size);
  }

  .event-card-body {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: var(--ds-size-6);
    align-items: center;
  }

  .event-card-info {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .event-card-title {
    margin: 0;
  }

  .event-card-desc {
    font-size: var(--ds-body-sm-font-size);
    margin: 0;
  }

  .event-card-details {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    font-size: var(--ds-body-sm-font-size);
    border-left: 1px solid var(--ds-color-surface-active);
    padding-inline-start: var(--ds-size-12);
  }

  .event-card-details span {
    display: flex;
    align-items: start;
    gap: var(--ds-size-2);
  }

  .event-card-details svg {
    flex-shrink: 0;
    margin: auto;
  }

  @media (max-width: 767px) {
    .event-card {
      grid-template-columns: 1fr;
    }

    .event-card-date {
      flex-direction: row;
      gap: var(--ds-size-2);
      padding: var(--ds-size-4) var(--ds-size-6);
      min-width: unset;
    }

    .event-card-body {
      grid-template-columns: 1fr;
    }

    .event-card-details {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--ds-color-border-subtle);
      padding-top: var(--ds-size-4);
    }
  }

</style>
