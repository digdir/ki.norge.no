---
import Layout from '../components/layout/Layout.astro';
import BlocksRenderer from '../components/shared/BlocksRenderer.astro';
import ContactCard from '../components/shared/ContactCard.astro';
import { getSide } from '../lib/umbraco';

let page = null;
try {
  page = await getSide('kontakt');
} catch (error) {
  console.error('Failed to fetch kontakt page:', error);
}

const title = page?.seoTittel || page?.tittel || 'Kontakt oss';
const seoDescription = page?.seoBeskrivelse || 'Ta kontakt med KI Norge for spørsmål om kunstig intelligens i offentlig sektor.';
const seoImage = page?.seoBilde?.url;
---

<Layout title={title} description={seoDescription} ogImage={seoImage}>
    <div data-layout-block="content">
      <h1 class="ds-heading" data-size="xl">{title}</h1>
      <p class="kontakt-lead">Har du spørsmål eller trenger hjelp? Vi er her for å bistå deg med kunstig intelligens i offentlig sektor.</p>
    </div>

    <div class="kontakt-content" data-layout-block="content">
      <div class="kontakt-body">
        {page?.innhold ? (
          <BlocksRenderer blocks={page.innhold} />
        ) : (
          <>
            <h2>E-post</h2>
            <p>Send oss en e-post, så svarer vi deg så raskt vi kan.</p>
            <p><a href="mailto:kontakt@ki.norge.no">kontakt@ki.norge.no</a></p>

            <h2>Besøksadresse</h2>
            <p>Digitaliseringsdirektoratet<br />Brattørkaia 15B<br />7010 Trondheim</p>
          </>
        )}
      </div>

      <div class="kontakt-links" data-layout-block="content">
        <a href="/faq" class="kontakt-link-card">
          <span class="kontakt-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          <div>
            <p class="kontakt-link-title">Ofte stilte spørsmål</p>
            <p class="kontakt-link-desc">Sjekk om svaret finnes i våre ofte stilte spørsmål.</p>
          </div>
        </a>
        <a href="/om-oss" class="kontakt-link-card">
          <span class="kontakt-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <div>
            <p class="kontakt-link-title">Om oss</p>
            <p class="kontakt-link-desc">Lær mer om KI Norge og hvem som står bak.</p>
          </div>
        </a>
      </div>
    </div>

    <ContactCard />
</Layout>

<style>
  .kontakt-page {
    padding-top: var(--ds-size-4);
  }

  .kontakt-lead {
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
  }

  .kontakt-body {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.75);
    margin-bottom: var(--ds-size-8);
  }

  .kontakt-body :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: #000;
    margin: var(--ds-size-8) 0 var(--ds-size-3);
  }

  .kontakt-body :global(h2:first-child) {
    margin-top: 0;
  }

  .kontakt-body :global(p) {
    margin: 0 0 var(--ds-size-3);
  }

  .kontakt-body :global(a) {
    color: #000;
    text-decoration: underline;
  }

  .kontakt-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-4);
    margin-bottom: var(--ds-size-8);
  }

  @media (min-width: 640px) {
    .kontakt-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .kontakt-link-card {
    display: flex;
    align-items: flex-start;
    gap: var(--ds-size-4);
    padding: var(--ds-size-5);
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  .kontakt-link-card:hover {
    border-color: #b8bcc1;
  }

  .kontakt-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #334155;
    margin-top: 2px;
  }

  .kontakt-link-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 4px;
    color: #000;
  }

  .kontakt-link-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
  }
</style>
