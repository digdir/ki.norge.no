{
	"compatibility_date": "2026-05-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"name": "ki-norge-frontend",
	"account_id": "4c4f444ed739a1c06fe2f2aa5195a8a8",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	// Hastighetsgrenser for de to åpne API-rutene. Bindinger arves ikke av
	// navngitte miljøer, så de gjentas under hver env. Period må være 10 eller 60.
	//
	// namespace_id gjelder per Cloudflare-konto, ikke per worker: to bindinger
	// med samme id deler teller selv om de ligger i hver sin worker. Kontoen her
	// er Digdirs felles konto, så id-ene er bevisst ikke 1001 og 1002, som er
	// verdiene i Cloudflares egen dokumentasjon og dermed det alle andre får
	// hvis de kopierer eksempelet.
	//
	// Grensa på søket er romslig med vilje. Målgruppa er offentlig ansatte, og
	// en hel kommune kan ligge bak én utgående IP. Se src/lib/turnstile.ts.
	"ratelimits": [
		{ "name": "TILTAK_LIMIT", "namespace_id": "73101", "simple": { "limit": 5, "period": 60 } },
		{ "name": "SEARCH_LIMIT", "namespace_id": "73102", "simple": { "limit": 60, "period": 60 } },
	],
	"env": {
		"tt02": {
			"vars": {
				"UMBRACO_URL": "https://kinorgeportal.tt02.dis-core.altinn.cloud",
				"UMBRACO_PUBLIC_URL": "https://kinorgeportal.tt02.dis-core.altinn.cloud",
				// Hybrid-søk (Elastic): endepunkt + indeks er offentlige (ikke hemmelige).
				// ES_API_KEY settes som secret: wrangler secret put ES_API_KEY --env tt02
				"ES_ENDPOINT": "https://kinorgeportal-elasticsearch-tt02-a61b24.es.germanywestcentral.azure.elastic.cloud",
				"KI_INDEX": "ki-content",
				// «Del KI-tiltak» sender via Microsoft Graph. Tenant- og klient-id er
				// identifikatorer, ikke hemmeligheter. Selve hemmeligheten settes med
				// wrangler secret put GRAPH_CLIENT_SECRET --env tt02
				// Merk at tt02 sender til den samme, ekte postboksen som prod.
				"GRAPH_TENANT_ID": "008e560f-08af-4cec-a056-b35447503991",
				"GRAPH_CLIENT_ID": "ac5194d9-cdac-404b-9568-9006a149c395",
				"KI_TILTAK_MAILBOX": "ki-tiltak@kin.norge.no",
				// Turnstile på «Del KI-tiltak». Site key er offentlig og hører hjemme
				// her; fyll den inn fra widgeten i Cloudflare-dashbordet. Hemmeligheten
				// settes med wrangler secret put TURNSTILE_SECRET_KEY --env tt02
				// Står den tom, slipper innsendinger gjennom ukontrollert og ruta
				// logger det som en feil.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAEnMGfLvgsIVZ_Cl",
				"LAUNCH_MODE": "live",
			},
			"ratelimits": [
				{ "name": "TILTAK_LIMIT", "namespace_id": "73101", "simple": { "limit": 5, "period": 60 } },
				{ "name": "SEARCH_LIMIT", "namespace_id": "73102", "simple": { "limit": 60, "period": 60 } },
			],
		},
		"prod": {
			"vars": {
				"UMBRACO_URL": "https://kinorgeportal.prod.dis-core.altinn.cloud",
				// Media-URLer hentes av nettleseren, så de må peke på en offentlig host.
				// Dis-core-hosten krever Altinn-nett; proxy-workeren (#350) er offentlig nåbar.
				"UMBRACO_PUBLIC_URL": "https://cms-kinorgeportal-prod.digitaliseringsdirektoratet.workers.dev",
				// Hybrid-søk (Elastic): endepunkt + indeks er offentlige (ikke hemmelige).
				// Samme cluster/indeks som tt02 (holder prod-innhold). ES_API_KEY settes
				// som secret: wrangler secret put ES_API_KEY --env prod
				"ES_ENDPOINT": "https://kinorgeportal-elasticsearch-tt02-a61b24.es.germanywestcentral.azure.elastic.cloud",
				"KI_INDEX": "ki-content",
				// «Del KI-tiltak» sender via Microsoft Graph. Hemmeligheten settes med
				// wrangler secret put GRAPH_CLIENT_SECRET --env prod
				// Secreten utløper 20.02.2028, se docs.
				"GRAPH_TENANT_ID": "008e560f-08af-4cec-a056-b35447503991",
				"GRAPH_CLIENT_ID": "ac5194d9-cdac-404b-9568-9006a149c395",
				"KI_TILTAK_MAILBOX": "ki-tiltak@kin.norge.no",
				// Turnstile på «Del KI-tiltak». Site key er offentlig og hører hjemme
				// her; fyll den inn fra widgeten i Cloudflare-dashbordet. Hemmeligheten
				// settes med wrangler secret put TURNSTILE_SECRET_KEY --env prod
				// Står den tom, slipper innsendinger gjennom ukontrollert og ruta
				// logger det som en feil.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAEnMGfLvgsIVZ_Cl",
				// Holding page on ki.norge.no until launch. Flip to "live" to go public.
				"LAUNCH_MODE": "live",
			},
			"ratelimits": [
				{ "name": "TILTAK_LIMIT", "namespace_id": "73101", "simple": { "limit": 5, "period": 60 } },
				{ "name": "SEARCH_LIMIT", "namespace_id": "73102", "simple": { "limit": 60, "period": 60 } },
			],
		},
	},
}