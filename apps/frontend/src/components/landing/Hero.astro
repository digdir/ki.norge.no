---
// Hero — CSS gradient background (absolute, doesn't affect flow), centered bold headline
---

<section class="hero">
  <div class="hero-container">
    <h1 class="ds-heading" data-size="xl">Felleskapet for <strong>innovativ og ansvarlig</strong> utvikling og bruk av kunstig intelligens</h1>
   <img src="/og-image.png" alt="Illustrasjon av mennesker som samarbeider med AI" />
  </div>
</section>

<style>
  .hero {
    padding: 120px 0 80px;
    background-color: #E7E9EA;
  }
  
  .hero-container {
    margin: 0 auto;
    max-width: 1280px;
    display: grid;
    gap: var(--ds-size-30);
    grid-template-columns: 1fr 1fr;

    & img {
      max-width: 100%;
      height: auto;
      border-radius: var(--ds-border-radius-xl);
    }

    & h1 {
      margin-block: auto;
    }
  }


  @media (max-width: 1023px) {
    .hero-title {
      font-size: 48px;
      line-height: 52px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 560px;
      padding: 80px 0 40px;
    }

    .hero-title {
      font-size: 32px;
      line-height: 38px;
    }
    .hero-container {
      gap: 32px;
    }
  }
</style>
