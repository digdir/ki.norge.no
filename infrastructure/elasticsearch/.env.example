ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
# Optional — override the semantic_text inference endpoint:
# KI_EMBED_ID=.microsoft-multilingual-e5-large

# Crawler (rebuild-from-umbraco.mjs): production Umbraco Delivery API host + public site.
UMBRACO_URL=https://cms-kinorgeportal-prod.digitaliseringsdirektoratet.workers.dev
UMBRACO_PUBLIC_URL=https://ki.norge.no

# Reindex trigger (reindex.mjs / `pnpm run search:reindex`): calls the CMS's own
# POST /search/reindex, authenticated as an Umbraco Management API user.
# Create one: backoffice -> Users -> API Users -> add user with access, copy id + secret.
CMS_URL=https://cms-kinorgeportal-prod.digitaliseringsdirektoratet.workers.dev
UMBRACO_CLIENT_ID=umbraco-back-office-<name>
UMBRACO_CLIENT_SECRET=your-api-user-secret
