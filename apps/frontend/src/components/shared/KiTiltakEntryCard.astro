---
import AkselIcon from './AkselIcon.astro';
import { kiTiltak } from '../../lib/ki-tiltak';

interface Props {
  // h3 når kortet ligger inne i en seksjon med egen h2, som på forsiden.
  headingLevel?: 2 | 3;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}`;
const randId = `tiltak-entry-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="tiltak-entry" data-clickdelegatefor={randId}>
  <div class="tiltak-entry-tekst">
    <Heading class="ds-heading tiltak-entry-tittel" data-size="md">
      <a href="/ki-tiltak" id={randId}>
        Offentlige KI-tiltak
      </a>
    </Heading>
    <p class="ds-paragraph tiltak-entry-ingress" data-size="sm">
      Oversikt over hvordan kunstig intelligens tas i bruk i offentlig sektor.
    </p>
    <span class="tiltak-entry-lenke">
      Se tiltakene
      <span class="tiltak-entry-pil"><AkselIcon name="ArrowRight" /></span>
    </span>
  </div>

  <div class="tiltak-entry-teller">
    <span class="tiltak-entry-tall">{kiTiltak.length}</span>
    <span class="tiltak-entry-merkelapp">KI-tiltak meldt inn av virksomheter</span>
  </div>
</div>

<style>
  .tiltak-entry {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--ds-size-8);
    padding: var(--ds-size-8) var(--ds-size-10);
    color: inherit;
    background-color: var(--ds-color-brand2-background-default);
    border: 3px solid var(--ds-color-accent-border-subtle);
    cursor: pointer;

    &:hover .tiltak-entry-tittel {
      text-decoration: underline;
    }

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);

      & .tiltak-entry-tittel {
        text-decoration: underline;
      }
    }
  }

  .tiltak-entry-tittel {
    font-weight: bold;
    margin: 0 0 var(--ds-size-2);
    color: var(--ds-color-accent-text-default);
    
    & a {
      text-decoration: none;
      color: inherit;
      &:focus {
        outline: none;
      }
    }
  }

  .tiltak-entry-ingress {
    margin: 0 0 var(--ds-size-4);
    max-width: 44ch;
    color: var(--ds-color-neutral-text-subtle);
  }

  .tiltak-entry-lenke {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-weight: var(--ds-font-weight-medium);
    color: var(--ds-color-accent-text-default);
  }

  .tiltak-entry-pil {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ds-size-8);
    height: var(--ds-size-8);
    border-radius: var(--ds-border-radius-full);
    background-color: var(--ds-color-accent-surface-active);
  }

  .tiltak-entry-teller {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-1);
    padding-left: var(--ds-size-8);
    border-left: var(--ds-border-width-default) solid var(--ds-color-accent-border-subtle);
  }

  .tiltak-entry-tall {
    font-family: var(--ki-heading-font);
    font-size: var(--ds-heading-2xl-font-size);
    line-height: 1;
    color: var(--ds-color-accent-text-default);
  }

  .tiltak-entry-merkelapp {
    font-size: var(--ds-body-sm-font-size);
    color: var(--ds-color-accent-text-default);
    /* Teksten er lang nok til å brytes. Prototypen bryter den over to linjer
       sentrert under tallet, i stedet for å la kortet vokse i bredden. */
    max-width: 18ch;
    text-align: center;
  }

  @media (max-width: 767px) {
    .tiltak-entry {
      grid-template-columns: 1fr;
      gap: var(--ds-size-5);
      padding: var(--ds-size-6);
    }

    .tiltak-entry-teller {
      align-items: flex-start;
      padding-left: 0;
      padding-top: var(--ds-size-5);
      border-left: 0;
      border-top: var(--ds-border-width-default) solid var(--ds-color-accent-border-subtle);
    }

    .tiltak-entry-merkelapp {
      text-align: start;
    }
  }
</style>
