---
import Layout from '../../components/layout/Layout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';
import ExampleLinkCard from '../../components/shared/ExampleLinkCard.astro';

import { getCase, getCaser, getPlainText, type Case } from '../../lib/umbraco';
import { caseSchema, breadcrumbSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article: Case | null = await getCase(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/caser');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;

const articleJsonLd = caseSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Eksempler', url: '/caser' },
  { name: article.tittel, url: `/caser/${slug}` },
]);

// Fetch other cases for "Flere eksempler" section
const allCasesRes = await getCaser();
const otherArticles = allCasesRes.data.filter(a => a.slug !== slug).slice(0, 3);

const bakgrunn = article.bakgrunn || 'hvit';
const hasSidebar = bakgrunn === 'lyseblaa';

function checkerboard(i: number, cols: number): 'dark' | 'light' {
  const row = Math.floor(i / cols);
  const col = i % cols;
  return (row + col) % 2 === 0 ? 'dark' : 'light';
}
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  {hasSidebar ? (
    <!-- Sidebar layout: tinted body background, white content area -->
    <div class="case-sidebar-page" data-layout-block="content">
      <h1 class="ds-heading case-title" data-size="xl">{article.tittel}</h1>
    </div>
    <section class="case-content-bleed" data-layout-block="edge">
      <div class="case-sidebar-grid" data-layout-block="content">
        <aside class="case-sidebar">
          <div class="case-sidebar-meta">
            <p class="case-sidebar-label">Publisert</p>
            <p class="case-sidebar-value">{formattedDate}</p>
          </div>
          <div class="case-sidebar-meta">
            <p class="case-sidebar-label">Av</p>
            <p class="case-sidebar-value">Redaksjonen</p>
          </div>
          <button class="ds-button" type="button">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M12 5.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM4 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM12 13.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM5.4 7.8l5.2-2.6M5.4 8.2l5.2 2.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Del
          </button>
        </aside>
        <div class="case-content">
          {article.ingress && <p class="case-ingress ds-heading" data-size="lg">{article.ingress}</p>}
          <div data-layout-article>
            <ArticleBlocksRenderer blocks={article.innhold} defaultDate={article.publishedAt} />
          </div>
        </div>
      </div>
    </section>
  ) : (
    <!-- Simple centered layout -->
    <div class="case-simple" data-layout-block="content">
      <h1 class="case-title ds-heading" data-size="xl">{article.tittel}</h1>
      {article.ingress && <p class="case-ingress ds-heading" data-size="md">{article.ingress}</p>}
      <div data-layout-article class="case-content-small">
        <ArticleBlocksRenderer blocks={article.innhold} defaultDate={article.publishedAt} />
      </div>
    </div>
  )}

  <!-- Flere eksempler -->
  {otherArticles.length > 0 && (
    <section class="more-cases" data-layout-block="content">
      <h2 class="more-cases-heading">Flere eksempler</h2>
      <div class="more-cases-grid">
        {otherArticles.map((a, i) => (
          <ExampleLinkCard
            href={`/caser/${a.slug}`}
            title={a.tittel}
            tag="Eksempel"
            variant={checkerboard(i, 3)}
          />
        ))}
      </div>
    </section>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
</Layout>

<style>
  /* ── Shared ──────────────────────────────────────── */
  .case-title {
    font-weight: 700;
    margin: 0;
    text-wrap: balance;
  }

  .case-ingress {
    font-weight: 400;
    margin: 0;
  }

  /* ── Sidebar layout ─────────────────────────────── */
  .case-sidebar-page {
    padding-block: var(--ds-size-30);
    padding-top: calc(calc(var(--header-height, 72px) + var(--ds-size-8)) + var(--ds-size-12)) !important;
  }

  .case-sidebar-page .case-title {
    margin-left: calc(180px + var(--ds-size-12));
  }

  @media (max-width: 1023px) {
    .case-sidebar-page .case-title {
      margin-left: 0;
    }
  }

  :global(body:has(.case-sidebar-page)) {
    background-color: var(--ds-color-surface-hover);
  }

  .case-content-bleed {
    background-color: var(--ds-color-surface-default);
    border-radius: var(--ds-border-radius-lg);
  }

  .case-sidebar-grid {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
    padding-block: var(--ds-size-12);
  }

  @media (min-width: 1024px) {
    .case-sidebar-grid {
      flex-direction: row;
      gap: var(--ds-size-12);
    }
  }

  .case-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .case-sidebar {
      width: 180px;
    }
  }

  .case-sidebar-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .case-sidebar-label {
    font-size: var(--ds-font-size-1);
    color: var(--ds-color-text-subtle);
    margin: 0;
    font-weight: 500;
  }

  .case-sidebar-value {
    font-size: var(--ds-font-size-2);
    color: var(--ds-color-text-default);
    margin: 0;
    font-weight: 500;
  }

  .case-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
  }

  .case-content-small {
    margin: 0 auto;
  }

  /* ── Simple centered layout ─────────────────────── */
  .case-simple {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
    padding-block: var(--ds-size-12);
  }

  .case-simple .case-ingress {
    max-width: 100ch;
  }

  /* ── More cases ─────────────────────────────────── */
  .more-cases {
    padding-block: var(--ds-size-12);
  }

  .more-cases-heading {
    font-size: var(--ds-heading-lg-font-size, 32px);
    font-weight: 700;
    color: var(--ds-color-text-default);
    margin: 0 0 var(--ds-size-6);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-cases-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .more-cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .more-cases-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
