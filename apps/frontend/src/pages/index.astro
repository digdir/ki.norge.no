---
import Layout from '../components/layout/Layout.astro';
import ForsideSeksjonerRenderer from '../components/landing/ForsideSeksjonerRenderer.astro';
import { websiteSchema } from '../lib/seo';
import { getForside, getArtikler, getKalenderhendelser, getEksempler, getVeiledningGuider, getEnkleVeiledninger, hentKortKandidat, type Kalenderhendelse, type VeiledningGuide } from '../lib/umbraco';

const isPreview = Astro.locals.isPreview;

let forside = null;
let latestArticles: any[] = [];
let eksempler: any[] = [];
let upcomingEvents: Kalenderhendelse[] = [];
let harTidligereArrangementer = false;
let veiledninger: VeiledningGuide[] = [];
let enkleVeiledninger: any[] = [];
try {
  // Preview only applies to the front page's own draft (structure/headings/pins). The cards always
  // fetch PUBLISHED content, so preview matches what the public sees (no unpublished items leak in).
  forside = await getForside({ preview: isPreview });
  // Fetch a large pool so editor-picked cards can be looked up by id (not just the 4 newest).
  const artiklerRes = await getArtikler(60, { preview: isPreview });
  latestArticles = artiklerRes.data;
  const hendelserRes = await getKalenderhendelser({ preview: isPreview });
  const now = new Date();
  upcomingEvents = hendelserRes.data
    .filter(h => new Date(h.sluttDato || h.startDato) >= now)
    .sort((a, b) => new Date(a.startDato).getTime() - new Date(b.startDato).getTime());
  // The events module needs to know whether there is anything in the archive, so it can
  // point there when nothing is upcoming.
  harTidligereArrangementer = hendelserRes.data.some(h => new Date(h.sluttDato || h.startDato) < now);
  const eksemplerRes = await getEksempler({ preview: isPreview });
  eksempler = eksemplerRes.data;
  const veiledningerRes = await getVeiledningGuider({ preview: isPreview });
  veiledninger = veiledningerRes.data;
  const enkleVeiledningerRes = await getEnkleVeiledninger({ preview: isPreview });
  enkleVeiledninger = enkleVeiledningerRes.data;
} catch (e) {
  console.error('Failed to fetch frontpage CMS data:', e);
  // CMS fetch failed: do not cache the degraded render (empty front page without
  // hero) at the edge. See middleware, it respects this no-store.
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

// Aktuelt lets the editor point to anything in the content tree, including steps and
// step articles nested under a guide that are not in the lists above.
// Their URL requires ancestors, so we resolve them here. Only ids that are NOT
// in the lists are looked up, so normal use costs no extra calls.
const kjenteIder = new Set<string>([
  ...latestArticles.map((a: any) => a.id),
  ...eksempler.map((e: any) => e.id),
  ...veiledninger.map((v: any) => v.id),
  ...enkleVeiledninger.map((v: any) => v.id),
]);
const refererteIder = new Set<string>();
for (const blokk of forside?.seksjoner ?? []) {
  if (blokk.contentType !== 'forsideAktuelt') continue;
  if (blokk.fremhevetArtikkelId) refererteIder.add(blokk.fremhevetArtikkelId);
  for (const k of blokk.kort ?? []) if (k.id) refererteIder.add(k.id);
}
const ukjente = [...refererteIder].filter((id) => !kjenteIder.has(id));
const aktueltEkstra = new Map<string, any>();
if (ukjente.length > 0) {
  const loeste = await Promise.all(ukjente.map((id) => hentKortKandidat(id, { preview: isPreview })));
  for (const kort of loeste) if (kort) aktueltEkstra.set(kort.id, kort);
}

const title = forside?.seoTittel || 'Hjem';
const seoDescription = forside?.seoBeskrivelse || 'En nasjonal inngang til offentlig informasjon om ansvarlig og innovativ bruk av KI. Veiledning, artikler og gode eksempler.';
const websiteJsonLd = websiteSchema(seoDescription);
---

<Layout title={title} description={seoDescription} ogImage={forside?.seoBilde?.url} hideLogo>
  <h1 class="ds-sr-only">ki.norge.no - {title}</h1>
  
  <ForsideSeksjonerRenderer
    seksjoner={forside?.seksjoner ?? []}
    latestArticles={latestArticles}
    eksempler={eksempler}
    upcomingEvents={upcomingEvents}
    harTidligereArrangementer={harTidligereArrangementer}
    veiledninger={veiledninger}
    enkleVeiledninger={enkleVeiledninger}
    aktueltEkstra={aktueltEkstra}
    />
  <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
</Layout>
