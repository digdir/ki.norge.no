---
import Layout from '../../components/layout/Layout.astro';
import ArticleLayout from '../../components/shared/ArticleLayout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';
import NewsCard from '../../components/shared/NewsCard.astro';

import { getArtikkel, getArtikler, getPlainText } from '../../lib/umbraco';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Artikler', url: '/artikler' },
  { name: article.tittel, url: `/artikler/${slug}` },
]);

// Fetch other articles for "Flere artikler" section
const allArticlesRes = await getArtikler(10);
const otherArticles = allArticlesRes.data.filter(a => a.slug !== slug).slice(0, 3);

// Byline moves to the sidebar — pull it out of the block flow so it isn't
// also rendered inline in the content column.
const allBlocks = article.innhold ?? [];
const bylineBlock = allBlocks.find(b => b.contentType === 'artikkelByline');
const contentBlocks = allBlocks.filter(b => b.contentType !== 'artikkelByline');
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />

  <section class="article-hero" data-layout-block="edge">
    <h1 class="ds-heading article-title" data-size="xl">{article.tittel}</h1>
  </section>

  <ArticleLayout publishedAt={article.publishedAt} byline={(bylineBlock?.content ?? null) as any}>

    {article.ingress && (
      <p class="article-ingress ds-paragraph" data-size="lg">{article.ingress}</p>
    )}

    <ArticleBlocksRenderer blocks={contentBlocks} defaultDate={article.publishedAt} />
  </ArticleLayout>

  {otherArticles.length > 0 && (
    <section class="more-articles" data-layout-block="content">
      <h2 class="more-articles-heading ds-heading" data-size="md">Artikler</h2>
      <div class="more-articles-grid">
        {otherArticles.map(a => (
          <NewsCard
            href={`/artikler/${a.slug}`}
            title={a.tittel}
            date={a.publishedAt}
            lead={getPlainText(a.innhold, 80)}
            variant="image"
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  /* More articles */
  .more-articles {
    padding: 64px 0 120px;
  }

  .more-articles-heading {
    margin-block-end: var(--ds-size-8);
  }

  .more-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .more-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .more-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
