---
interface Props {
  href: string;
  title: string;
  tag?: string;
  tagColor?: string;
  date?: string;
}

const { href, title, tag, tagColor = 'neutral', date } = Astro.props;
const id = `compact-card-${crypto.randomUUID().slice(0, 8)}`;

const formattedDate = date
  ? new Date(date).toLocaleDateString('nb-NO', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : undefined;
---

<article class="compact-card" data-clickdelegatefor={id}>
  {tag && <span class="compact-card-tag ds-tag" data-color={tagColor}>{tag}</span>}
  <h3 class="compact-card-title"><a id={id} href={href}>{title}</a></h3>
  {formattedDate && (
    <span class="compact-card-date">
      {formattedDate}
    </span>
  )}
</article>

<style>
  .compact-card {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    cursor: pointer;
    padding: var(--ds-size-4);
    border-radius: var(--ds-border-radius-md);

    & a {
      text-decoration: none;
      color: inherit;

      &:focus-visible {
        outline: none;
      }

    }
    &:hover a {
      text-decoration: underline;
    }

    &:focus-within {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }
  }

  .compact-card-tag {
    color: var(--ds-color-accent-text-subtle);
  }

  .compact-card-title {
    font-size: var(--ds-body-md-font-size);
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  .compact-card-date {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-size: var(--ds-body-sm-font-size);
    color: var(--ds-color-text-default);
  }
</style>
