ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
# Optional — override the semantic_text inference endpoint:
# KI_EMBED_ID=.microsoft-multilingual-e5-large

# Reindex (rebuild-from-umbraco.mjs / `pnpm run search:reindex`): reads the public
# Umbraco Delivery API and writes to ES. No bearer/admin auth — just the ES key above.
