---
/**
 * Veiledning overview — "Lag et KI-system" landing page.
 * Based on Figma design 564:9097.
 * Content driven by CMS veiledningOversikt singleton with hardcoded fallbacks.
 */
import Layout from '../../components/layout/Layout.astro';
import AkselIcon from '../../components/shared/AkselIcon.astro';
import { getVeiledningOversikt, getMediaUrl } from '../../lib/umbraco';
import type { VeiledningKort, VerktoyKort } from '../../lib/umbraco';

let cmsData: Awaited<ReturnType<typeof getVeiledningOversikt>> = null;
try {
  cmsData = await getVeiledningOversikt();
} catch (e) {
  console.error('Failed to fetch veiledningOversikt from CMS:', e);
}

const heroLabel = cmsData?.heroLabel || 'Veiledning';
const heroTitle = cmsData?.heroTittel || 'Lag et KI-system';
const heroSubtitle = cmsData?.heroTekst || 'Vi veileder deg gjennom regler, krav og beste praksis.';
const heroImageUrl = cmsData?.heroBilde ? getMediaUrl(cmsData.heroBilde) : undefined;

const seksjon1Title = cmsData?.seksjon1Tittel || 'Før du går i gang';
const forDuGarIGang: { title: string; desc: string; href: string; ikon?: string }[] =
  cmsData?.seksjon1Kort && cmsData.seksjon1Kort.length > 0
    ? cmsData.seksjon1Kort.map((k: VeiledningKort) => ({ title: k.tittel, desc: k.beskrivelse || '', href: k.url || '#', ikon: k.ikon }))
    : [
        { title: 'Definer behovet og hva KI skal løse', desc: '', href: '#', ikon: 'Search' },
        { title: 'Finn ut hvilket risikonivå løsningen din har', desc: 'Hvis det du skal lage har høy risiko, må du få det godkjent før du kan sette det i drift.', href: '#', ikon: 'ShieldLock' },
        { title: 'Forstå KI-loven og GDPR', desc: 'Det er nytt at loven stiller krav både til leverandøren og de som setter KI i drift.', href: '#', ikon: 'Paragraph' },
        { title: 'Forstå krav til data og hva du må gjøre', desc: '', href: '/veiledning/bruk-data-rett', ikon: 'Database' },
      ];

const seksjon2Title = cmsData?.seksjon2Tittel || 'Utvikle KI-systemet';
const utvikleSystemet: { title: string; desc: string; href: string; ikon?: string }[] =
  cmsData?.seksjon2Kort && cmsData.seksjon2Kort.length > 0
    ? cmsData.seksjon2Kort.map((k: VeiledningKort) => ({ title: k.tittel, desc: k.beskrivelse || '', href: k.url || '#', ikon: k.ikon }))
    : [
        { title: 'Dette er kravene du må følge for utforming', desc: '', href: '#', ikon: 'Ruler' },
        { title: 'Valg av språkmodell – utvikle noe eget eller bruke en på markedet', desc: '', href: '#', ikon: 'Chat' },
        { title: 'Dokumentasjon og testing', desc: '', href: '#', ikon: 'FileText' },
        { title: 'Tiltak for sikkerhet og hindre misbruk', desc: '', href: '#', ikon: 'ShieldLock' },
      ];

const verktoyTitle = cmsData?.verktoyTittel || 'Verktøy';
const verktoyCards: { title: string; desc: string; href: string; imageUrl?: string; ikon?: string }[] =
  cmsData?.verktoyKort && cmsData.verktoyKort.length > 0
    ? cmsData.verktoyKort.map((k: VerktoyKort) => ({ title: k.tittel, desc: k.beskrivelse || '', href: k.url || '#', imageUrl: k.bilde ? getMediaUrl(k.bilde) : undefined, ikon: k.ikon }))
    : [
        { title: 'Bias explorer', desc: 'Utforsk hvordan dataskjevheter blir til modellskjevheter', href: '#', ikon: 'BarChart' },
        { title: 'Risikovurdering', desc: 'Modellen til Marie', href: '#', ikon: 'Task' },
      ];

const seoTitle = cmsData?.seoTittel || 'Veiledning';
const seoDesc = cmsData?.seoBeskrivelse || 'Vi veileder deg gjennom regler, krav og beste praksis for å lage et KI-system.';
---

<Layout title={seoTitle} description={seoDesc}>
    <!-- Hero -->
    <section class="veil-hero">
      <div class="veil-hero-inner">
        <div class="veil-hero-text">
          <span class="veil-hero-label">{heroLabel}</span>
          <h1 class="veil-hero-title">{heroTitle}</h1>
          <p class="veil-hero-subtitle">{heroSubtitle}</p>
        </div>
        <div class="veil-hero-image">
          {heroImageUrl ? (
            <img loading="lazy" decoding="async" src={heroImageUrl} alt={heroTitle} class="veil-hero-img" />
          ) : (
            <div class="veil-hero-placeholder"></div>
          )}
        </div>
      </div>
    </section>

    <!-- Seksjon 1 -->
    <section class="veil-section">
      <div class="veil-section-inner">
        <h2 class="veil-section-heading">{seksjon1Title}</h2>
        <div class="veil-cards veil-cards--4">
          {forDuGarIGang.map(card => (
            <a href={card.href} class:list={['veil-card', { 'veil-card--disabled': card.href === '#' }]}>
              <div class="veil-card-content">
                {card.ikon && <AkselIcon name={card.ikon} size={20} />}
                <h3 class="veil-card-title">{card.title}</h3>
                {card.desc && <p class="veil-card-desc">{card.desc}</p>}
              </div>
              <span class="veil-card-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Seksjon 2 -->
    <section class="veil-section">
      <div class="veil-section-inner">
        <h2 class="veil-section-heading">{seksjon2Title}</h2>
        <div class="veil-cards veil-cards--4">
          {utvikleSystemet.map(card => (
            <a href={card.href} class:list={['veil-card', { 'veil-card--disabled': card.href === '#' }]}>
              <div class="veil-card-content">
                {card.ikon && <AkselIcon name={card.ikon} size={20} />}
                <h3 class="veil-card-title">{card.title}</h3>
                {card.desc && <p class="veil-card-desc">{card.desc}</p>}
              </div>
              <span class="veil-card-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Verktøy -->
    <section class="veil-tools">
      <div class="veil-section-inner">
        <h2 class="veil-section-heading">{verktoyTitle}</h2>
        <div class="veil-cards veil-cards--2">
          {verktoyCards.map(card => (
            <a href={card.href} class="veil-tool-card">
              <div class="veil-tool-text">
                {card.ikon && <AkselIcon name={card.ikon} size={20} />}
                <h3 class="veil-tool-title">{card.title}</h3>
                <p class="veil-tool-desc">{card.desc}</p>
              </div>
              {card.imageUrl ? (
                <img loading="lazy" decoding="async" src={card.imageUrl} alt={card.title} class="veil-tool-image" />
              ) : (
                <div class="veil-tool-image"></div>
              )}
              <span class="veil-tool-link">Utforsk &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
</Layout>

<style>
  /* Hero */
  .veil-hero {
    padding: 48px 24px 64px;
    background: #e8f4ec;
  }

  .veil-hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .veil-hero-text {
    flex: 1;
    min-width: 0;
  }

  .veil-hero-label {
    font-size: 14px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    display: block;
    margin-bottom: 8px;
  }

  .veil-hero-title {
    font-size: 40px;
    font-weight: 400;
    color: #000;
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .veil-hero-subtitle {
    font-size: 18px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
    line-height: 1.5;
  }

  .veil-hero-image {
    width: 300px;
    flex-shrink: 0;
  }

  .veil-hero-placeholder {
    width: 100%;
    height: 200px;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 8px;
    opacity: 0.4;
  }

  .veil-hero-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  @media (max-width: 639px) {
    .veil-hero-image {
      display: none;
    }
  }

  /* Sections */
  .veil-section {
    padding: 48px 24px;
  }

  .veil-section-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .veil-section-heading {
    font-size: 28px;
    font-weight: 700;
    font-style: italic;
    color: #000;
    margin: 0 0 24px;
    line-height: 1.3;
  }

  /* Cards grid */
  .veil-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .veil-cards--4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .veil-cards--2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .veil-cards--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .veil-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    background: #e2f0fc;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    min-height: 160px;
    transition: box-shadow 0.15s;
  }

  .veil-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .veil-card--disabled {
    cursor: default;
    background-color: #edf4fa;
  }

  .veil-card-content {
    flex: 1;
  }

  .veil-card-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px;
    color: #000;
    line-height: 1.4;
  }

  .veil-card-desc {
    font-size: 14px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
    line-height: 1.5;
  }

  .veil-card-arrow {
    font-size: 18px;
    color: rgba(0, 0, 0, 0.4);
    margin-top: 12px;
    align-self: flex-end;
  }

  /* Tools section */
  .veil-tools {
    padding: 48px 24px 64px;
    background: #e8f4ec;
  }

  .veil-tool-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: white;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
    min-height: 200px;
  }

  .veil-tool-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .veil-tool-text {
    margin-bottom: 16px;
  }

  .veil-tool-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 4px;
    color: #000;
  }

  .veil-tool-desc {
    font-size: 14px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
    line-height: 1.5;
  }

  .veil-tool-image {
    flex: 1;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 8px;
    min-height: 100px;
    opacity: 0.4;
  }

  .veil-tool-link {
    font-size: 14px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.6);
    margin-top: 12px;
    align-self: flex-end;
  }
</style>
