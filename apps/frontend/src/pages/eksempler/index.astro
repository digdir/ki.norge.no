---
import Layout from '../../components/layout/Layout.astro';
import { getEksempler, getEksemplerOversikt, getMediaUrl, type Eksempel } from '../../lib/umbraco';

let eksempler: Eksempel[] = [];
let oversikt = null;
try {
  const [oversiktData, eksemplerRes] = await Promise.all([
    getEksemplerOversikt(),
    getEksempler(),
  ]);
  oversikt = oversiktData;
  eksempler = eksemplerRes.data;
} catch (e) {
  console.error('Failed to fetch eksempler:', e);
}

const heroTittel = oversikt?.heroTittel || 'Eksempler';
const heroIngress = oversikt?.heroIngress || 'Lær av andre offentlige virksomheters erfaringer med kunstig intelligens.';
const seoTitle = oversikt?.seoTittel || heroTittel;
const seoDesc = oversikt?.seoBeskrivelse || heroIngress;
---

<Layout title={seoTitle} description={seoDesc}>
  <div class="eksempler-page grid" data-layout-block="content">
    <div class="eksempler-title-bar col-center-6">
      <h1 class="eksempler-title">{heroTittel}</h1>
      <p class="eksempler-lead">{heroIngress}</p>
    </div>

    <div class="eksempler-grid col-center-10">
      {eksempler.map(e => (
        <a href={`/eksempler/${e.slug}`} class="eksempel-card">
          <div class="eksempel-card-image">
            {e.artikkelBilde ? (
              <img src={getMediaUrl(e.artikkelBilde)} alt={e.bildeAlt || ''} loading="lazy" />
            ) : (
              <div class="eksempel-card-placeholder"></div>
            )}
          </div>
          <div class="eksempel-card-text">
            <h2 class="eksempel-card-title">{e.tittel}</h2>
            {e.ingress && <p class="eksempel-card-lead">{e.ingress}</p>}
          </div>
        </a>
      ))}
    </div>

    {eksempler.length === 0 && (
      <p class="empty-state col-center-6">Ingen eksempler funnet.</p>
    )}
  </div>
</Layout>

<style>
  .eksempler-title {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .eksempler-lead {
    font-size: 21px;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    margin: 0;
  }
  .eksempler-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .eksempler-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }
  @media (min-width: 1024px) {
    .eksempler-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .eksempel-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }
  .eksempel-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }
  .eksempel-card-image {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: var(--image-fallback-bg, #D9D9D9);
  }
  .eksempel-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .eksempel-card-placeholder {
    width: 100%;
    height: 100%;
  }
  .eksempel-card-title {
    font-size: 21px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .eksempel-card-lead {
    font-size: 16px;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
    line-height: 1.5;
  }
  .empty-state {
    color: rgba(0, 0, 0, 0.55);
    text-align: center;
  }
</style>
