---
// Rendrer forsidens modul-blokker (forside.seksjoner) i redaktørens rekkefølge.
// Komponenten gjør INGEN fetch — pooler (artikler/veiledninger/arrangement/eksempler) sendes inn.
// Hva som skal vises avgjøres i lib/forside-seksjoner.ts, her bare rendres det.
import Hero from './Hero.astro';
import NewsCard from '../shared/NewsCard.astro';
import CardGrid from '../shared/CardGrid.astro';
import EventCard from '../shared/EventCard.astro';
import ArrowLink from '../shared/ArrowLink.astro';
import ExampleLinkCards from '../shared/ExampleLinkCards.astro';
import TextWithImage from '../shared/TextWithImage.astro';
import AkselIcon from '../shared/AkselIcon.astro';
import { getMediaUrl, getCardImage, MEDIA_WIDTH, type ForsideSeksjon, type Kalenderhendelse, type VeiledningGuide } from '../../lib/umbraco';
import { velgAktuelt, velgLaerAvAndre, velgLenke, velgVeiledning } from '../../lib/forside-seksjoner';
import { hendelseTilEventCard } from '../../lib/kalender';
import { splitLastWord } from '../../lib/text';

interface Props {
  seksjoner: ForsideSeksjon[];
  latestArticles: any[];
  eksempler?: any[];
  upcomingEvents?: Kalenderhendelse[];
  harTidligereArrangementer?: boolean;
  veiledninger?: VeiledningGuide[];
  enkleVeiledninger?: any[];
}
const { seksjoner, latestArticles, eksempler = [], upcomingEvents = [], harTidligereArrangementer = false, veiledninger = [], enkleVeiledninger = [] } = Astro.props;
---

{seksjoner.map((block) => {
  if (block.contentType === 'forsideHero') {
    return (
      <Hero
        overskrift={block.overskriftHtml ?? block.overskrift}
        komIGangTekst={block.komIGangTekst}
        lenketekst={block.lenketekst}
        lenkeUrl={block.lenkeUrl}
        illustrasjon={block.illustrasjon ? getMediaUrl(block.illustrasjon) : undefined}
      />
    );
  }

  if (block.contentType === 'forsideAktuelt') {
    const aktuelt = velgAktuelt(block, { artikler: latestArticles, enkleVeiledninger, veiledninger, eksempler });
    if (!aktuelt) return null;
    const { featured, kort: smaa, lenke } = aktuelt;
    return (
      <section class="aktuelt" data-layout-block="edge">
        <div data-layout-block="content">
          {block.overskrift && <h2 class="ds-heading section-heading" data-size="lg">{block.overskrift}</h2>}
          {featured && (
            <NewsCard
              href={featured.href}
              title={featured.tittel}
              tagColor="brand1"
              lead={featured.lead}
              image={featured.image}
              imageAlt=""
              variant="featured"
            />
          )}
          {smaa.length > 0 && (
            <CardGrid columns={3} divided>
              {smaa.map((article) => (
                <NewsCard
                  href={article.href}
                  title={article.tittel}
                  variant="image"
                  image={article.image}
                  date={article.publishedAt}
                />
              ))}
            </CardGrid>
          )}
          {lenke && <ArrowLink href={lenke.href} text={lenke.tekst} />}
        </div>
      </section>
    );
  }

  if (block.contentType === 'forsideArrangementer') {
    // Redaktørvalgt arrangement overstyrer auto. Tomt → neste kommende.
    const valgt = (block.arrangementId && upcomingEvents.find((e) => e.id === block.arrangementId)) || upcomingEvents[0] || null;
    const lenke = velgLenke(block);
    // Uten kommende arrangement peker seksjonen til arkivet i stedet for å forsvinne.
    // Er arkivet også tomt har seksjonen ingenting å vise, og da skjuler vi den.
    if (!valgt && !harTidligereArrangementer) return null;
    return (
      <section class="arrangementer" data-layout-block="edge">
        <div class="arrangementer-section" data-layout-block="content">
          {block.overskrift && <h2 class="ds-heading section-heading" data-size="lg">{block.overskrift}</h2>}
          {valgt ? (
            <EventCard {...hendelseTilEventCard(valgt)} />
          ) : (
            <p class="arrangementer-tom">Ingen kommende arrangementer</p>
          )}
          {valgt
            ? lenke && <ArrowLink href={lenke.href} text={lenke.tekst} />
            : <ArrowLink href={lenke?.href || '/kalender'} text="Se tidligere arrangementer" />}
        </div>
      </section>
    );
  }

  if (block.contentType === 'forsideVeiledning') {
    const veiledning = velgVeiledning(block, veiledninger);
    if (!veiledning) return null;
    const { tittel, ingress, href, image } = veiledning;
    return (
      <section class="veiledning-section" data-layout-block="edge">
        <div data-layout-block="content">
          <TextWithImage
            title={tittel}
            href={href}
            image={image}
            imageAlt="Illustrasjon"
            label={block.label}
          >
            {ingress && <p slot="body">{ingress}</p>}
          </TextWithImage>
        </div>
      </section>
    );
  }

  if (block.contentType === 'forsideLaerAvAndre') {
    const laer = velgLaerAvAndre(block, eksempler);
    if (!laer) return null;
    const { kort, lenke } = laer;
    return (
      <section data-layout-block="content" class="examples-section">
        {block.overskrift && <h2 class="ds-heading section-heading" data-size="lg">{block.overskrift}</h2>}
        <ExampleLinkCards cards={kort.map((c, i) => ({ ...c, tag: block.kortTag, variant: (i === 0 ? 'medium' : 'light') as 'dark' | 'medium' | 'light' }))} />
        {lenke && <ArrowLink href={lenke.href} text={lenke.tekst} />}
      </section>
    );
  }

  if (block.contentType === 'forsideForstaRegelverket') {
    const lenker = (block.forstaLenkeIds ?? [])
      .map((id) => {
        const art = latestArticles.find((a: any) => a.id === id);
        if (art) return { href: `/artikler/${art.slug}`, title: art.tittel };
        const veil = veiledninger.find((v) => v.id === id);
        if (veil) return { href: `/veiledning/${veil.slug}`, title: veil.tittel };
        const enkel = enkleVeiledninger.find((v: any) => v.id === id);
        if (enkel) return { href: `/veiledning/${enkel.slug}`, title: enkel.tittel };
        return null;
      })
      .filter((l): l is { href: string; title: string } => l !== null);
    if (lenker.length === 0) return null;
    return (
      <section class="forsta-section" data-layout-block="content">
        {block.overskrift && <h2 class="ds-heading section-heading" data-size="lg">{block.overskrift}</h2>}
        <ul class="forsta-liste">
          {lenker.map((l) => (
            <li>
              <a class="forsta-lenke" href={l.href}>
                <span>{l.title}</span>
                <span class="forsta-pil" aria-hidden="true"><AkselIcon name="ArrowRight" size={20} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  }

  if (block.contentType === 'forsideSandkasse') {
    const sandkasseLinkId = `sandkasse-link-${block.id}`;
    // Pilen limes til siste ord så den ikke brekker alene (#464)
    const sandkasseTittel = splitLastWord(block.overskrift ?? '');
    // Vakta må stå på den ferdige URLen, ikke på mediet. Delivery API sender
    // picker-objekter som finnes men er tomme, så `block.illustrasjon &&` slapp
    // gjennom og rendret <img src="">.
    const sandkasseBilde = getCardImage(block.illustrasjon);
    return (
      <section class="sandkasse-section" data-layout-block="content">
        <div class="sandkasse-card" data-clickdelegatefor={sandkasseLinkId}>
          <div class="sandkasse-card-image">
            {sandkasseBilde && (
              <img
                src={sandkasseBilde.src}
                srcset={sandkasseBilde.srcset}
                sizes={sandkasseBilde.sizes}
                width={sandkasseBilde.width}
                height={sandkasseBilde.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="sandkasse-card-text">
            <h2 class="sandkasse-title">
              <a id={sandkasseLinkId} href={block.lenkeUrl || '/sandkasse'}>
                {sandkasseTittel.head}<span class="u-nowrap">{sandkasseTittel.last}<span class="sandkasse-arrow" aria-hidden="true"><AkselIcon name="ArrowRight" size={20} /></span></span>
              </a>
            </h2>
            <p class="sandkasse-desc ds-paragraph" data-size="lg">{block.tekst || 'Juridisk veiledning for deg som ønsker å utvikle et risikofylt KI-prosjekt.'}</p>
          </div>
        </div>
      </section>
    );
  }

  return null;
})}

<style>
  :global(main) > * + * {
    margin-top: var(--ds-size-6);
  }

  .section-heading {
    margin: 0 0 var(--ds-size-8);
  }

  /* ── Aktuelt ─────────────────────────────────────────── */
  .aktuelt {
    background-color: var(--ds-color-brand2-surface-default);
  }
  
  .aktuelt :global(.card-grid) {
    margin-bottom: var(--ds-size-6);
  }

  .aktuelt :global(.news-card--featured) {
    margin-bottom: var(--ds-size-8);
  }

  /* ── Kommende arrangementer (egen seksjon, uten rosa strek) ── */
  .arrangementer {
    background-color: var(--ds-color-brand2-surface-default);
    margin-block-start: 0 !important;
  }

  .arrangementer-section :global(.event-card) {
    margin-bottom: var(--ds-size-6);
  }

  .arrangementer-tom {
    margin: 0 0 var(--ds-size-6);
    padding: var(--ds-size-6);
    background-color: var(--ds-color-neutral-background-default);
  }

  /* ── Lær av andre ────────────────────────────────────── */
  .examples-section {
    & :global(.arrow-link) {
      margin-block-start: var(--ds-size-6);
    }
  }

  /* ── Forstå regelverket (enkel lenkeliste) ───────────── */
  .forsta-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .forsta-liste {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--ds-size-10);
    }
  }

  .forsta-lenke {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-size-4);
    padding-block: var(--ds-size-4);
    border-block-end: 1px solid var(--ds-color-surface-active);
    color: var(--ds-color-text-default);
    text-decoration: none;
    font-size: var(--ds-heading-xs-font-size);
  }

  .forsta-lenke:hover span:first-child {
    text-decoration: underline;
  }

  .forsta-pil {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: var(--ds-color-base-default);
  }

  /* ── Sandkassen ──────────────────────────────────────── */
  .sandkasse-section {
    padding-block: var(--ds-size-12);

    @media (max-width: 768px) {
      padding-block: var(--ds-size-8);
    }
  }

  .sandkasse-card {
    cursor: pointer;
    display: grid;
    grid-template-columns: 1fr 2fr;
    border: 6px solid var(--ds-color-brand2-border-default);
    background-color: var(--ds-color-brand2-background-default);

    &:focus-within {
      box-shadow: var(--dsc-focus-boxShadow);
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }

    &:has(.\:click-delegate-hover) a {
      text-decoration: underline;
    }
    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .sandkasse-card-image {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--ds-size-8);

    @media (max-width: 768px) {
      padding: var(--ds-size-4);
    }
  }

  .sandkasse-card-image img {
    width: 100%;
    max-width: 300px;
    height: auto;
    object-fit: contain;
  }

  .sandkasse-card-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--ds-size-3);
    padding: var(--ds-size-10);

    @media (max-width: 768px) {
      padding: var(--ds-size-4);
    }
  }

  .sandkasse-title {
    font-size: var(--ds-heading-lg-font-size);
    margin: 0;
    line-height: 1.3;

    & a {
      color: inherit;
      text-decoration: none;

      &.\:click-delegate-hover {
        text-decoration: underline;
      }

      &:focus-visible {
        outline: none;
        box-shadow: none;
      }
    }
  }

  .sandkasse-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    border-radius: var(--ds-border-radius-full);
    background-color: var(--ds-color-surface-tinted);
    vertical-align: middle;
    margin-left: var(--ds-size-2);
  }

  .sandkasse-desc {
    margin: 0;
    max-width: 400px;
  }
</style>
