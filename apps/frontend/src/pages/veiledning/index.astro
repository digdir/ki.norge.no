---
/**
 * Veiledning overview — "Guider & veiledning" landing page.
 * Sections: Hero, Featured (Kom i gang), Rich link list (Steg for steg),
 * Simple link list (Forstå regelverket), Case cards (Lær av andre).
 */
import Layout from '../../components/layout/Layout.astro';
import TextWithImage from '../../components/shared/TextWithImage.astro';
import ExampleLinkCards from '../../components/shared/ExampleLinkCards.astro';
import ArrowLink from '../../components/shared/ArrowLink.astro';
import AkselIcon from '../../components/shared/AkselIcon.astro';
import { getVeiledningOversikt, getVeiledningGuider, getCaser, getPlainText, getMediaUrl } from '../../lib/umbraco';

let cmsData: Awaited<ReturnType<typeof getVeiledningOversikt>> = null;
let guides: Awaited<ReturnType<typeof getVeiledningGuider>> = { data: [], meta: { pagination: { page: 1, pageSize: 0, pageCount: 0, total: 0 } } };
let cases: Awaited<ReturnType<typeof getCaser>> = { data: [], meta: { pagination: { page: 1, pageSize: 0, pageCount: 0, total: 0 } } };

try {
  [cmsData, guides, cases] = await Promise.all([
    getVeiledningOversikt(),
    getVeiledningGuider(),
    getCaser(),
  ]);
} catch (e) {
  console.error('Failed to fetch veiledning page data:', e);
}

const heroTitle = cmsData?.heroTittel || 'Guider & veiledning';
const heroText = cmsData?.heroTekst || 'Lurer du på hva det er lurt å tenke på når du bruker KI eller lager KI-løsninger? Her finner du veiledninger laget og kvalitetssikret av jurister og andre fagfolk.';
const heroImageUrl = cmsData?.heroBilde ? getMediaUrl(cmsData.heroBilde) : undefined;

// Featured article — "Kom i gang"
const featuredTitle = cmsData?.seksjon1Kort?.[0]?.tittel || 'Hva er KI og hva kan du bruke det til?';
const featuredDesc = cmsData?.seksjon1Kort?.[0]?.beskrivelse || 'Lær om hva kunstig intelligens er, hva du kan bruke det til og hvordan du kommer i gang.';
const featuredHref = cmsData?.seksjon1Kort?.[0]?.url || '/veiledning/kom-i-gang';
const featuredLabel = cmsData?.seksjon1Tittel || 'Kom i gang';
const featuredImage = heroImageUrl || '/woman-speaking.svg';

// Rich link list — "Steg for steg" (guides with descriptions)
const richLinks = guides.data.length > 0
  ? guides.data.map(g => ({
      title: g.tittel,
      desc: g.introTekst ? getPlainText(g.introTekst, 160) : '',
      href: `/veiledning/${g.slug}`,
    }))
  : (cmsData?.seksjon2Kort || []).map(k => ({
      title: k.tittel,
      desc: k.beskrivelse || '',
      href: k.url || '#',
    }));

// Simple link list — "Forstå regelverket"
const simpleLinks = cmsData?.verktoyKort
  ? cmsData.verktoyKort.map(k => ({
      title: k.tittel,
      href: k.url || '#',
    }))
  : [
      { title: 'Hva innebærer KI-loven?', href: '/artikler/ki-loven' },
      { title: 'Strategier og lovverk fra EU', href: '/artikler/eu-strategi' },
      { title: 'Forstå KI-standardene', href: '/artikler/ki-standardene' },
    ];

// Case cards — "Lær av andre"
const caseCards = cases.data.length > 0
  ? cases.data.slice(0, 4).map(c => ({
      title: c.tittel,
      href: `/caser/${c.slug}`,
      tag: 'Eksempel',
    }))
  : [
      { title: 'Raskere analyser av dokumenter med KI-chat i Digdir', href: '/caser/ki-chat-staten', tag: 'Eksempel' },
      { title: 'Politiet - Fra tale til tekst på minutter', href: '/caser/politiet-tale-til-tekst', tag: 'Eksempel' },
    ];

const seoTitle = cmsData?.seoTittel || 'Guider & veiledning';
const seoDesc = cmsData?.seoBeskrivelse || heroText;
---

<Layout title={seoTitle} description={seoDesc}>
  <!-- Hero -->
  <section class="veil-hero" data-layout-block="content">
    <h1 class="ds-heading" data-size="xl">{heroTitle}</h1>
    <p class="ds-paragraph veil-hero-text" data-size="xl">{heroText}</p>
  </section>

  <!-- Kom i gang — Featured article with illustration -->
  <section class="veil-featured" data-layout-block="content">
    <TextWithImage title={featuredTitle} href={featuredHref} image={featuredImage} imageAlt="Illustrasjon">
      <p class="veil-featured-label">{featuredLabel}</p>
      <p slot="body">{featuredDesc}</p>
    </TextWithImage>
  </section>

  <!-- Steg for steg — Rich link list -->
  {richLinks.length > 0 && (
    <section class="veil-rich-links" data-layout-block="edge">
      <div data-layout-block="content">
        <h2 class="ds-heading veil-section-heading" data-size="xs">{cmsData?.seksjon2Tittel || 'Steg for steg'}</h2>
        <ul class="veil-rich-list">
          {richLinks.map(link => (
            <li class="veil-rich-item">
              <a href={link.href} class="veil-rich-link">
                <div class="veil-rich-link-text">
                  <h3 class="ds-heading" data-size="sm">{link.title}</h3>
                  {link.desc && <p class="veil-rich-link-desc">{link.desc}</p>}
                </div>
                <span class="veil-rich-link-arrow" aria-hidden="true">
                  <AkselIcon name="ArrowRight" size={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Forstå regelverket — Simple link list -->
  {simpleLinks.length > 0 && (
    <section class="veil-simple-links" data-layout-block="content">
      <h2 class="ds-heading veil-section-heading" data-size="xs">{cmsData?.verktoyTittel || 'Forstå regelverket'}</h2>
      <ul class="veil-simple-list">
        {simpleLinks.map(link => (
          <li class="veil-simple-item">
            <a href={link.href} class="veil-simple-link">
              <span class="veil-simple-link-title">{link.title}</span>
              <span class="veil-simple-link-arrow" aria-hidden="true">
                <AkselIcon name="ArrowRight" size={16} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Lær av andre — Case cards -->
  {caseCards.length > 0 && (
    <section class="veil-cases" data-layout-block="content">
      <h2 class="ds-heading veil-section-heading" data-size="xs">Lær av andre</h2>
      <ExampleLinkCards cards={caseCards} />
      <ArrowLink href="/caser" text="Se alle eksempler" />
    </section>
  )}
</Layout>

<style>
  /* Hero */
  .veil-hero {
    padding-top: var(--ds-size-10);
    padding-bottom: var(--ds-size-6);
  }

  .veil-hero-text {
    margin: var(--ds-size-4) 0 0;
  }

  /* Featured */
  .veil-featured {
    padding-block: var(--ds-size-8);
  }

  .veil-featured-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--ds-color-text-subtle);
    margin: 0;
  }

  /* Section headings */
  .veil-section-heading {
    margin: 0 0 var(--ds-size-6);
    font-style: italic;
  }

  /* Rich link list */
  .veil-rich-links {
    background-color: var(--ds-color-accent-surface-tinted);
    padding-block: var(--ds-size-10);
  }

  .veil-rich-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .veil-rich-item {
    background: var(--ds-color-surface-default);
    border-radius: var(--ds-border-radius-lg);
    transition: box-shadow 0.15s;
  }

  .veil-rich-item:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .veil-rich-link {
    display: flex;
    align-items: center;
    gap: var(--ds-size-6);
    padding: var(--ds-size-6) var(--ds-size-8);
    text-decoration: none;
    color: inherit;

    &:focus-visible {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
      border-radius: var(--ds-border-radius-lg);
    }
  }

  .veil-rich-link-text {
    flex: 1;
    min-width: 0;

    & h3 {
      margin: 0;
      color: var(--ds-color-accent-text-default);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1.5px;
    }
  }

  .veil-rich-link-desc {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ds-color-text-subtle);
    margin: var(--ds-size-2) 0 0;
  }

  .veil-rich-link-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--ds-color-accent-surface-tinted);
    color: var(--ds-color-accent-text-default);
    flex-shrink: 0;
  }

  /* Simple link list */
  .veil-simple-links {
    padding-block: var(--ds-size-10);
  }

  .veil-simple-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .veil-simple-item {
    border-bottom: 1px solid var(--ds-color-border-subtle);
  }

  .veil-simple-item:first-child {
    border-top: 1px solid var(--ds-color-border-subtle);
  }

  .veil-simple-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-size-4);
    padding: var(--ds-size-5) var(--ds-size-2);
    text-decoration: none;
    color: inherit;

    &:hover .veil-simple-link-title {
      text-decoration: underline;
    }

    &:focus-visible {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
    }
  }

  .veil-simple-link-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--ds-color-accent-text-default);
  }

  .veil-simple-link-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--ds-color-accent-surface-tinted);
    color: var(--ds-color-accent-text-default);
    flex-shrink: 0;
  }

  /* Case cards */
  .veil-cases {
    padding-block: var(--ds-size-10);
  }
</style>
