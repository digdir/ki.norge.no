---
interface SubStep {
  title: string;
  slug: string;
}
interface Step {
  number: number;
  title: string;
  substeps: SubStep[];
}
interface Props {
  steps: Step[];
  guideSlug: string;
}
const { steps, guideSlug } = Astro.props;
---
<nav aria-label="Steg i veiledningen">
  <ol class="step-navigator">
    {steps.map(step => (
      <li class="step-group">
        <h3 class="step-heading ds-heading">{step.title}</h3>
        <ol class="step-pills" aria-label={`Understeg for ${step.title}`}>
          {step.substeps.map((sub) => (
            <li class="step-pill-item">
              <a href={`/veiledning/${guideSlug}/${sub.slug}`} class="step-pill ds-chip" data-variant="secondary" data-size="lg">{sub.title}</a>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
</nav>
<style>
  .step-navigator {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-14);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step-counter;
  }

  .step-group {
    counter-increment: step-counter;
  }

  .step-heading {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    margin: 0 0 var(--ds-size-4);
    color: var(--ds-color-text-default);
    font-family: var(--ds-font-family);
  }

  .step-heading::before {
    color: var(--ds-color-base-default);
    font-family: var(--ds-font-family);
    content: counter(step-counter) ".";
    font-weight: 900;
    line-height: 1;
    flex-shrink: 0;
    margin-block: auto;
    font-size: var(--ds-heading-lg-font-size);
  }

  .step-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--ds-size-2);
    row-gap: var(--ds-size-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step-pill-item {
    display: contents;
  }

  .step-pill {
    border-radius: var(--ds-border-radius-full);
    text-decoration: none;
    color: var(--ds-color-text-default);
  }

  .step-pill-item:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: var(--ds-size-4);
    height: var(--ds-size-4);
    vertical-align: middle;
    background-color: var(--ds-color-text-subtle);
    mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2214%22%20height%3D%2215%22%20viewBox%3D%220%200%2014%2015%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M13.707%208.071a1%201%200%200%200%200-1.414L7.343.293A1%201%200%200%200%205.93%201.707l5.657%205.657-5.657%205.657a1%201%200%201%200%201.414%201.414zM0%207.364v1h13v-2H0z%22%20fill%3D%22%2386567a%22%2F%3E%3C%2Fsvg%3E");
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    flex-shrink: 0;
  }
</style>
