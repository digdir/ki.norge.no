{
  "name": "ki-norge-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.cjs --project=chromium",
    "test:e2e:ui": "playwright test --config=playwright.config.cjs --ui",
    "test:e2e:update": "playwright test --config=playwright.config.cjs --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@astrojs/node": "10.1.2",
    "@astrojs/react": "5.0.6",
    "@astrojs/sitemap": "3.7.3",
    "@digdir/designsystemet-css": "^1.15.0",
    "@digdir/designsystemet-react": "^1.15.0",
    "@navikt/aksel-icons": "^8.11.0",
    "astro": "6.4.2",
    "clsx": "^2.1.1",
    "linkedom": "^0.18.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "1.60.0",
    "@types/node": "^25.9.1",
    "postcss-nesting": "^14.0.0",
    "vitest": "^4.1.7"
  }
}
