---
import Layout from '../../components/layout/Layout.astro';
import NewsCard from '../../components/shared/NewsCard.astro';
import { getArtikler, getArtiklerOversikt, getPlainText, velgKortbilde, type Artikkel } from '../../lib/umbraco';
import { collectionPageSchema, breadcrumbSchema } from '../../lib/seo';

const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

let articles: Artikkel[] = [];
let oversikt = null;
try {
  // Veiledningsguidene ble bare hentet for artikkelRelatert-blokken, som denne
  // sida ikke lenger rendrer. Da slipper vi også det tredje API-kallet.
  const [artiklerRes, oversiktRes] = await Promise.all([
    getArtikler(undefined, { preview: isPreview }),
    getArtiklerOversikt({ preview: isPreview }),
  ]);
  articles = artiklerRes.data;
  oversikt = oversiktRes;
} catch (e) {
  console.error('Failed to fetch artikler:', e);
  // CMS-henting feilet: ikke cache den degraderte renderen (se middleware).
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const heroTittel = oversikt?.heroTittel;
const heroSubtittel = oversikt?.heroSubtittel || '';
const seoTitle = oversikt?.seoTittel || heroTittel;
const seoDesc = oversikt?.seoBeskrivelse || 'Nyheter, analyser og artikler om kunstig intelligens i norsk offentlig sektor.';

// Nyest først, sortert på publishedAt, som er nøyaktig feltet kortene viser i
// merkelappen. Det er hele poenget: sorterer lista på noe annet enn det som står
// på kortet, ser rekkefølgen feil ut selv om begge datoene isolert sett stemmer.
// Datokjeden bak publishedAt (redaktørens publisertDato, så byline-datoen, så
// createDate) settes ett sted, i mapItem, så denne sida slipper å kjenne den.
//
// API-et kan ikke sortere for oss: getArtikler henter med sort=updateDate:desc,
// og updateDate er verken det kortet viser eller det redaktøren kan overstyre.
// Manglende eller ugyldig dato gir 0, så artikkelen havner sist i stedet for på
// en tilfeldig plass. Uten isFinite-sjekken blir en ubrukelig datostreng til NaN,
// og en komparator som returnerer NaN gir uforutsigbar rekkefølge.
//
// Når #770 har landet finnes sammenlignPublisertDato i umbraco.ts med nøyaktig
// denne semantikken. Da bør denne komparatoren byttes ut med den, så det er én
// implementasjon igjen.
const tid = (a: Artikkel) => {
  const t = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
  return Number.isFinite(t) ? t : 0;
};
const sorterte = [...articles].sort((a, b) => tid(b) - tid(a));

// velgKortbilde gjor URLen absolutt mot CMS-hosten og gir srcset + sideforhold.
// Rekkefolgen er lenkekortbilde, saa hovedbilde. Blokk-overstyringen falt bort
// sammen med seksjonene.
function getCardBilde(article: Artikkel) {
  return velgKortbilde(article);
}

function getTag(article: Artikkel) {
  if (article.bakgrunn === 'lyseblaa') return 'Offentlig sektor';
  return 'KI-strategien';
}

// Toppen er fortsatt redaktørens valg. Uten valgt artikkel er det den nyeste,
// og «nyeste» følger samme datokjede som resten av lista.
const featured = (oversikt?.featuredArtikkelId
  ? sorterte.find(a => a.id === oversikt!.featuredArtikkelId)
  : null) ?? sorterte[0];

// Fremhevet artikkel vises ikke en gang til lenger nede. Samme kort to ganger på
// én skjerm leses som en feil. Prisen er at en gammel fremhevet artikkel løftes
// ut av kronologien, og det er iboende i å ha en manuell topplass.
const rest = sorterte.filter(a => a.id !== featured?.id);
const compactCards = rest.slice(0, 3);
const imageGridTop = rest.slice(3, 6);
const imageGridBottom = rest.slice(6, 8);
const bottomFeatured = rest[8];
const remaining = rest.slice(9);

const collectionJsonLd = collectionPageSchema({
  name: heroTittel || seoTitle || 'Artikler',
  description: seoDesc,
  url: '/artikler',
  items: sorterte.map((a) => ({ name: a.tittel, url: `/artikler/${a.slug}` })),
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Hjem', url: '/' },
  { name: heroTittel || 'Artikler', url: '/artikler' },
]);
---

<Layout title={seoTitle} description={seoDesc} ogImage={oversikt?.seoBilde?.url}>
  <Fragment slot="head">
    {articles.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd).replace(/</g, '\\u003c')} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <section data-layout-block="content" class="artikler-page">
    <header class="artikler-header">
      {heroTittel && <h1 class="ds-heading" data-size="xl">{heroTittel}</h1>}
      {heroSubtittel && <p class="artikler-subtitle">{heroSubtittel}</p>}
    </header>

    {featured && (
      <NewsCard
        variant="featured"
        href={`/artikler/${featured.slug}`}
        title={featured.tittel}
        lead={featured.ingress || getPlainText(featured.innhold, 150)}
        image={getCardBilde(featured)}
        imageAlt={featured.bildeAlt}
      />
    )}

    {compactCards.length > 0 && (
      <div class="compact-grid">
        {compactCards.map(article => (
          <NewsCard
            variant="small"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            tag={getTag(article)}
            date={article.publishedAt}
          />
        ))}
      </div>
    )}

    {imageGridTop.length > 0 && (
      <div class="image-grid">
        {imageGridTop.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getCardBilde(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {imageGridBottom.length > 0 && (
      <div class="image-grid image-grid--2col">
        {imageGridBottom.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getCardBilde(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {bottomFeatured && (
      <NewsCard
        variant="featured"
        href={`/artikler/${bottomFeatured.slug}`}
        title={bottomFeatured.tittel}
        lead={bottomFeatured.ingress || getPlainText(bottomFeatured.innhold, 150)}
        image={getCardBilde(bottomFeatured)}
        imageAlt={bottomFeatured.bildeAlt}
      />
    )}

    {remaining.length > 0 && (
      <div class="image-grid">
        {remaining.map(article => (
          <NewsCard
            variant="image"
            href={`/artikler/${article.slug}`}
            title={article.tittel}
            date={article.publishedAt}
            image={getCardBilde(article)}
            imageAlt={article.bildeAlt}
          />
        ))}
      </div>
    )}

    {articles.length === 0 && (
      <p class="empty-state">Ingen artikler funnet.</p>
    )}
  </section>
</Layout>

<style>
  .artikler-page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-10);
    padding-block: var(--ds-size-10) var(--ds-size-16);
  }

  .artikler-header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }

  .artikler-subtitle {
    margin: 0;
    font-size: var(--ds-body-lg-font-size);
    line-height: var(--ds-body-lg-line-height);
    color: var(--ds-color-neutral-text-subtle);
  }

  .artikler-gruppe {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
  }

  .section-heading {
    margin: 0;
  }

  .compact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ds-size-12);
    border-block: 1px solid var(--ds-color-surface-active);
    padding-block: var(--ds-size-9);
    
    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: var(--ds-size-6);
    }
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-12);
    border-block-end: 1px solid var(--ds-color-surface-active);
    padding-block-end: var(--ds-size-9);

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .image-grid--2col {
    @media (min-width: 1024px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--ds-size-12);
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
