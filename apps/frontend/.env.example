# Lokal utvikling. Prod og tt02 leser IKKE denne fila, de får vars fra
# wrangler.jsonc og hemmeligheter fra `wrangler secret put --env <miljø>`.

# Umbraco CMS. Peker på prod-CMS-et som standard, så du får ekte innhold uten å
# kjøre CMS-et lokalt. Vil du mot en lokal instans, kjør `pnpm run cms:dev` og
# sett begge to til http://localhost:5000.
UMBRACO_URL=https://cms.ki.norge.no
UMBRACO_API_KEY=your-api-key-for-preview  # Må matche Umbraco:CMS:DeliveryApi:ApiKey

# Hosten nettleseren henter media fra. Brukes som rent prefiks foran /media/...,
# så den skal ikke ha sti (heller ikke /umbraco) og ikke skråstrek på slutten.
# Skal peke samme sted som UMBRACO_URL, ellers matcher ikke medie-IDene og
# bildene brekker. I prod er den med vilje workers.dev-proxyen, se wrangler.jsonc.
UMBRACO_PUBLIC_URL=https://cms.ki.norge.no

# Admin-tilgang til /status via /admin-tilgang?key=
ADMIN_SECRET=change-me

# Cloudflare cache purge. scripts/purge-cache.mjs kjører etter hver deploy, så
# edgen ikke fortsetter å servere HTML som peker på slettede _astro-filer.
# Mangler de, stopper deployen.
#   ZONE_ID:      Cloudflare-dashbordet -> norge.no -> Overview -> Zone ID
#   PURGE_TOKEN:  My Profile -> API Tokens -> Create Custom Token
#                 Permissions: Zone -> Cache Purge -> Purge
#                 Zone Resources: Include -> Specific zone -> norge.no
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PURGE_TOKEN=cfat_...

# Hybrid-søk (Elastic), kun server-side, driver søkemodalen via /api/search.
# Valgfritt lokalt: uten ES_API_KEY faller søket tilbake på Umbracos enkle søk,
# som gir flere og dårligere sorterte treff enn prod. Brukes ikke til indeksering.
ES_ENDPOINT=https://<project>.es.<region>.azure.elastic.cloud
ES_API_KEY=your-elasticsearch-api-key
KI_INDEX=ki-content
