---
import Layout from '../../components/layout/Layout.astro';
import ArticleBlocksRenderer from '../../components/shared/ArticleBlocksRenderer.astro';

import { getEksempel, getEksempler, getPlainText, getMediaUrl, type Eksempel } from '../../lib/umbraco';
import { eksempelSchema, breadcrumbSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article: Eksempel | null = await getEksempel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/eksempler');

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const heroImage = article.artikkelBilde || article.seoBilde;
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;

const articleJsonLd = eksempelSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: 'Eksempler', url: '/eksempler' },
  { name: article.tittel, url: `/eksempler/${slug}` },
]);

const allEksemplerRes = await getEksempler({ take: 10 });
const otherArticles = allEksemplerRes.data.filter(a => a.slug !== slug).slice(0, 3);

const bakgrunn = article.bakgrunn || 'hvit';
const isLightBlueBg = bakgrunn === 'lyseblaa';
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  <div class="article-page" data-layout-block="content">
    <section class={`article-hero ${isLightBlueBg ? 'article-hero--bg-lyseblaa' : ''}`}>
      {isLightBlueBg ? (
        <div class="article-hero-bg-grid" data-layout-block="content">
          <div class="article-hero-inner">
            <div class="article-hero-text">
              <h1 class="article-title">{article.tittel}</h1>
              {article.ingress && <p class="article-ingress">{article.ingress}</p>}
            </div>
            {heroImage?.url && (
              <div class="article-hero-image">
                <img src={getMediaUrl(heroImage)} alt={article.bildeAlt || ''} class="article-hero-img" loading="eager" decoding="async" />
              </div>
            )}
          </div>
        </div>
      ) : (
        <div class="article-hero-inner">
          <div class="article-hero-text">
            <h1 class="article-title">{article.tittel}</h1>
            {article.ingress && <p class="article-ingress">{article.ingress}</p>}
          </div>
          {heroImage?.url && (
            <div class="article-hero-image">
              <img src={getMediaUrl(heroImage)} alt={article.bildeAlt || ''} class="article-hero-img" loading="eager" decoding="async" />
            </div>
          )}
        </div>
      )}
    </section>
    <ArticleBlocksRenderer blocks={article.innhold} defaultDate={article.publishedAt} />

    {otherArticles.length > 0 && (
      <section class="more-articles">
        <h2 class="more-articles-heading">Flere eksempler</h2>
        <div class="more-articles-grid">
          {otherArticles.map(a => (
            <a href={`/eksempler/${a.slug}`} class="more-article-card">
              <div class="more-article-text">
                <h3 class="more-article-title">{a.tittel}</h3>
                <span class="more-article-date">
                  {new Date(a.publishedAt).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <p class="more-article-lead">{getPlainText(a.innhold, 80)}</p>
              </div>
              <div class="more-article-image"></div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .article-page {
    display: flex;
    flex-direction: column;
    padding-top: 0;
    gap: 48px;
  }

  .article-hero {
    padding: 100px 0;
  }

  .article-hero--bg-lyseblaa {
    background: #e5f2f7;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: calc(-1 * var(--header-height, 72px));
    padding-top: calc(140px + var(--header-height, 72px));
    padding-bottom: 80px;
    padding-left: 0;
    padding-right: 0;
  }

  .article-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .article-hero-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.5px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .article-title {
      font-size: 36px;
    }
  }

  .article-ingress {
    font-size: 21px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    letter-spacing: 0.5px;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .article-ingress {
      font-size: 24px;
    }
  }

  .article-hero-image {
    flex-shrink: 0;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .article-hero-image {
      width: 407px;
    }
  }

  .article-hero-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .article-hero-img {
      height: 331px;
    }
  }

  .more-articles {
    padding: 64px 0 120px;
  }

  .more-articles-heading {
    font-size: 32px;
    font-weight: 700;
    color: #000;
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 1024px) {
    .more-articles-heading {
      font-size: 40px;
      margin-bottom: 32px;
    }
  }

  .more-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .more-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .more-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .more-article-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 24px;
    min-height: 280px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }

  .more-article-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .more-article-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .more-article-title {
    font-size: 24px;
    font-weight: 600;
    color: #000;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-article-date {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.45;
  }

  .more-article-lead {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    margin: 0;
    line-height: 1.45;
  }

  .more-article-image {
    flex: 1;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 8px;
    min-height: 120px;
  }
</style>
