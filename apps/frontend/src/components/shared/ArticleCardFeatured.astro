---
import AkselIcon from './AkselIcon.astro';
import Bilde from './Bilde.astro';
import type { UmbracoMedia } from '../../lib/umbraco';

interface Props {
  href: string;
  title: string;
  lead?: string;
  image?: UmbracoMedia;
  imageAlt?: string;
  tags?: string[];
}

const { href, title, lead, image, imageAlt = '', tags = [] } = Astro.props;
const id = `featured-card-${crypto.randomUUID().slice(0, 8)}`;

// Pilen limes til siste ord så den ikke brekker alene (#464)
---

<article class="featured-card" data-clickdelegatefor={id}>
  <div class="featured-card-image">
    <Bilde media={image} format="kort" sizes="(max-width: 767px) 100vw, 520px" alt={imageAlt} standardbilde />
  </div>
  <div class="featured-card-body">
    <h3 class="featured-card-title"><a id={id} href={href}>{title}<span class="featured-card-arrow" aria-hidden="true"><AkselIcon name="ArrowRight" size={20} /></span></a></h3>
    {lead && <p class="featured-card-lead">{lead}</p>}
    {tags.length > 0 && (
      <ul class="featured-card-tags">
        {tags.map((t) => <li><span class="ds-tag" data-size="sm">{t}</span></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    cursor: pointer;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }

    & a {
      text-decoration: none;
      color: inherit;

      &:focus-visible {
        outline: none;
      }
    }

    &:focus-within {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
      border-radius: var(--ds-border-radius-md);
    }
  }

  .featured-card-image {
    align-self: start;
  }

  .featured-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    justify-content: center;
  }

  .featured-card-tags {
    order: -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-card-title {
    font-size: var(--ds-heading-lg-font-size);
    font-weight: 400;
    margin: 0;
    text-decoration: underline;
  }

  .featured-card-lead {
    font-size: var(--ds-body-lg-font-size);
    color: var(--ds-color-text-default);
    margin: 0;
    line-height: 1.6;
  }

.featured-card-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--ds-color-surface-tinted);
  vertical-align: middle;
  margin-left: var(--ds-size-2);
}
</style>
