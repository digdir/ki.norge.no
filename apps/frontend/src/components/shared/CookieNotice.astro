---
import { getGlobaleInnstillinger } from '../../lib/umbraco';

const gi = await getGlobaleInnstillinger().catch(() => null);
const tekstHtml = gi?.cookieTekst || '<p>Vi bruker kun nødvendige informasjonskapsler for at nettsiden skal fungere. Vi sporer ikke besøk eller setter analyse-cookies. <a href="/cookies">Les mer</a></p>';
const knappLabel = gi?.cookieKnappLabel || 'Greit';
---

<div id="cookie-notice" class="cookie-notice" hidden>
  <div class="cookie-notice__inner">
    <div class="cookie-notice__text" set:html={tekstHtml}></div>
    <button id="cookie-notice-dismiss" type="button" class="cookie-notice__btn">
      {knappLabel}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'ki-cookie-notice-acked';
    var notice = document.getElementById('cookie-notice');
    var btn = document.getElementById('cookie-notice-dismiss');
    if (!notice || !btn) return;

    try {
      if (localStorage.getItem(KEY) === '1') return;
    } catch (e) {
      // localStorage blocked — show the notice anyway, don't try to remember
    }

    notice.hidden = false;
    btn.addEventListener('click', function () {
      notice.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });
  })();
</script>

<style>
  .cookie-notice {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 990;
    background: #1a2a6d;
    color: #fff;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    max-width: 720px;
    margin: 0 auto;
  }

  .cookie-notice__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    flex-wrap: wrap;
  }

  .cookie-notice__text {
    margin: 0;
    flex: 1;
    min-width: 240px;
    font-size: 14px;
    line-height: 1.5;
  }

  .cookie-notice__text a {
    color: #fff;
    text-decoration: underline;
  }

  .cookie-notice__btn {
    background: #fff;
    color: #1a2a6d;
    border: none;
    padding: 8px 18px;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    font-size: 14px;
  }

  .cookie-notice__btn:hover {
    background: #f0f0f0;
  }

  .cookie-notice__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media print {
    .cookie-notice {
      display: none;
    }
  }
</style>
