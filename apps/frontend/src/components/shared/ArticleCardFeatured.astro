---
import AkselIcon from './AkselIcon.astro';
import { splitLastWord } from '../../lib/text';
import type { CardImage } from '../../lib/umbraco';

interface Props {
  href: string;
  title: string;
  lead?: string;
  // Streng for statiske bilder. CardImage fra getCardImage() for CMS-media,
  // som i tillegg gir srcset, sizes og sideforhold.
  image?: string | CardImage;
  imageAlt?: string;
  tags?: string[];
  virksomhet?: string;
}

const { href, title, lead, image, imageAlt = '', tags = [], virksomhet } = Astro.props;
const id = `featured-card-${crypto.randomUUID().slice(0, 8)}`;
const cardImage: CardImage | undefined = typeof image === 'string' ? { src: image } : image;

// Pilen limes til siste ord så den ikke brekker alene (#464)
const titleParts = splitLastWord(title);
---

<article class="featured-card" data-clickdelegatefor={id}>
  <div class="featured-card-image">
    {cardImage ? (
      <img
        src={cardImage.src}
        srcset={cardImage.srcset}
        sizes={cardImage.sizes}
        width={cardImage.width}
        height={cardImage.height}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="featured-card-placeholder"></div>
    )}
  </div>
  <div class="featured-card-body">
    <h3 class="featured-card-title"><a id={id} href={href}>{titleParts.head}<span class="u-nowrap">{titleParts.last}<span class="featured-card-arrow" aria-hidden="true"><AkselIcon name="ArrowRight" size={20} /></span></span></a></h3>
    {virksomhet && <p class="featured-card-virksomhet">{virksomhet}</p>}
    {lead && <p class="featured-card-lead">{lead}</p>}
    {tags.length > 0 && (
      <ul class="featured-card-tags">
        {tags.map((t) => <li><span class="ds-tag" data-size="sm">{t}</span></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    cursor: pointer;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }

    & a {
      text-decoration: none;
      color: inherit;

      &:focus-visible {
        outline: none;
      }
    }

    &:focus-within {
      outline: var(--dsc-focus-outline);
      outline-offset: var(--ds-border-width-focus);
      border-radius: var(--ds-border-radius-md);
    }
  }

  .featured-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .featured-card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--image-fallback-bg);
  }

  .featured-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    justify-content: center;
  }

  .featured-card-tags {
    order: -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-card-title {
    font-size: var(--ds-heading-lg-font-size);
    font-weight: 400;
    margin: 0;
    text-decoration: underline;
  }

  .featured-card-virksomhet {
    margin: 0;
    font-size: var(--ds-font-size-3);
    font-weight: 500;
  }

  .featured-card-lead {
    font-size: var(--ds-body-lg-font-size);
    color: var(--ds-color-text-default);
    margin: 0;
    line-height: 1.6;
  }

.featured-card-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--ds-color-surface-tinted);
  vertical-align: middle;
  margin-left: var(--ds-size-2);
}
</style>
