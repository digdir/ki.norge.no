---
import Layout from '../../components/layout/Layout.astro';
import ExampleLinkCard from '../../components/shared/ExampleLinkCard.astro';
import NewsCard from '../../components/shared/NewsCard.astro';
import { getCaser, getCaserOversikt, getMediaUrl, getPlainText, type Case } from '../../lib/umbraco';

let cases: Case[] = [];
let oversikt = null;
try {
  const [oversiktData, casesRes] = await Promise.all([
    getCaserOversikt(),
    getCaser(),
  ]);
  oversikt = oversiktData;
  cases = casesRes.data;
} catch (e) {
  console.error('Failed to fetch caser:', e);
}

const heroTittel = oversikt?.heroTittel || 'Eksempler';
const heroIngress = oversikt?.heroIngress || 'Lær av andre offentlige virksomheters erfaringer med kunstig intelligens.';
const seoTitle = oversikt?.seoTittel || heroTittel;
const seoDesc = oversikt?.seoBeskrivelse || heroIngress;

const featuredCase = cases[0];
const dualCases = cases.slice(1, 5);
const restCases = cases.slice(5);
const variants: Array<'dark' | 'light'> = ['dark', 'light'];
function checkerboard(i: number, cols: number): 'dark' | 'light' {
  const row = Math.floor(i / cols);
  const col = i % cols;
  return (row + col) % 2 === 0 ? 'dark' : 'light';
}
---

<Layout title={seoTitle} description={seoDesc}>
  <div class="caser-page" data-layout-block="content">
    <h1 class="caser-title">{heroTittel}</h1>

    {featuredCase && (
      <NewsCard
        href={`/caser/${featuredCase.slug}`}
        title={featuredCase.tittel}
        lead={featuredCase.ingress || getPlainText(featuredCase.innhold, 160)}
        image={getMediaUrl(featuredCase.artikkelBilde) || '/article_placeholder.png'}
        imageAlt={featuredCase.bildeAlt || ''}
        variant="featured"
        tag="Eksempel"
      />
    )}

    {dualCases.length > 0 && (
      <div class="caser-grid-2">
        {dualCases.map((c, i) => (
          <ExampleLinkCard
            href={`/caser/${c.slug}`}
            title={c.tittel}
            tag="Eksempel"
            variant={checkerboard(i, 2)}
          />
        ))}
      </div>
    )}

    {restCases.length > 0 && (
      <div class="caser-grid-3">
        {restCases.map((c, i) => (
          <ExampleLinkCard
            href={`/caser/${c.slug}`}
            title={c.tittel}
            tag="Eksempel"
            variant={checkerboard(i, 3)}
          />
        ))}
      </div>
    )}

    {cases.length === 0 && (
      <p class="empty-state">Ingen eksempler funnet.</p>
    )}
  </div>

  <section class="caser-share" data-layout-block="edge">
    <div data-layout-block="content">
      <p class="caser-share-title">Ønsker du å dele et eksempel?</p>
      <p class="caser-share-contact">Navn Navnesen<br>navn@digdir.no<br>Rådgiver i Digitaliseringsdirektoratet</p>
    </div>
  </section>
</Layout>

<style>
  .caser-page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
    padding-block: var(--ds-size-12);
  }

  .caser-title {
    font-size: var(--ds-heading-xl-font-size, 40px);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .caser-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .caser-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .caser-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .caser-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .caser-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    color: var(--ds-color-text-subtle);
    text-align: center;
  }

  .caser-share {
    background-color: var(--ds-color-base-active);
    color: var(--ds-color-base-contrast-default);
    padding-block: var(--ds-size-12);
  }

  .caser-share-title {
    font-size: var(--ds-heading-sm-font-size, 24px);
    font-weight: 700;
    margin: 0 0 var(--ds-size-4);
  }

  .caser-share-contact {
    font-size: var(--ds-font-size-3);
    margin: 0;
    line-height: 1.7;
  }
</style>
