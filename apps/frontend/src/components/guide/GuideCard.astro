      )}
    </span>
    <span class="guide-card-title">{title}</span>
  </div>
  <div class="guide-card-body">
    <slot />
  </div>
</div>
<style>
  .guide-card {
    border-radius: var(--ds-border-radius-lg);
    padding-block: var(--ds-size-8);
    padding-inline: var(--ds-size-6);
    margin-block: var(--ds-size-6);
    background-color: var(--ds-color-background-tinted);
    border: 1px solid var(--ds-color-border-subtle);
    color: var(--ds-color-text-default);

    .guide-card-header {
      display: flex;
      align-items: center;
      gap: var(--ds-size-2);
      margin-bottom: var(--ds-size-4);
    }
    .guide-card-icon {
      display: flex;
      margin-block-end: auto;
    }
    .guide-card-title {
      font-weight: 700;
    }
    .guide-card-body :global(p) {
      margin: 0 0 var(--ds-size-3);
    }
    .guide-card-body :global(p:last-child) {
      margin-bottom: 0;
    }
    .guide-card-body :global(ol), .guide-card-body :global(ul) {
      margin: var(--ds-size-2) 0;
      padding-inline-start: var(--ds-size-6);
    }
    .guide-card-body :global(li) {
      margin-bottom: var(--ds-size-1);
    }
  }
</style>
